function replayInnings(cfg, entries) {
  const sx = sfxOf(cfg.so);
  let L = initLive(cfg); const W = {};
  W[cfg.s1 + sx] = { ...blank(), bo: 1 }; W[cfg.s2 + sx] = { ...blank(), bo: 2 }; W[cfg.s3 + sx] = blank();
  L.display = buildDisplay(L, W);
  const out = { log: [], overs: [], parts: [], fow: {}, ex: {}, inningsRec: null };
  let part = { a: cfg.s1, b: cfg.s2, runs: 0, balls: 0, ra: 0, rb: 0, ba: 0, bb: 0 };
  const overMap = {};
  const closePart = (wkt, unbeaten) => { if (part.runs || part.balls || unbeaten) out.parts.push({ ...part, wkt: unbeaten ? null : wkt }); };
  const kindTxt = e => e.k === 'run' ? (e.bat === 0 ? 'no run' : e.bat === 4 ? 'FOUR' : e.bat === 6 ? 'SIX' : `${e.bat} run${e.bat > 1 ? 's' : ''}`)
    : e.k === 'wd' ? (e.ran ? `wide + ${e.ran}` : 'wide') : e.k === 'nb' ? `no ball${e.bat ? ' + ' + e.bat : ''}` : e.k === 'bye' ? `${e.ran} bye${e.ran > 1 ? 's' : ''}` : e.k === 'lb' ? `${e.ran} leg bye${e.ran > 1 ? 's' : ''}` : `${e.ran} penalty runs`;
  for (const e of entries) {
    const before = L, r = applyEntry(L, W, e);
    if (r.skipped) continue;
    if (e.t === 'b') {
      const dr = r.L.live_score - before.live_score, dbl = r.L.total_balls - before.total_balls;
      const bat = (e.k === 'run' || e.k === 'nb') ? (e.bat || 0) : 0, faced = (e.k !== 'wd' && e.k !== 'pen') ? 1 : 0;
      part.runs += dr; part.balls += dbl;
      if (before.striker_id === part.a) { part.ra += bat; part.ba += faced; } else { part.rb += bat; part.bb += faced; }
      const ovi = Math.floor(before.total_balls / 6), tag = r.L.last_12_balls_array[r.L.last_12_balls_array.length - 1];
      out.log.push({ key: e.key, label: `${ovi}.${before.total_balls % 6 + (dbl ? 1 : 0)}`, over: ovi, bowler: nm(before.active_bowler_id), striker: nm(before.striker_id), tag, runs: dr, text: e.w ? `OUT! ${e.w.type}` : kindTxt(e), wicket: !!e.w });
      const o = overMap[ovi] || (overMap[ovi] = { n: ovi + 1, bowler: nm(before.active_bowler_id), runs: 0, wk: 0, tags: [], score: 0, wkts: 0 });
      o.runs += dr; o.wk += e.w ? 1 : 0; o.tags.push(tag); o.score = r.L.live_score; o.wkts = r.L.wickets;
    }
    if (r.fow) out.fow[r.fow.key.split('/')[1]] = r.fow.val;
    for (const f in r.ex) out.ex[f] = (out.ex[f] || 0) + r.ex[f];
    if (r.fow || e.t === 'rt') { closePart(r.L.wickets, false); part = { a: r.L.striker_id, b: r.L.non_striker_id, runs: 0, balls: 0, ra: 0, rb: 0, ba: 0, bb: 0 }; }
    if (r.inningsRec) out.inningsRec = r.inningsRec; else if (r.L.status === 'live' || r.L.status === 'need_bowler') out.inningsRec = null;
    L = r.L; Object.assign(W, r.changes);
  }
  closePart(0, true);

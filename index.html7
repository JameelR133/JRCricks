<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#0b1f30">
<link rel="manifest" href="manifest.json">
<title>JRCricks</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
tailwind.config = {
  theme: { extend: {
    fontFamily: { display: ['"Barlow Condensed"', 'sans-serif'], sans: ['Barlow', 'system-ui', 'sans-serif'] },
    colors: {
      navy: { 950: '#071521', 900: '#0b1f30', 800: '#102a3f', 700: '#17384f' },
      ink: { 900: '#0d141b', 800: '#141d27', 700: '#1d2936', 600: '#2c3b4b' },
      brand: '#0fa968', pitch: '#34d17e', ball: '#ef4444', gold: '#fbbf24'
    },
    keyframes: { glow: { '0%,100%': { opacity: '1' }, '50%': { opacity: '.55' } } },
    animation: { glow: 'glow 1s ease-in-out infinite' }
  } }
};
</script>
<style>
body.lt{background:#F2F5F8;color:#0B1F30}
body.lt .bg-ink-900{background:#F2F5F8}
body.lt .bg-ink-800{background:#fff;border:1.5px solid #D3DBE3}
body.lt .bg-ink-700{background:#fff;border:1.5px solid #D3DBE3}
body.lt .bg-ink-600{background:#E6ECF2}
body.lt .border-ink-600{border-color:#D3DBE3}
body.lt .text-white{color:#0B1F30}
body.lt .text-gray-200,body.lt .text-gray-300,body.lt .text-gray-400{color:#44566A}
body.lt .text-gray-500{color:#5B6B7A}
body.lt .text-gold{color:#8A5A00}
body.lt .border-gold{border-color:#C98A00}
body.lt .bg-gold\/15{background:#FFF3CF}
body.lt .border-white\/80{border-color:#0B1F30}
body.lt [class*="bg-ball"],body.lt .bg-brand{color:#fff}
body.lt [class*="from-navy"]{color:#fff}
body.lt [class*="from-navy"] .text-white{color:#fff}
body.lt [class*="from-navy"] .text-gray-200,body.lt [class*="from-navy"] .text-gray-300,body.lt [class*="from-navy"] .text-gray-400{color:#C9D5E0}
body.lt [class*="from-navy"] .text-gold{color:#FBBF24}
</style>
</head>
<body class="bg-slate-100 text-slate-900 font-sans antialiased">
<div id="net" class="hidden fixed top-2 right-2 z-40 text-xs font-semibold px-2.5 py-1 rounded-full"></div>
<div id="view" class="mx-auto max-w-2xl min-h-[100dvh]"><div class="p-10 text-center text-slate-400">Loading...</div></div>
<nav id="nav" class="hidden fixed bottom-0 inset-x-0 z-30 bg-white border-t border-slate-200 pb-[env(safe-area-inset-bottom)]"><div class="mx-auto max-w-2xl grid grid-cols-4"></div></nav>
<div id="sheet" class="hidden fixed inset-0 z-50 bg-black/60 items-end justify-center">
  <div id="sheetBody" class="w-full max-w-md rounded-t-3xl max-h-[92dvh] overflow-y-auto p-4 pb-[max(1rem,env(safe-area-inset-bottom))]"></div>
</div>
<div id="toast" class="hidden fixed left-1/2 -translate-x-1/2 bottom-24 z-[60] px-4 py-2 rounded-full bg-slate-900 text-white font-semibold text-sm shadow-xl"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import { getDatabase, ref, onValue, get, update, push, query, orderByKey, limitToLast, increment, runTransaction } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-database.js";
import { getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, sendPasswordResetEmail, signOut } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

/* ====== FIREBASE CONFIG ====== */
const firebaseConfig = {
  apiKey: "AIzaSyDkLxwnT685zj2qYSAs4lCe-u-FYjVmnZA",
  authDomain: "jrcricks.firebaseapp.com",
  databaseURL: "https://jrcricks-default-rtdb.firebaseio.com",
  projectId: "jrcricks",
  appId: "1:924049422792:web:be1c1dd705b70b89ebe8fd"
};
/* ============================= */

const app = initializeApp(firebaseConfig);
const APPCHECK_KEY = ''; // paste the reCAPTCHA v3 site key here to switch App Check on
if (APPCHECK_KEY) { try { const m = await import('https://www.gstatic.com/firebasejs/10.14.1/firebase-app-check.js'); m.initializeAppCheck(app, { provider: new m.ReCaptchaV3Provider(APPCHECK_KEY), isTokenAutoRefreshEnabled: true }); } catch (e) {} }
const db = getDatabase(app), auth = getAuth(app);

/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const clone = o => JSON.parse(JSON.stringify(o));
const blank = () => ({ bat_runs: 0, bat_balls: 0, fours: 0, sixes: 0, out: false, dismissal: '', dismissed_by: '', bowl_balls: 0, bowl_runs: 0, bowl_wkts: 0, maidens: 0 });
const pad = n => String(n).padStart(5, '0');
const oversText = b => `${Math.floor(b / 6)}.${b % 6}`;
const base = f => new URL(f, location.href).href;
const STAGES = ['Group', 'Round of 32', 'Round of 16', 'Quarter Final', 'Semi Final', 'Final', '3rd Place', 'Friendly'];

const B1 = 'h-11 px-4 rounded-xl font-semibold bg-brand text-white active:scale-95 transition disabled:opacity-40';
const B2 = 'h-11 px-4 rounded-xl font-semibold bg-slate-100 text-slate-800 hover:bg-slate-200 active:scale-95 transition disabled:opacity-40';
const B3 = 'h-11 px-4 rounded-xl font-semibold bg-red-50 text-red-600 active:scale-95 transition';
const IN = 'h-12 w-full rounded-xl bg-white border border-slate-300 px-3 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand';
const CARDC = 'rounded-2xl bg-white border border-slate-200 shadow-sm p-4';
const LBL = 'block text-xs font-semibold text-slate-500 mb-1';

function toast(msg, bad) {
  const t = $('#toast'); t.textContent = msg;
  t.className = `fixed left-1/2 -translate-x-1/2 bottom-24 z-[60] px-4 py-2 rounded-full font-semibold text-sm shadow-xl ${bad ? 'bg-red-600 text-white' : 'bg-slate-900 text-white'}`;
  clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.add('hidden'), 2800);
}
const fail = e => toast(e.code || e.message || 'Something went wrong', true);
const APP_VER = '2026.10.25';
const errLog = (() => { try { return JSON.parse(localStorage.getItem('cl_err') || '[]'); } catch (e) { return []; } })();
const logErr = m => { try { errLog.push(new Date().toISOString().slice(0, 19) + ' ' + String(m).slice(0, 200)); while (errLog.length > 8) errLog.shift(); localStorage.setItem('cl_err', JSON.stringify(errLog)); } catch (e) {} };
window.addEventListener('error', e => { const m = e.message || ''; if (m && !/ResizeObserver|Script error/i.test(m)) logErr(m); });
window.addEventListener('unhandledrejection', e => logErr(e.reason?.code || e.reason?.message || e.reason));
const copy = async txt => { try { await navigator.clipboard.writeText(txt); toast('Copied'); } catch { prompt('Copy this link:', txt); } };
const shuffle = a => { a = [...a]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };

function resizeImg(file, maxW, maxH) {
  return new Promise((res, rej) => {
    const img = new Image();
    img.onload = () => {
      const sc = Math.min(1, maxW / img.width, maxH / img.height), c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(img.width * sc)); c.height = Math.max(1, Math.round(img.height * sc));
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); res(c.toDataURL('image/webp', 0.85));
    };
    img.onerror = rej; img.src = URL.createObjectURL(file);
  });
}

/* ---------- state ---------- */
let user = null, T = null, tab = 'matches', screen = 'home', M = null, info = null, CM = null;
let role = null, committee = null, license = null, allLic = {}, regName = '', regPhone = '', mode = 'login';
let adminData = { committees: {}, ads: {} };
let tournaments = {}, meta = {}, players = {}, matches = {}, logos = {};
let live = null, stats = {}, inns = {}, extrasN = {}, fow = {}, lastBall = null, lastTap = 0;
const loaded = { live: 0, stats: 0, inns: 0 };
const ui = { sheet: null, lock: false, w: {}, ex: {}, viewKey: '', card: null, tabCard: 1, filter: 'all', lb: null, toss: null, pom: null };
let tsubs = [], msubs = [], rootSubs = [], csubs = [];
const MP = () => `tournaments/${T}/matches/${M}`;
const IP = () => `tournaments/${T}/match_index/${M}`;

const teams = () => Object.entries(meta.teams || {}).map(([id, t]) => ({ id, ...t })).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const teamById = id => ({ id, ...(meta.teams?.[id] || { name: '?', abbr: '?', color: '#64748b' }) });
const grpOf = t => t.group || 'A';
const teamPlayers = tid => Object.entries(players).filter(([, p]) => p.team_id === tid).map(([id, p]) => ({ id, ...p })).sort((a, b) => (a.order ?? 0) - (b.order ?? 0) || a.name.localeCompare(b.name));
const nm = id => players[id]?.name || '-';
const sget = id => ({ ...blank(), ...(stats[id + (live && live.so ? '~s' + live.so : '')] || {}) });
const mSide = (m, s) => s === 'a' ? { id: m.team_a_id, name: m.team_a_name, abbr: m.team_a_abbr, color: m.team_a_color } : { id: m.team_b_id, name: m.team_b_name, abbr: m.team_b_abbr, color: m.team_b_color };
const tm = id => id === info.team_a_id ? mSide(info, 'a') : mSide(info, 'b');
const other = id => id === info.team_a_id ? info.team_b_id : info.team_a_id;
const wLimit = tid => Math.max(1, Math.min(xiOf(tid).length - 1, +info?.max_wickets || 99));
const maxW = () => wLimit(live.batting_team_id);

const av = (t, sz = 44) => {
  const lg = logos[t.id], st = `width:${sz}px;height:${sz}px`;
  return lg ? `<img src="${lg}" style="${st}" class="rounded-full object-cover bg-white border border-slate-200 shrink-0" alt="">`
    : `<span style="${st};background:${esc(t.color || '#64748b')};font-size:${Math.round(sz * .38)}px" class="rounded-full inline-flex items-center justify-center text-white font-display font-bold shrink-0">${esc((t.abbr || '?').slice(0, 2))}</span>`;
};

const ADMIN_PHONE = '923461278223', ADMIN_PHONE_LOCAL = '03461278223';
const waLink = text => `https://wa.me/${ADMIN_PHONE}?text=${encodeURIComponent(text)}`;
const withTimeout = (p, ms) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))]);
const cacheSet = (k, v) => { try { localStorage.setItem('cl_c_' + k, JSON.stringify(v ?? null)); } catch (e) {} };
const cacheGet = k => { try { const s = localStorage.getItem('cl_c_' + k); return s === null ? undefined : JSON.parse(s); } catch { return undefined; } };
/* listen to a path; if there is no answer in 1.8 s (offline), fall back to the copy saved on this phone */
function watchV(path, setter) {
  let got = false;
  const t = setTimeout(() => { if (!got) { const c = cacheGet(path); if (c !== undefined) setter(c); } }, 1800);
  const u = onValue(ref(db, path), s => { got = true; const v = s.val(); cacheSet(path, v); setter(v); }, fail);
  return () => { clearTimeout(t); u(); };
}
const xiOf = tid => {
  const side = info && tid === info.team_a_id ? 'a' : 'b', x = info ? info['xi_' + side] : null, all = teamPlayers(tid);
  if (!x || !x.length) return all;
  const set = new Set(x); return all.filter(p => set.has(p.id));
};
const dn = id => {
  const base = nm(id); if (!info || !players[id]) return base;
  const sd = players[id].team_id === info.team_a_id ? 'a' : 'b';
  return base + (info['cap_' + sd] === id ? ' (c)' : '') + (info['wk_' + sd] === id ? ' \u2020' : '');
};
const ptRow = (t, g) => ({ team_name: t.name, team_abbr: t.abbr, group: g, matches_played: 0, wins: 0, losses: 0, ties: 0, points: 0, total_runs_scored: 0, total_balls_faced: 0, total_overs_faced: 0, total_runs_conceded: 0, total_balls_bowled: 0, total_overs_bowled: 0, net_run_rate: 0 });
const lbRow = (name, team) => ({ player_name: name, team_name: team, total_runs: 0, total_balls_faced: 0, total_fours: 0, total_sixes: 0, total_boundaries: 0, total_wickets: 0, total_runs_conceded: 0, total_balls_bowled: 0, total_maidens: 0 });
const fmtWhen = ms => ms ? new Date(ms).toLocaleString(undefined, { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : '';
const toLocalInput = ms => { if (!ms) return ''; const d = new Date(ms), p = n => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`; };
const champion = () => { const f = Object.values(matches).find(m => m.stage === 'Final' && m.status === 'completed' && m.winner_id && m.winner_id !== 'tie' && m.winner_id !== 'none'); return f ? f.winner_id : null; };
const mosPts = p => (p.total_runs || 0) + 20 * (p.total_wickets || 0) + 2 * (p.total_sixes || 0) + (p.total_fours || 0) + 8 * (p.total_maidens || 0);
function rankRows(rows) {
  const mode = meta.tiebreak || 'nrr', pts = r => (r.points || 0) + (r.adj || 0);
  const h2h = (x, y) => {
    const m = Object.values(matches).find(m => (m.stage || 'Group') === 'Group' && m.status === 'completed' && m.winner_id && ((m.team_a_id === x.id && m.team_b_id === y.id) || (m.team_a_id === y.id && m.team_b_id === x.id)));
    return !m ? 0 : m.winner_id === x.id ? -1 : m.winner_id === y.id ? 1 : 0;
  };
  return rows.sort((a, b) => pts(b) - pts(a) || (mode === 'h2h' ? h2h(a, b) : 0) || (mode === 'wins' ? ((b.wins || 0) - (a.wins || 0) || b.nrr - a.nrr) : (b.nrr - a.nrr || (b.wins || 0) - (a.wins || 0))));
}
function propagate(up, field, value) {
  Object.keys(matches).forEach(mid => putInfo(up, mid, field, value));
}

const isLight = () => { try { return localStorage.getItem('cl_lt') !== '0'; } catch (e) { return true; } };
function setTheme(dark) {
  document.body.className = dark ? 'bg-ink-900 text-white font-sans antialiased' + (isLight() ? ' lt' : '') : 'bg-slate-100 text-slate-900 font-sans antialiased';
}

/* ---------- auth ---------- */
function authShell(inner) {
  $('#view').className = 'mx-auto max-w-2xl min-h-[100dvh]';
  $('#view').innerHTML = `<div class="min-h-[100dvh] flex flex-col"><div class="bg-gradient-to-br from-navy-900 to-navy-700 text-white px-6 pt-16 pb-10 rounded-b-[2.5rem]"><div class="flex items-center gap-3"><svg viewBox="0 0 40 40" class="w-14 h-14"><circle cx="20" cy="20" r="18" fill="#ef4444"/><path d="M9 8c5 5 5 19 0 24M31 8c-5 5-5 19 0 24" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round"/></svg><div class="font-display text-6xl font-extrabold leading-none"><span class="text-gold">JR</span>Cricks</div></div><p class="text-white/70 mt-3">Live scoring, tables and stream overlays for your tournament.</p></div><div class="px-6 pt-6 pb-10 max-w-sm w-full mx-auto">${inner}</div></div>`;
}
function loginView(msg = '') {
  const reg = mode === 'register', tb = on => `flex-1 h-10 rounded-full text-sm font-semibold ${on ? 'bg-navy-900 text-white' : 'bg-white border border-slate-200 text-slate-600'}`;
  authShell(`<div class="flex gap-2 mb-5"><button data-a="mode" data-v="login" class="${tb(!reg)}">Sign in</button><button data-a="mode" data-v="register" class="${tb(reg)}">Sign up</button></div>
    ${reg ? `<label class="${LBL}">Committee owner name</label><input id="rn" class="${IN} mb-3"><label class="${LBL}">Your WhatsApp / phone number</label><input id="rp" type="tel" class="${IN} mb-3" placeholder="03xx xxxxxxx">` : ''}
    <label class="${LBL}">Email</label><input id="em" type="email" class="${IN} mb-3" autocomplete="username">
    <label class="${LBL}">Password</label><input id="pw" type="password" class="${IN} mb-4" autocomplete="${reg ? 'new-password' : 'current-password'}">
    <button data-a="${reg ? 'do-register' : 'do-login'}" class="${B1} w-full">${reg ? 'Create account' : 'Sign in'}</button>
    ${reg ? '<p class="text-xs text-slate-500 mt-3">After you sign up, the admin approves your account. Then you can add your tournament, teams and players.</p>' : '<button data-a="forgot" class="mt-3 text-sm text-brand font-semibold">Forgot password?</button>'}
    <p class="text-red-600 mt-3 text-sm">${esc(msg)}</p>
    <div class="mt-6 pt-4 border-t border-slate-200 text-sm text-slate-600">Need help or want to join? <a class="text-brand font-semibold" href="${waLink('Assalam o Alaikum, I need help with JRCricks.')}" target="_blank" rel="noopener">WhatsApp the admin</a> or call <a class="text-brand font-semibold" href="tel:${ADMIN_PHONE_LOCAL}">${ADMIN_PHONE_LOCAL}</a></div>`);
}
function profileView() {
  authShell(`<div class="font-display text-3xl font-bold mb-2">Almost there</div><p class="text-slate-600 mb-3">Enter your committee or tournament name to finish registering.</p>
    <input id="rn" class="${IN} mb-3"><button data-a="finish-profile" class="${B1} w-full">Continue</button><button data-a="signout" class="${B2} w-full mt-2">Sign out</button>`);
}
function pendingView() {
  const msg = `Assalam o Alaikum, I registered on JRCricks.\nCommittee: ${committee?.name || ''}\nEmail: ${user?.email || ''}\nPlease approve my account.`;
  authShell(`<div class="font-display text-3xl font-bold mb-2">Waiting for approval</div><p class="text-slate-600 mb-1"><b>${esc(committee?.name || '')}</b>, your account is registered.</p><p class="text-slate-600 mb-4">The admin must approve it before you can start. Message the admin, then tap Check again.</p>
    <a href="${waLink(msg)}" target="_blank" rel="noopener" class="${B1} w-full flex items-center justify-center mb-2">WhatsApp the admin</a>
    <a href="tel:${ADMIN_PHONE_LOCAL}" class="${B2} w-full flex items-center justify-center mb-2">Call ${ADMIN_PHONE_LOCAL}</a>
    <button data-a="refresh-auth" class="${B1} w-full">Check again</button><button data-a="signout" class="${B2} w-full mt-2">Sign out</button>`);
}
function authMsgView(t, m) {
  authShell(`<div class="font-display text-3xl font-bold mb-2">${esc(t)}</div><p class="text-slate-600 mb-4">${esc(m)}</p><button data-a="refresh-auth" class="${B1} w-full">Try again</button><button data-a="signout" class="${B2} w-full mt-2">Sign out</button>`);
}
async function afterAuth() {
  if (!user) return;
  let ck = null; try { ck = JSON.parse(localStorage.getItem('cl_auth') || 'null'); } catch (e) {}
  let isAdmin = false, c = null, offline = false;
  try { isAdmin = (await withTimeout(get(ref(db, `admins/${user.uid}`)), 7000)).val() === true; } catch (e) { offline = true; }
  if (offline) {
    if (ck && ck.uid === user.uid) { role = ck.role; committee = ck.committee || null; return startApp(); }
    return authMsgView('No internet', 'Connect to the internet once to sign in. After that the app can open offline.');
  }
  const remember = () => { try { localStorage.setItem('cl_auth', JSON.stringify({ uid: user.uid, role, committee })); } catch (e) {} };
  if (isAdmin) { role = 'admin'; remember(); return startApp(); }
  try { c = (await get(ref(db, `committees/${user.uid}`))).val(); } catch (e) { return authMsgView('Could not check your account', e.code || e.message); }
  if (!c) {
    if (!regName) return profileView();
    const rec = { name: regName, email: user.email || '', approved: false, created: Date.now() };
    if (regPhone) rec.phone = regPhone;
    try { await update(ref(db, `committees/${user.uid}`), rec); c = rec; regName = ''; regPhone = ''; } catch (e) { return authMsgView('Could not save your registration', e.code || e.message); }
  }
  committee = c;
  if (!c.approved) return pendingView();
  role = 'committee'; remember(); startApp();
}
onAuthStateChanged(auth, u => {
  user = (u && !u.isAnonymous) ? u : null;
  if (!user) { teardown(); role = null; committee = null; license = null; $('#nav').classList.add('hidden'); $('#net').classList.add('hidden'); setTheme(false); return loginView(); }
  afterAuth();
});

/* ---------- overlay access, license, ads ---------- */
const randToken = () => Array.from(crypto.getRandomValues(new Uint8Array(18)), b => 'abcdefghjkmnpqrstuvwxyz23456789'[b % 31]).join('');
const ovLink = tk => `${base('overlay.html')}?k=${tk}`;
const canMakeT = () => role === 'admin' || !Object.keys(tournaments).length || license?.extra === true;
const licOk = () => role === 'admin' || !!(license && license.on && license.until > Date.now());
const fmtDate = ms => new Date(ms).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
function putLive(up, L) { up[`${MP()}/live`] = L; const tk = info?.token; if (tk) up[`overlay/${tk}/live`] = L; }
function putInfo(up, mid, f, v) { up[`tournaments/${T}/match_index/${mid}/${f}`] = v; const tk = matches[mid]?.token; if (tk) up[`overlay/${tk}/info/${f}`] = v; }
async function ensureToken(mid) {
  const m = matches[mid]; if (!m) throw new Error('Match not found');
  if (m.token) return m.token;
  const token = randToken(), node = { owner: user.uid, t: T, m: mid, info: { ...m }, logos: {} };
  delete node.info.token;
  if (logos[m.team_a_id]) node.logos.a = logos[m.team_a_id];
  if (logos[m.team_b_id]) node.logos.b = logos[m.team_b_id];
  if (logos.sponsor) node.logos.sponsor = logos.sponsor;
  if (logos.tournament) node.logos.tournament = logos.tournament;
  const lv = (await get(ref(db, `tournaments/${T}/matches/${mid}/live`))).val(); if (lv) node.live = lv;
  await update(ref(db), { [`overlay/${token}`]: node, [`tournaments/${T}/match_index/${mid}/token`]: token });
  return token;
}
async function rotateToken(mid) {
  const m = matches[mid]; if (!m?.token) return toast('No overlay link yet', true);
  if (!confirm('Make a new overlay link? The old link stops working at once, so update it in Prism.')) return;
  try {
    const old = m.token, nw = randToken(), snap = (await get(ref(db, `overlay/${old}`))).val() || {};
    await update(ref(db), { [`overlay/${nw}`]: snap, [`overlay/${old}`]: null, [`tournaments/${T}/match_index/${mid}/token`]: nw });
    closeSheet(); toast('New overlay link ready. Copy it again.');
  } catch (e) { fail(e); }
}
function contactCard() {
  const msg = `Assalam o Alaikum, I am ${committee?.name || 'a committee'} (${user?.email || ''}). `;
  return `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Contact the admin</div>
    <div class="grid grid-cols-2 gap-2"><a href="${waLink(msg + 'I need help.')}" target="_blank" rel="noopener" class="${B1} flex items-center justify-center">WhatsApp</a><a href="tel:${ADMIN_PHONE_LOCAL}" class="${B2} flex items-center justify-center">Call ${ADMIN_PHONE_LOCAL}</a></div></div>`;
}
function licenseCard() {
  let body;
  if (role === 'admin') body = '<span class="text-emerald-600 font-semibold">Admin: overlay always active</span>';
  else if (licOk()) body = `<span class="text-emerald-600 font-semibold">Active until ${fmtDate(license.until)}</span> <span class="text-slate-500">(${Math.ceil((license.until - Date.now()) / 86400000)} days left)</span>`;
  else body = '<span class="text-red-600 font-semibold">Not active.</span> <span class="text-slate-500">Ask the admin to activate your stream overlay.</span>';
  const req = role === 'admin' ? '' : `<a href="${waLink(`Assalam o Alaikum, I am ${committee?.name || ''} (${user?.email || ''}). Please ${licOk() ? 'renew' : 'activate'} my overlay license.`)}" target="_blank" rel="noopener" class="${B1} w-full flex items-center justify-center mt-3">${licOk() ? 'Request renewal' : 'Request activation'} on WhatsApp</a>`;
  return `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-1">Overlay license</div><div class="text-sm">${body}</div><div class="text-xs text-slate-500 mt-2">${esc(committee?.name || 'Admin')} &bull; ${esc(user?.email || '')}</div>${req}</div>` + (role === 'admin' ? '' : contactCard());
}
function adminTab() {
  const cs = Object.entries(adminData.committees).sort((a, b) => (b[1].created || 0) - (a[1].created || 0));
  const now = Date.now(), soon = now + 7 * 86400000;
  const st = uid => { const l = allLic[uid]; if (l?.on && l.until > now) return `<span class="text-emerald-600 font-semibold">Overlay active until ${fmtDate(l.until)}</span> <span class="text-slate-500">(${Math.ceil((l.until - now) / 86400000)} days)</span>`; if (l?.until) return `<span class="text-red-600 font-semibold">Overlay ${l.on ? 'expired' : 'switched off'}</span> <span class="text-slate-500">(${fmtDate(l.until)})</span>`; return '<span class="text-slate-500">Overlay not activated</span>'; };
  const attention = cs.filter(([uid, c]) => c.approved && allLic[uid]?.until && (allLic[uid].until < soon)).sort((a, b) => allLic[a[0]].until - allLic[b[0]].until);
  const card = ([uid, c]) => {
    const l = allLic[uid] || {}, wa = c.phone ? `https://wa.me/${String(c.phone).replace(/\D/g, '').replace(/^0/, '92')}?text=${encodeURIComponent(`Assalam o Alaikum ${c.name}, your JRCricks overlay license ${l.until && l.until < now ? 'has expired' : 'is about to expire'}. Please renew.`)}` : '';
    return `<div class="${CARDC} mb-3">
    <div class="flex items-start justify-between gap-2"><div class="min-w-0"><div class="font-semibold truncate">${esc(c.name)}</div><div class="text-xs text-slate-500 truncate">${esc(c.email)}${c.phone ? ' &bull; ' + esc(c.phone) : ''}</div></div>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold ${c.approved ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${c.approved ? 'APPROVED' : 'PENDING'}</span></div>
    <div class="text-sm mt-2">${st(uid)}</div>
    <div class="text-xs text-slate-500 mt-1">Paid so far: <b>${l.paid || 0}</b>${l.last_paid ? ' &bull; last ' + fmtDate(l.last_paid) : ''}${l.note ? ' &bull; ' + esc(l.note) : ''}</div>
    <div class="grid grid-cols-3 gap-2 mt-3"><button data-a="lic-add" data-id="${uid}" data-days="7" class="${B2} !h-10 text-sm">+7 days</button><button data-a="lic-add" data-id="${uid}" data-days="30" class="${B2} !h-10 text-sm">+30 days</button><button data-a="lic-add" data-id="${uid}" data-days="365" class="${B2} !h-10 text-sm">+1 year</button>
      <button data-a="lic-off" data-id="${uid}" class="${B2} !h-10 text-sm">Switch off</button>
      <button data-a="pay" data-id="${uid}" class="${B2} !h-10 text-sm">Record payment</button>
      <button data-a="${c.approved ? 'disable' : 'approve'}" data-id="${uid}" class="${c.approved ? B2 : B1} !h-10 text-sm">${c.approved ? 'Block' : 'Approve'}</button>
      ${wa ? `<a href="${wa}" target="_blank" rel="noopener" class="${B2} !h-10 text-sm flex items-center justify-center col-span-2">WhatsApp</a>` : '<span class="col-span-2"></span>'}
      <button data-a="del-committee" data-id="${uid}" class="${B3} !h-10 text-sm">Remove</button>
      <button data-a="extra-toggle" data-id="${uid}" class="${B2} !h-10 text-sm col-span-3">${l.extra ? 'Extra tournament is ON - tap to switch off' : 'Allow 1 more tournament'}</button></div></div>`;
  };
  const ads = Object.entries(adminData.ads).sort((a, b) => (b[1].created || 0) - (a[1].created || 0));
  const approved = cs.filter(([, c]) => c.approved).length, active = cs.filter(([uid]) => allLic[uid]?.on && allLic[uid].until > now).length;
  return `<div class="grid grid-cols-3 gap-2 mb-4"><div class="${CARDC} !p-3 text-center"><div class="font-display text-3xl font-bold">${cs.length}</div><div class="text-xs text-slate-500">Committees</div></div><div class="${CARDC} !p-3 text-center"><div class="font-display text-3xl font-bold">${approved}</div><div class="text-xs text-slate-500">Approved</div></div><div class="${CARDC} !p-3 text-center"><div class="font-display text-3xl font-bold">${active}</div><div class="text-xs text-slate-500">Overlay active</div></div></div>
    ${attention.length ? `<div class="font-display text-2xl font-bold mb-2 text-red-600">Needs attention</div>${attention.map(card).join('')}` : ''}
    <div class="font-display text-2xl font-bold mb-2">All committees</div>${cs.map(card).join('') || `<div class="${CARDC} text-slate-500 mb-3">No committees have registered yet.</div>`}
    <div class="font-display text-2xl font-bold mb-2 mt-5">Your ads on every overlay</div>
    <div class="${CARDC} mb-3"><p class="text-xs text-slate-500 mb-3">These rotate in the sponsor slot of every stream overlay, together with the committee's own sponsor. Wide pictures (about 600 x 150) work best. Up to 6 ads.</p>
      <div class="space-y-2 mb-3">${ads.map(([id, a]) => `<div class="flex items-center gap-3 p-2 rounded-xl bg-slate-50"><img src="${a.img}" class="h-12 w-28 object-contain bg-white rounded border border-slate-200" alt=""><span class="flex-1 text-sm ${a.on === false ? 'text-slate-400' : 'text-emerald-600 font-semibold'}">${a.on === false ? 'Paused' : 'Running'}</span><button data-a="ad-toggle" data-id="${id}" class="${B2} !h-9 text-sm">${a.on === false ? 'Resume' : 'Pause'}</button><button data-a="ad-del" data-id="${id}" class="${B3} !h-9 text-sm">Delete</button></div>`).join('') || '<p class="text-sm text-slate-400">No ads yet.</p>'}</div>
      <input id="adfile" type="file" accept="image/*" class="text-sm w-full mb-2"><button data-a="ad-add" class="${B1} w-full">Add ad</button></div>
    <div class="${CARDC}"><div class="font-display text-2xl font-bold mb-1">Firebase usage</div><p class="text-xs text-slate-500 mb-2">Check connections, downloads and storage in the Firebase console. The free plan allows 100 live connections at once. Each open scorer, overlay or studio preview uses one.</p>
      <a href="https://console.firebase.google.com/project/jrcricks/database/jrcricks-default-rtdb/usage" target="_blank" rel="noopener" class="${B2} w-full flex items-center justify-center">Open usage page</a></div>`;
}
async function addAd() {
  const f = $('#adfile').files[0]; if (!f) return toast('Choose a picture first', true);
  if (Object.keys(adminData.ads).length >= 6) return toast('Maximum 6 ads. Delete one first.', true);
  try { const img = await resizeImg(f, 600, 150), id = push(ref(db, 'ads')).key; await update(ref(db), { [`ads/${id}`]: { img, on: true, created: Date.now() } }); toast('Ad added'); } catch (e) { fail(e); }
}

/* ---------- data ---------- */
function teardown() { [tsubs, msubs, rootSubs, csubs].forEach(a => a.forEach(f => f())); tsubs = []; msubs = []; rootSubs = []; csubs = []; }
function startApp() {
  rootSubs.forEach(f => f()); rootSubs = [];
  rootSubs.push(onValue(ref(db, '.info/connected'), s => {
    const n = $('#net'), on = s.val() === true;
    netOn = on; updatePending(); if (on) flushP = flushOutbox();
    n.className = `fixed top-2 right-2 z-40 text-xs font-semibold px-2.5 py-1 rounded-full ${on ? 'bg-emerald-100 text-emerald-700' : 'bg-red-600 text-white animate-glow'}`;
  }));
  rootSubs.push(watchV(`user_tournaments/${user.uid}`, v => {
    tournaments = v || {};
    const last = localStorage.getItem('last_t'), prev = T;
    if (!T || !tournaments[T]) T = tournaments[last] ? last : Object.keys(tournaments)[0] || null;
    if (T !== prev || !tsubs.length) watchTournament();
    render(true);
  }));
  if (role === 'admin') {
    rootSubs.push(onValue(ref(db, 'committees'), s => { adminData.committees = s.val() || {}; render(); }, fail));
    rootSubs.push(onValue(ref(db, 'licenses'), s => { allLic = s.val() || {}; license = allLic[user.uid] || null; render(); }, fail));
    rootSubs.push(onValue(ref(db, 'ads'), s => { adminData.ads = s.val() || {}; render(); }, fail));
  } else rootSubs.push(watchV(`licenses/${user.uid}`, v => { license = v; render(); }));
  try { const wl = () => navigator.wakeLock?.request('screen').catch(() => {}); wl(); document.addEventListener('visibilitychange', () => { if (!document.hidden) wl(); }); } catch (e) {}
}
function watchTournament() {
  tsubs.forEach(f => f()); tsubs = []; meta = {}; players = {}; matches = {}; logos = {}; ui.lb = null;
  if (!T) return;
  localStorage.setItem('last_t', T);
  tsubs.push(watchV(`tournaments/${T}/meta`, v => { meta = v || {}; render(); }));
  tsubs.push(watchV(`tournaments/${T}/players`, v => { players = v || {}; render(); }));
  tsubs.push(watchV(`tournaments/${T}/logos`, v => { logos = v || {}; render(); }));
  tsubs.push(watchV(`tournaments/${T}/match_index`, v => { matches = v || {}; if (M) info = matches[M] || null; render(); }));
}

/* ---------- render dispatcher ---------- */
const ICON = {
  matches: '<circle cx="12" cy="12" r="9"/><path d="M5 8c4 2 10 2 14 0M5 16c4-2 10-2 14 0"/>',
  teams: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  table: '<path d="M3 5h18M3 12h18M3 19h18"/>',
  admin: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/>'
};
function render(force) {
  if (!user) return;
  if (screen === 'score') { $('#nav').classList.add('hidden'); setTheme(true); return renderScore(); }
  if (screen === 'card') { $('#nav').classList.add('hidden'); setTheme(false); return renderCard(); }
  if (screen === 'studio') { $('#nav').classList.add('hidden'); setTheme(false); return renderStudio(); }
  const v = $('#view'), ae = document.activeElement;
  if (!force && ae && /INPUT|TEXTAREA|SELECT/.test(ae.tagName) && v.contains(ae)) return;
  setTheme(false);
  v.className = 'mx-auto max-w-2xl min-h-[100dvh] pb-28';
  $('#nav').classList.remove('hidden');
  const tabsList = [['matches', 'Matches'], ['teams', 'Teams'], ['table', 'Table'], ['settings', 'Settings']];
  if (role === 'admin') tabsList.push(['admin', 'Admin']);
  const pend = Object.values(adminData.committees).filter(c => !c.approved).length;
  $('#nav').firstElementChild.className = `mx-auto max-w-2xl grid ${role === 'admin' ? 'grid-cols-5' : 'grid-cols-4'}`;
  $('#nav').firstElementChild.innerHTML = tabsList
    .map(([k, l]) => `<button data-a="tab" data-v="${k}" class="h-16 flex flex-col items-center justify-center gap-0.5 text-xs font-semibold ${tab === k ? 'text-brand' : 'text-slate-400'}"><span class="relative"><svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICON[k]}</svg>${k === 'admin' && pend ? `<span class="absolute -top-1 -right-2 min-w-[1rem] h-4 px-1 rounded-full bg-red-600 text-white text-[10px] font-bold flex items-center justify-center">${pend}</span>` : ''}</span>${l}</button>`).join('');
  const head = (title, sub, act = '') => `<div class="bg-gradient-to-br from-navy-900 to-navy-700 text-white px-4 pt-6 pb-6 rounded-b-3xl mb-4"><div class="flex items-start gap-3"><div class="flex-1 min-w-0"><div class="text-xs uppercase tracking-widest text-white/60">${esc(meta.name || 'JRCricks')}</div><div class="font-display text-4xl font-extrabold leading-tight">${title}</div><div class="text-sm text-white/70">${sub}</div></div>${act}</div></div>`;
  let html;
  if (tab === 'admin' && role === 'admin') html = head('Admin', 'Committees, overlay licenses and ads') + `<div class="px-4">${adminTab()}</div>`;
  else if (tab === 'settings') html = head('Settings', 'Tournament, rules and sponsor') + `<div class="px-4">${settingsTab()}</div>`;
  else if (!T) html = head('Welcome', 'Create a tournament to begin') + `<div class="px-4"><div class="${CARDC}"><p class="text-slate-600 mb-3">Start in <b>Settings</b>: create your tournament. Then add teams in the <b>Teams</b> tab.</p><button data-a="tab" data-v="settings" class="${B1}">Go to Settings</button></div></div>`;
  else if (tab === 'matches') html = head('Matches', `${Object.keys(matches).length} matches`, `<button data-a="new-match" class="h-11 px-4 rounded-xl bg-white text-navy-900 font-semibold shrink-0">+ New</button>`) + `<div class="px-4">${matchesTab()}</div>`;
  else if (tab === 'teams') html = head('Teams', `${teams().length} teams, ${Object.keys(players).length} players`, `<button data-a="team" data-id="" class="h-11 px-4 rounded-xl bg-white text-navy-900 font-semibold shrink-0">+ Team</button>`) + `<div class="px-4">${teamsTab()}</div>`;
  else html = head('Table', 'Standings and tournament leaders') + `<div class="px-4">${tableTab()}</div>`;
  v.innerHTML = html;
}

/* ---------- MATCHES tab ---------- */
function matchCards() {
  const f = ui.filter, q = (ui.q || '').trim().toLowerCase();
  let list = Object.entries(matches).filter(([, m]) => f === 'all' || (m.status || 'scheduled') === f);
  if (q) list = list.filter(([, m]) => [m.team_a_name, m.team_b_name, m.team_a_abbr, m.team_b_abbr, m.stage, m.group ? 'group ' + m.group : '', m.ground, m.result].join(' ').toLowerCase().includes(q));
  list.sort((a, b) => f === 'scheduled' ? ((a[1].date || a[1].created || 0) - (b[1].date || b[1].created || 0)) : ((b[1].created || 0) - (a[1].created || 0)));
  const lim = ui.mlimit || 30, shown = list.slice(0, lim);
  const card = ([id, m]) => {
    const A = mSide(m, 'a'), Bt = mSide(m, 'b'), st = m.status || 'scheduled';
    const badge = st === 'live' ? 'bg-red-600 text-white' : st === 'completed' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600';
    const on = m.active !== false, ctx = [m.stage && m.stage !== 'Group' ? m.stage : (m.group ? 'Group ' + m.group : 'Group'), `${m.overs} overs`].join(', ');
    const when = [fmtWhen(m.date), m.ground].filter(Boolean).join(' \u2022 ');
    return `<div class="${CARDC} mb-3">
      <div class="flex items-center justify-between mb-1"><span class="text-xs font-semibold text-slate-500">${esc(ctx)}</span><span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase ${badge}">${st === 'scheduled' ? 'upcoming' : st}</span></div>
      ${when ? `<div class="text-xs text-brand font-semibold mb-2">${esc(when)}</div>` : '<div class="mb-2"></div>'}
      <div class="flex items-center justify-between gap-2">
        <div class="flex-1 flex items-center gap-2 min-w-0">${av(A, 48)}<div class="min-w-0"><div class="font-display text-2xl font-bold leading-none">${esc(A.abbr)}</div><div class="text-sm text-slate-500 truncate">${esc(m.score_a || '')}</div></div></div>
        <div class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 text-xs font-bold flex items-center justify-center shrink-0">VS</div>
        <div class="flex-1 flex items-center gap-2 justify-end min-w-0 text-right"><div class="min-w-0"><div class="font-display text-2xl font-bold leading-none">${esc(Bt.abbr)}</div><div class="text-sm text-slate-500 truncate">${esc(m.score_b || '')}</div></div>${av(Bt, 48)}</div>
      </div>
      ${m.result ? `<div class="mt-3 text-center text-sm font-semibold text-brand">${esc(m.result)}</div>` : ''}
      <div class="grid grid-cols-2 gap-2 mt-3">
        <button data-a="score" data-id="${id}" class="${B1} col-span-2" ${m.result_type ? 'disabled' : ''}>${st === 'completed' ? 'Open match' : st === 'live' ? 'Continue scoring' : 'Start match'}</button>
        <button data-a="scorecard" data-id="${id}" class="${B2} !h-10 text-sm">Scorecard</button>
        <button data-a="studio" data-id="${id}" class="${B2} !h-10 text-sm">Overlay Studio</button>
        <button data-a="copy-ov" data-id="${id}" class="${B2} !h-10 text-sm">Copy overlay link</button>
        <button data-a="more" data-id="${id}" class="${B2} !h-10 text-sm">${on ? 'More' : 'More (link off)'}</button></div></div>`;
  };
  if (!list.length) return `<div class="${CARDC} text-center text-slate-500">${q ? 'No match found for this search.' : 'No matches here yet. Tap <b>+ New</b>, or use <b>Generate fixtures</b>, <b>Make matches by hand</b> or <b>Knockout</b> in the Teams tab.'}</div>`;
  return shown.map(card).join('') + (list.length > lim ? `<button data-a="m-more" class="${B2} w-full mb-3">Show more (${list.length - lim} more)</button>` : '');
}
function matchesTab() {
  const f = ui.filter;
  const chips = [['all', 'All'], ['live', 'Live'], ['scheduled', 'Upcoming'], ['completed', 'Results']]
    .map(([k, l]) => `<button data-a="filter" data-v="${k}" class="h-9 px-4 rounded-full text-sm font-semibold shrink-0 ${f === k ? 'bg-navy-900 text-white' : 'bg-white border border-slate-200 text-slate-600'}">${l}</button>`).join('');
  const warn = (role === 'committee' && !licOk()) ? `<div class="mb-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm p-3">Your stream overlay is not active yet. You can still score and make pictures. <a class="font-semibold underline" href="${waLink(`Assalam o Alaikum, I am ${committee?.name || ''} (${user?.email || ''}). Please activate my overlay license.`)}" target="_blank" rel="noopener">Ask the admin on WhatsApp</a>.</div>` : '';
  return `${warn}<input id="mq" value="${esc(ui.q || '')}" placeholder="Search team, stage, ground..." class="${IN} mb-3">
    <div class="flex gap-2 mb-3 overflow-x-auto">${chips}</div>
    <div class="grid grid-cols-2 gap-2 mb-4"><button data-a="sched-open" class="${B2} !h-10 text-sm">Set dates and times</button><button data-a="card" data-k="fixtures" data-id="" class="${B2} !h-10 text-sm">Fixtures picture</button></div>
    <div id="mlist">${matchCards()}</div>`;
}

function matchInfo(a, b, o) {
  const ta = meta.teams[a], tb = meta.teams[b], r = meta.rules || {};
  return {
    team_a_id: a, team_a_name: ta.name, team_a_abbr: ta.abbr, team_a_color: ta.color,
    team_b_id: b, team_b_name: tb.name, team_b_abbr: tb.abbr, team_b_color: tb.color,
    overs: o.overs, max_bowler_overs: o.mx, max_wickets: o.mw, stage: o.stage, group: o.group || '', tname: meta.name || '',
    date: o.date || null, ground: o.ground || '', umpires: o.umpires || '',
    wd_runs: o.wd ?? r.wide_runs ?? 1, nb_runs: o.nb ?? r.nb_runs ?? 1, fh: (o.fh ?? r.free_hit ?? 1) ? 1 : 0, pp: o.pp ?? r.powerplay ?? 0,
    theme: meta.theme || 'dark', accent: meta.accent || '',
    status: 'scheduled', active: true, created: o.created || Date.now(), result: ''
  };
}
function matchFields(m, isNew) {
  const ts = teams(), r = meta.rules || {}, d = +meta.default_overs || 10;
  const started = !isNew && (m.status || 'scheduled') !== 'scheduled', dis = started ? 'disabled' : '';
  const opt = sel => ts.map(t => `<option value="${t.id}" ${t.id === sel ? 'selected' : ''}>${esc(t.name)}</option>`).join('');
  const stages = STAGES.includes(m.stage) || !m.stage ? STAGES : [...STAGES, m.stage];
  return `<div class="grid grid-cols-2 gap-3 mb-3">
    <div><label class="${LBL}">Team A</label><select id="ma" class="${IN}" ${dis}>${opt(isNew ? ts[0]?.id : m.team_a_id)}</select></div>
    <div><label class="${LBL}">Team B</label><select id="mb" class="${IN}" ${dis}>${opt(isNew ? ts[1]?.id : m.team_b_id)}</select></div>
    <div class="col-span-2"><label class="${LBL}">Stage</label><select id="ms" class="${IN}">${stages.map(s => `<option ${s === (m.stage || 'Group') ? 'selected' : ''}>${s}</option>`).join('')}</select></div>
    <div><label class="${LBL}">Overs per innings</label><input id="mo" type="number" min="1" max="50" value="${isNew ? d : m.overs}" class="${IN}" ${dis}></div>
    <div><label class="${LBL}">Max overs per bowler (0 = none)</label><input id="mx" type="number" min="0" value="${isNew ? Math.max(1, Math.ceil(d / 5)) : (m.max_bowler_overs ?? 0)}" class="${IN}"></div>
    <div><label class="${LBL}">Wickets for all out</label><input id="mw" type="number" min="1" max="10" value="${isNew ? 10 : (m.max_wickets ?? 10)}" class="${IN}"></div>
    <div><label class="${LBL}">Powerplay overs (0 = none)</label><input id="mpp" type="number" min="0" max="20" value="${isNew ? (r.powerplay ?? 0) : (m.pp ?? 0)}" class="${IN}"></div>
    <div class="col-span-2"><label class="${LBL}">Date and time</label><input id="md" type="datetime-local" value="${isNew ? '' : toLocalInput(m.date)}" class="${IN}"></div>
    <div><label class="${LBL}">Ground</label><input id="mg" value="${esc(isNew ? '' : m.ground || '')}" class="${IN}"></div>
    <div><label class="${LBL}">Umpires</label><input id="mu" value="${esc(isNew ? '' : m.umpires || '')}" class="${IN}"></div>
    <div><label class="${LBL}">Runs for a wide</label><input id="mwd" type="number" min="1" max="5" value="${isNew ? (r.wide_runs ?? 1) : (m.wd_runs ?? 1)}" class="${IN}"></div>
    <div><label class="${LBL}">Runs for a no ball</label><input id="mnb" type="number" min="1" max="5" value="${isNew ? (r.nb_runs ?? 1) : (m.nb_runs ?? 1)}" class="${IN}"></div>
    <div class="col-span-2"><label class="${LBL}">Free hit after a no ball</label><select id="mfh" class="${IN}"><option value="1" ${(isNew ? (r.free_hit ?? 1) : (m.fh ?? 1)) ? 'selected' : ''}>Yes</option><option value="0" ${(isNew ? (r.free_hit ?? 1) : (m.fh ?? 1)) ? '' : 'selected'}>No</option></select></div></div>
    ${started ? '<p class="text-xs text-slate-500 mb-3">The teams and overs are locked once the match has started. During the match use More > Revise overs / target.</p>' : ''}`;
}
function readMatchFields() {
  const dv = $('#md').value;
  return { a: $('#ma').value, b: $('#mb').value, stage: $('#ms').value, overs: +$('#mo').value, mx: +$('#mx').value, mw: Math.max(1, +$('#mw').value || 10), pp: Math.max(0, +$('#mpp').value || 0),
    date: dv ? new Date(dv).getTime() : null, ground: $('#mg').value.trim(), umpires: $('#mu').value.trim(), wd: Math.max(1, +$('#mwd').value || 1), nb: Math.max(1, +$('#mnb').value || 1), fh: +$('#mfh').value };
}
function newMatchSheet() {
  if (teams().length < 2) return toast('Add at least two teams first (Teams tab)', true);
  showSheet(`<div class="font-display text-3xl font-bold mb-3">New match</div>${matchFields({}, true)}
    <p class="text-xs text-slate-500 mb-3">The toss is recorded when you start the match.</p>
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="mk" class="${B1}">Create match</button></div>`);
}
function makeMatch() {
  const o = readMatchFields(), a = o.a, b = o.b;
  if (a === b) return toast('Pick two different teams', true);
  if (!(o.overs >= 1)) return toast('Overs must be at least 1', true);
  for (const id of [a, b]) if (teamPlayers(id).length < 2) return toast(`${meta.teams[id].name} needs at least 2 players`, true);
  const ga = grpOf(meta.teams[a]), gb = grpOf(meta.teams[b]);
  const mid = push(ref(db, `tournaments/${T}/match_index`)).key;
  update(ref(db, `tournaments/${T}/match_index/${mid}`), matchInfo(a, b, { ...o, group: ga === gb && o.stage === 'Group' ? ga : '' }))
    .then(() => { closeSheet(); toast('Match created'); }).catch(fail);
}
function editMatchSheet(id) {
  const m = matches[id];
  showSheet(`<div class="font-display text-3xl font-bold mb-3">Edit match</div>${matchFields(m, false)}
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="save-match" data-id="${id}" class="${B1}">Save</button></div>`);
}
function saveMatchEdit(id) {
  const m = matches[id], o = readMatchFields(), up = {}, started = (m.status || 'scheduled') !== 'scheduled';
  const set = (f, v) => { if ((m[f] ?? null) !== (v ?? null)) putInfo(up, id, f, v === '' ? '' : v); };
  if (!started) {
    if (o.a === o.b) return toast('Pick two different teams', true);
    if (!(o.overs >= 1)) return toast('Overs must be at least 1', true);
    if (o.a !== m.team_a_id) { const t = meta.teams[o.a]; set('team_a_id', o.a); set('team_a_name', t.name); set('team_a_abbr', t.abbr); set('team_a_color', t.color); if (m.token) up[`overlay/${m.token}/logos/a`] = logos[o.a] || null; }
    if (o.b !== m.team_b_id) { const t = meta.teams[o.b]; set('team_b_id', o.b); set('team_b_name', t.name); set('team_b_abbr', t.abbr); set('team_b_color', t.color); if (m.token) up[`overlay/${m.token}/logos/b`] = logos[o.b] || null; }
    set('overs', o.overs);
  }
  set('stage', o.stage); set('max_bowler_overs', o.mx); set('max_wickets', o.mw); set('pp', o.pp); set('date', o.date); set('ground', o.ground); set('umpires', o.umpires); set('wd_runs', o.wd); set('nb_runs', o.nb); set('fh', o.fh);
  if (!Object.keys(up).length) { closeSheet(); return toast('Nothing changed'); }
  update(ref(db), up).then(() => { closeSheet(); toast('Match updated'); }).catch(fail);
}
function xiSheet(id) {
  const m = matches[id];
  const side = s => {
    const tid = s === 'a' ? m.team_a_id : m.team_b_id, sel = new Set(m['xi_' + s] || []), pl = teamPlayers(tid);
    return `<div class="mb-4"><div class="flex items-center justify-between mb-1"><div class="font-display text-2xl font-bold">${esc(s === 'a' ? m.team_a_name : m.team_b_name)}</div><button data-a="xi-all" data-v="${s}" class="text-sm font-semibold text-brand">Select all</button></div>
      <div class="max-h-48 overflow-y-auto rounded-xl bg-slate-50 p-2">${pl.map(p => `<label class="flex items-center gap-2 py-1.5"><input type="checkbox" class="xi-${s} w-5 h-5" value="${p.id}" ${sel.has(p.id) ? 'checked' : ''}> <span>${esc(p.name)}${p.no ? ` <span class="text-slate-400 text-xs">#${p.no}</span>` : ''}</span></label>`).join('') || '<span class="text-sm text-slate-400">No players</span>'}</div>
      <div class="grid grid-cols-2 gap-2 mt-2"><div><label class="${LBL}">Captain</label><select id="cap-${s}" class="${IN}"><option value="">None</option>${pl.map(p => `<option value="${p.id}" ${m['cap_' + s] === p.id ? 'selected' : ''}>${esc(p.name)}</option>`).join('')}</select></div>
      <div><label class="${LBL}">Wicketkeeper</label><select id="wk-${s}" class="${IN}"><option value="">None</option>${pl.map(p => `<option value="${p.id}" ${m['wk_' + s] === p.id ? 'selected' : ''}>${esc(p.name)}</option>`).join('')}</select></div></div></div>`;
  };
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Playing XI</div><p class="text-sm text-slate-500 mb-3">Tick the players who are playing. Only they appear when you score. Leave everything unticked to use the whole squad.</p>${side('a')}${side('b')}
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="xi-save" data-id="${id}" class="${B1}">Save XI</button></div>`);
}
function saveXI(id) {
  const m = matches[id], up = {};
  for (const s of ['a', 'b']) {
    const ids = [...document.querySelectorAll(`.xi-${s}:checked`)].map(x => x.value);
    if (ids.length === 1) return toast('Pick at least 2 players for each team, or none', true);
    const cap = $(`#cap-${s}`).value, wk = $(`#wk-${s}`).value;
    putInfo(up, id, 'xi_' + s, ids.length ? ids : null);
    putInfo(up, id, 'cap_' + s, ids.length && cap ? cap : null); putInfo(up, id, 'wk_' + s, ids.length && wk ? wk : null);
    putInfo(up, id, 'xi_' + s + '_n', ids.length ? ids.map(pid => nm(pid) + (pid === cap ? ' (c)' : '') + (pid === wk ? ' \u2020' : '')) : null);
  }
  update(ref(db), up).then(() => { closeSheet(); toast('Playing XI saved'); }).catch(fail);
}
function resultSheet(id) {
  const m = matches[id]; ui.mr = ui.mr && ui.mr.id === id ? ui.mr : { id, type: 'walkover', winner: m.team_a_id };
  const r = ui.mr;
  showSheet(`<div class="font-display text-3xl font-bold mb-3">Walkover, abandoned or no result</div>
    <div class="grid grid-cols-3 gap-2 mb-3">${[['walkover', 'Walkover'], ['abandoned', 'Abandoned'], ['noresult', 'No result']].map(([k, l]) => `<button data-a="res-type" data-v="${k}" class="h-11 rounded-xl text-sm font-semibold ${r.type === k ? 'bg-navy-900 text-white' : 'bg-slate-100 text-slate-700'}">${l}</button>`).join('')}</div>
    ${r.type === 'walkover' ? `<label class="${LBL}">Winner</label><select id="res-w" class="${IN} mb-3"><option value="${m.team_a_id}" ${r.winner === m.team_a_id ? 'selected' : ''}>${esc(m.team_a_name)}</option><option value="${m.team_b_id}" ${r.winner === m.team_b_id ? 'selected' : ''}>${esc(m.team_b_name)}</option></select>` : '<p class="text-sm text-slate-500 mb-3">Both teams get the "no result" points from your rules.</p>'}
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="res-save" data-id="${id}" class="${B1}">Save result</button></div>`);
}
async function manualResult(mid, type, winner) {
  const m = matches[mid]; if (m.finalized) return toast('This match is already finished. Reopen it first.', true);
  if (!confirm('Close this match with this result? The points table will be updated.')) return;
  try {
    const lock = await runTransaction(ref(db, `tournaments/${T}/match_index/${mid}/finalized`), cur => cur ? undefined : true);
    if (!lock.committed) return toast('Already finished', true);
    const winPts = +(meta.points_win ?? 2), nrPts = +(meta.points_nr ?? 1), up = {}, fin = {}, wn = winner === m.team_a_id ? m.team_a_name : m.team_b_name;
    const text = type === 'walkover' ? `${wn} won by walkover` : type === 'abandoned' ? 'Match abandoned' : 'No result';
    if ((m.stage || 'Group') === 'Group') {
      for (const id of [m.team_a_id, m.team_b_id]) {
        const t = meta.teams[id], row = { ...ptRow(t, t.group || 'A'), ...((await get(ref(db, `tournaments/${T}/points_table/${id}`))).val() || {}) };
        const d = type === 'walkover' ? (id === winner ? { p: 1, w: 1, l: 0, t: 0, pts: winPts } : { p: 1, w: 0, l: 1, t: 0, pts: 0 }) : { p: 1, w: 0, l: 0, t: 1, pts: nrPts };
        row.matches_played += d.p; row.wins += d.w; row.losses += d.l; row.ties += d.t; row.points += d.pts;
        up[`tournaments/${T}/points_table/${id}`] = row; fin[id] = { ...d, rs: 0, bf: 0, rc: 0, bb: 0 };
      }
    }
    up[`tournaments/${T}/match_index/${mid}/fin`] = fin;
    putInfo(up, mid, 'status', 'completed'); putInfo(up, mid, 'result', text); putInfo(up, mid, 'winner_id', type === 'walkover' ? winner : 'none'); putInfo(up, mid, 'result_type', type);
    await update(ref(db), up); closeSheet(); toast('Result saved');
  } catch (e) { fail(e); }
}
async function reopenMatch(mid) {
  const m = matches[mid]; if (!m.finalized) return toast('This match is not finalised', true);
  if (!confirm('Reopen this match? The points table is corrected, and you can score or fix it and finalise again.')) return;
  try {
    const up = {}, fin = m.fin || {};
    for (const id in fin) {
      const row = (await get(ref(db, `tournaments/${T}/points_table/${id}`))).val(); if (!row) continue; const d = fin[id];
      row.matches_played -= d.p || 0; row.wins -= d.w || 0; row.losses -= d.l || 0; row.ties -= d.t || 0; row.points -= d.pts || 0;
      row.total_runs_scored -= d.rs || 0; row.total_balls_faced -= d.bf || 0; row.total_runs_conceded -= d.rc || 0; row.total_balls_bowled -= d.bb || 0;
      row.total_overs_faced = +(row.total_balls_faced / 6).toFixed(3); row.total_overs_bowled = +(row.total_balls_bowled / 6).toFixed(3); row.net_run_rate = +nrrOf(row).toFixed(3);
      up[`tournaments/${T}/points_table/${id}`] = row;
    }
    const scored = !m.result_type;
    putInfo(up, mid, 'status', scored ? 'live' : 'scheduled'); putInfo(up, mid, 'result', ''); putInfo(up, mid, 'winner_id', null); putInfo(up, mid, 'result_type', null); putInfo(up, mid, 'finalized', null);
    up[`tournaments/${T}/match_index/${mid}/fin`] = null;
    if (scored) { up[`tournaments/${T}/matches/${mid}/live/status`] = 'completed'; if (m.token) up[`overlay/${m.token}/live/status`] = 'completed'; }
    await update(ref(db), up); closeSheet(); toast('Match reopened');
  } catch (e) { fail(e); }
}
function moreSheet(id) {
  const m = matches[id], on = m.active !== false;
  showSheet(`<div class="font-display text-3xl font-bold mb-3">${esc(m.team_a_abbr)} v ${esc(m.team_b_abbr)}</div><div class="space-y-2">
    <button data-a="edit-match" data-id="${id}" class="${B2} w-full">Edit match details</button>
    <button data-a="xi-open" data-id="${id}" class="${B2} w-full">Playing XI, captain, wicketkeeper</button>
    <button data-a="open-ov" data-id="${id}" class="${B2} w-full">Preview overlay</button>
    <button data-a="toggle" data-id="${id}" class="${B2} w-full">${on ? 'Switch overlay OFF for this match' : 'Switch overlay ON for this match'}</button>
    ${m.token ? `<button data-a="rotate" data-id="${id}" class="${B2} w-full">New overlay link (old one stops)</button>` : ''}
    ${m.status === 'completed' ? `<button data-a="pom" data-id="${id}" class="${B2} w-full">Player of the match: ${esc(m.pom_name || 'choose')}</button>` : ''}
    ${!m.finalized && !m.result_type ? `<button data-a="res-open" data-id="${id}" class="${B2} w-full">Walkover, abandoned or no result</button>` : ''}
    ${m.finalized ? `<button data-a="reopen" data-id="${id}" class="${B2} w-full">Reopen this match</button>` : ''}
    <button data-a="delmatch" data-id="${id}" class="${B3} w-full">Delete match</button>
    <button data-a="close" class="${B2} w-full">Close</button></div>`);
}
function gfxSheet(id) {
  const b = (t, l, s) => `<button data-a="gfx" data-v="${t}" data-id="${id}" class="${B2} !h-auto py-3 text-left w-full"><div class="font-semibold">${l}</div><div class="text-xs text-slate-500 font-normal">${s}</div></button>`;
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Live graphics</div><p class="text-sm text-slate-500 mb-3">Tap to show a graphic on the stream overlay.</p>
    <div class="space-y-2">${b('strip', 'Scoreboard', 'The normal live score strip')}${b('intro', 'Match intro', 'Teams, logos, stage and overs')}${b('xi', 'Playing XI', 'Both teams with captain and wicketkeeper')}${b('batter', 'Batter card', 'Runs, balls, 4s, 6s, strike rate')}${b('partnership', 'Partnership', 'Both batters and their stand')}${b('bowler', 'Bowler card', 'Figures and economy')}${b('overs', 'Over summary', 'The last over ball by ball')}${b('break', 'Innings break', 'Score and target')}${b('result', 'Result card', 'Winner, scores and player of the match')}${b('hide', 'Hide everything', 'Clear the screen')}</div>
    <button data-a="close" class="${B2} w-full mt-3">Close</button>`);
}
function schedSheet() {
  const today = toLocalInput(Date.now()).slice(0, 10);
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Set dates and times</div><p class="text-sm text-slate-500 mb-3">Fills the upcoming matches that have no date yet, in order.</p>
    <div class="grid grid-cols-2 gap-3 mb-3"><div><label class="${LBL}">First day</label><input id="sd" type="date" value="${today}" class="${IN}"></div><div><label class="${LBL}">First match time</label><input id="st" type="time" value="10:00" class="${IN}"></div>
      <div><label class="${LBL}">Matches per day</label><input id="sn" type="number" min="1" value="3" class="${IN}"></div><div><label class="${LBL}">Gap in minutes</label><input id="sg" type="number" min="10" value="120" class="${IN}"></div>
      <div class="col-span-2"><label class="${LBL}">Ground (optional)</label><input id="sgr" class="${IN}"></div></div>
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="sched-save" class="${B1}">Set dates</button></div>`);
}
function applySchedule() {
  const sd = $('#sd').value, st = $('#st').value || '10:00', per = Math.max(1, +$('#sn').value || 3), gap = Math.max(10, +$('#sg').value || 120), gr = $('#sgr').value.trim();
  if (!sd) return toast('Pick the first day', true);
  const list = Object.entries(matches).filter(([, m]) => (m.status || 'scheduled') === 'scheduled' && !m.date).sort((a, b) => (a[1].created || 0) - (b[1].created || 0));
  if (!list.length) return toast('No upcoming match without a date', true);
  const up = {}, t0 = new Date(`${sd}T${st}`).getTime();
  list.forEach(([id, m], i) => { putInfo(up, id, 'date', t0 + Math.floor(i / per) * 86400000 + (i % per) * gap * 60000); if (gr && !m.ground) putInfo(up, id, 'ground', gr); });
  update(ref(db), up).then(() => { closeSheet(); toast(`${list.length} match(es) scheduled`); }).catch(fail);
}
function reviseSheet() {
  showDark(`<div class="font-display text-3xl font-bold mb-1">Revise overs / target</div><p class="text-sm text-gray-400 mb-3">After rain, enter the new number of overs. For the second innings also enter the new target.</p>
    <label class="block text-sm text-gray-400 mb-1">New overs per innings</label><input id="rv-o" type="number" min="1" value="${live.max_overs}" class="w-full h-14 rounded-xl bg-ink-700 border-2 border-ink-600 px-3 text-lg font-semibold text-white mb-3">
    ${live.target ? `<label class="block text-sm text-gray-400 mb-1">New target</label><input id="rv-t" type="number" min="1" value="${live.target}" class="w-full h-14 rounded-xl bg-ink-700 border-2 border-ink-600 px-3 text-lg font-semibold text-white mb-3">` : ''}
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Cancel</button><button data-a="rv-save" class="h-14 rounded-xl bg-pitch text-black font-display text-2xl font-bold">Apply</button></div>`);
}

/* ---------- TEAMS tab ---------- */
const koName = size => size === 2 ? 'Final' : size === 4 ? 'Semi Final' : size === 8 ? 'Quarter Final' : 'Round of ' + size;
function koCard() {
  const br = meta.bracket || {}, keys = Object.keys(br).sort((a, b) => +a.slice(1) - +b.slice(1)), ts = teams(), ch = champion();
  const rounds = keys.map(k => {
    const r = br[k], ms = (r.matches || []).map(id => matches[id]).filter(Boolean);
    return `<div class="mb-3"><div class="text-xs font-semibold text-slate-500 mb-1">${esc(r.stage)}</div>${ms.map(m => `<div class="flex items-center gap-2 py-1 text-sm"><b>${esc(m.team_a_abbr)}</b> v <b>${esc(m.team_b_abbr)}</b><span class="ml-auto text-right ${m.status === 'completed' ? 'text-emerald-600' : 'text-slate-400'}">${esc(m.result || m.status || 'upcoming')}</span></div>`).join('')}${(r.byes || []).length ? `<div class="text-xs text-slate-500">Bye: ${r.byes.map(id => esc(meta.teams?.[id]?.abbr || '?')).join(', ')}</div>` : ''}</div>`;
  }).join('');
  return `<p class="text-sm text-slate-600 mb-3">Draw with slips as usual, then enter the pairs here for every round. Teams you leave out of a round get a bye.</p>
    <div class="grid grid-cols-2 gap-2"><button data-a="ko-hand" class="${B1}" ${ts.length < 2 ? 'disabled' : ''}>First round by hand</button><button data-a="ko-next-hand" class="${B1}" ${keys.length ? '' : 'disabled'}>Next round by hand</button></div>
    <details class="mt-3"><summary class="text-sm font-semibold text-slate-500 cursor-pointer">Automatic options</summary><div class="grid grid-cols-2 gap-2 mt-2"><button data-a="ko-start" data-v="1" class="${B2}" ${ts.length < 2 ? 'disabled' : ''}>Random draw</button><button data-a="ko-start" data-v="0" class="${B2}" ${ts.length < 2 ? 'disabled' : ''}>Team order</button></div><button data-a="ko-next" class="${B2} w-full mt-2" ${keys.length ? '' : 'disabled'}>Next round (auto pair winners)</button></details>
    ${ch ? `<div class="mt-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 p-3 text-center font-semibold">Champions: ${esc(meta.teams?.[ch]?.name || '')}</div><button data-a="card" data-k="champion" data-id="" class="${B2} w-full mt-2">Champion poster</button>` : ''}
    ${rounds ? `<div class="mt-4 pt-3 border-t border-slate-100">${rounds}</div>` : ''}`;
}

async function koStart(random) {
  const ts = teams(); if (ts.length < 2) return toast('Add at least 2 teams', true);
  if (Object.keys(meta.bracket || {}).length && !confirm('A knockout has already started. Start a new bracket? The old matches stay in the list.')) return;
  const order = random ? shuffle(ts) : ts.slice(), n = order.length; let S = 1; while (S < n) S *= 2;
  const byeTeams = order.slice(0, S - n), play = order.slice(S - n);
  const overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5)), up = {}, mids = [], t0 = Date.now(), stage = koName(S);
  for (let i = 0; i + 1 < play.length; i += 2) {
    const mid = push(ref(db, `tournaments/${T}/match_index`)).key; mids.push(mid);
    up[`tournaments/${T}/match_index/${mid}`] = matchInfo(play[i].id, play[i + 1].id, { overs, mx, mw: 10, stage, group: '', created: t0 + i });
  }
  up[`tournaments/${T}/meta/bracket`] = { r1: { stage, matches: mids, byes: byeTeams.map(t => t.id) } };
  const txt = mids.map((m, i) => `${play[2 * i].abbr} v ${play[2 * i + 1].abbr}`).join(', ');
  if (!confirm(`Create ${mids.length} ${stage} match(es): ${txt}${byeTeams.length ? '. Bye: ' + byeTeams.map(t => t.abbr).join(', ') : ''}?`)) return;
  update(ref(db), up).then(() => { toast('Knockout started'); tab = 'matches'; render(true); }).catch(fail);
}
async function koNext() {
  const br = meta.bracket || {}, keys = Object.keys(br).sort((a, b) => +a.slice(1) - +b.slice(1));
  if (!keys.length) return toast('Start the knockout first', true);
  const last = br[keys[keys.length - 1]], ms = (last.matches || []).map(id => matches[id]);
  if (ms.some(m => !m || m.status !== 'completed' || !m.winner_id || m.winner_id === 'tie' || m.winner_id === 'none')) return toast('Finish every match in this round first. A tie or no result needs a replay or a super over.', true);
  const part = [...(last.byes || []), ...ms.map(m => m.winner_id)];
  if (part.length === 1) return toast(`${meta.teams[part[0]]?.name || 'The winner'} won the tournament`);
  let bye = []; if (part.length % 2) bye = [part.pop()];
  const overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5)), up = {}, mids = [], t0 = Date.now(), stage = koName(part.length + bye.length);
  for (let i = 0; i + 1 < part.length; i += 2) {
    const mid = push(ref(db, `tournaments/${T}/match_index`)).key; mids.push(mid);
    up[`tournaments/${T}/match_index/${mid}`] = matchInfo(part[i], part[i + 1], { overs, mx, mw: 10, stage, group: '', created: t0 + i });
  }
  up[`tournaments/${T}/meta/bracket/r${keys.length + 1}`] = { stage, matches: mids, byes: bye };
  if (!confirm(`Create ${mids.length} ${stage} match(es) from the winners?`)) return;
  update(ref(db), up).then(() => { toast(stage + ' created'); tab = 'matches'; render(true); }).catch(fail);
}
function teamsTab() {
  const ts = teams(), fmt = meta.format || 'league', gc = fmt === 'knockout' ? 1 : (+meta.group_count || 1);
  const groups = gc > 1 ? Array.from({ length: gc }, (_, i) => String.fromCharCode(65 + i)) : ['A'];
  const tc = t => `<button data-a="team" data-id="${t.id}" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-50 active:scale-95 transition text-left">${av(t, 44)}<div class="flex-1 min-w-0"><div class="font-semibold truncate">${esc(t.name)}</div><div class="text-xs text-slate-500">${esc(t.abbr)}, ${teamPlayers(t.id).length} players</div></div><span class="text-slate-300">&rsaquo;</span></button>`;
  const body = groups.map(g => {
    const list = ts.filter(t => gc === 1 || grpOf(t) === g);
    return `<div class="${CARDC} mb-3">${gc > 1 ? `<div class="font-display text-2xl font-bold mb-2">Group ${g}</div>` : ''}<div class="space-y-2">${list.map(tc).join('') || '<p class="text-sm text-slate-400">No teams in this group</p>'}</div></div>`;
  }).join('');
  const league = `<div class="flex flex-wrap gap-2 mb-3">${[1, 2, 3, 4, 5, 6, 8, 10, 12].map(n => `<button data-a="groups" data-v="${n}" class="h-10 px-4 rounded-full text-sm font-semibold ${gc === n ? 'bg-navy-900 text-white' : 'bg-slate-100 text-slate-700'}">${n === 1 ? 'No groups' : n + ' groups'}</button>`).join('')}<button data-a="groups" data-v="x" class="h-10 px-4 rounded-full text-sm font-semibold bg-slate-100 text-slate-700">Other</button></div>
    <div class="grid grid-cols-2 gap-2"><button data-a="draw" class="${B2}" ${ts.length < 2 ? 'disabled' : ''}>Draw teams into groups</button><button data-a="fixtures" class="${B1}" ${ts.length < 2 ? 'disabled' : ''}>Generate fixtures</button></div>
    <div class="grid grid-cols-2 gap-2 mt-2"><button data-a="ko-semi" class="${B2}" ${ts.length < 4 ? 'disabled' : ''}>Create semi finals</button><button data-a="ko-final" class="${B2}">Create final</button></div>`;
  const copyBtn = Object.keys(tournaments).length > 1 ? `<button data-a="copy-open" class="${B2} w-full mb-3">Copy teams and players from another tournament</button>` : '';
  const act = `<div class="grid grid-cols-2 gap-2 mb-3"><button data-a="bulk-open" class="${B2} !h-10 text-sm">Add many teams</button>${fmt === 'knockout' ? '<span></span>' : `<button data-a="grp-open" class="${B2} !h-10 text-sm" ${ts.length < 2 ? 'disabled' : ''}>Choose groups by hand</button>`}</div>${fmt !== 'knockout' ? `<button data-a="group-hand" class="${B2} w-full mb-3" ${ts.length < 2 ? 'disabled' : ''}>Make matches by hand (from the draw)</button>` : ''}`;
  return act + `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Tournament format</div>
    <div class="grid grid-cols-2 gap-2 mb-3">${[['league', 'League and groups'], ['knockout', 'Knockout']].map(([k, l]) => `<button data-a="format" data-v="${k}" class="h-10 rounded-full text-sm font-semibold ${fmt === k ? 'bg-navy-900 text-white' : 'bg-slate-100 text-slate-700'}">${l}</button>`).join('')}</div>
    ${fmt === 'knockout' ? koCard() : league}</div>${copyBtn}
    ${ts.length ? body : `<div class="${CARDC} text-center text-slate-500">No teams yet. Tap <b>+ Team</b>.</div>`}`;
}
function copySheet() {
  const others = Object.entries(tournaments).filter(([id]) => id !== T);
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Copy teams</div><p class="text-sm text-slate-500 mb-3">Copies the teams, logos and players. Scores and tables start fresh.</p>
    <div class="space-y-2">${others.map(([id, t]) => `<button data-a="copy-do" data-id="${id}" class="${B2} w-full">${esc(t.name)}</button>`).join('')}</div><button data-a="close" class="${B2} w-full mt-3">Cancel</button>`);
}
async function copyTeams(src) {
  try {
    const [m, pl, lg] = await Promise.all([get(ref(db, `tournaments/${src}/meta/teams`)), get(ref(db, `tournaments/${src}/players`)), get(ref(db, `tournaments/${src}/logos`))]);
    const st = m.val() || {}, pls = Object.values(pl.val() || {}), lgs = lg.val() || {};
    if (!Object.keys(st).length) return toast('That tournament has no teams', true);
    if (!confirm(`Copy ${Object.keys(st).length} teams and ${pls.length} players into this tournament?`)) return;
    const up = {}, map = {}, b = `tournaments/${T}`; let ord = Date.now();
    Object.entries(st).forEach(([oid, t]) => {
      const nid = push(ref(db, `${b}/meta/teams`)).key; map[oid] = nid;
      up[`${b}/meta/teams/${nid}`] = { name: t.name, abbr: t.abbr, color: t.color, group: 'A', order: ord++ }; up[`${b}/points_table/${nid}`] = ptRow(t, 'A');
      if (lgs[oid]) up[`${b}/logos/${nid}`] = lgs[oid];
    });
    pls.forEach((p, i) => {
      if (!map[p.team_id]) return; const pid = push(ref(db, `${b}/players`)).key;
      up[`${b}/players/${pid}`] = { name: p.name, team_id: map[p.team_id], team_name: p.team_name, order: p.order ?? i, no: p.no ?? null };
      up[`${b}/leaderboards/${pid}`] = lbRow(p.name, p.team_name);
    });
    await update(ref(db), up); closeSheet(); toast('Teams copied');
  } catch (e) { fail(e); }
}
function teamSheet(id) {
  const t = id ? teamById(id) : { name: '', abbr: '', color: '#0fa968', group: 'A' }, gc = +meta.group_count || 1;
  const gopts = Array.from({ length: gc }, (_, i) => String.fromCharCode(65 + i)).map(g => `<option ${grpOf(t) === g ? 'selected' : ''}>${g}</option>`).join('');
  const pl = id ? teamPlayers(id) : [];
  showSheet(`<div class="font-display text-3xl font-bold mb-3">${id ? 'Edit team' : 'New team'}</div>
    <div class="flex items-center gap-3 mb-3">${id ? av(t, 64) : '<span class="w-16 h-16 rounded-full bg-slate-100"></span>'}<div class="flex-1"><label class="${LBL}">Team logo (optional)</label><input id="tf-logo" type="file" accept="image/*" class="text-sm w-full"></div></div>
    <label class="${LBL}">Team name</label><input id="tf-name" value="${esc(t.name)}" class="${IN} mb-3">
    <div class="grid grid-cols-3 gap-3 mb-3"><div class="col-span-1"><label class="${LBL}">Short code</label><input id="tf-abbr" maxlength="4" value="${esc(t.abbr)}" class="${IN}"></div>
      <div><label class="${LBL}">Colour</label><input id="tf-color" type="color" value="${esc(t.color)}" class="h-12 w-full rounded-xl border border-slate-300 p-1 bg-white"></div>
      ${gc > 1 ? `<div><label class="${LBL}">Group</label><select id="tf-group" class="${IN}">${gopts}</select></div>` : ''}</div>
    <button data-a="team-save" data-id="${id}" class="${B1} w-full mb-4">${id ? 'Save team' : 'Create team'}</button>
    ${id ? `<div class="font-display text-2xl font-bold mb-2">Players (${pl.length})</div>
      <div class="flex flex-wrap gap-2 mb-3">${pl.map(p => `<span class="inline-flex items-center gap-2 pl-3 pr-1 h-9 rounded-full bg-slate-100 text-sm">${esc(p.name)}${p.no ? ` <span class="text-slate-400 text-xs">#${p.no}</span>` : ''}<button data-a="delplayer" data-id="${p.id}" data-t="${id}" class="w-7 h-7 rounded-full bg-slate-200 hover:bg-red-200" aria-label="Remove ${esc(p.name)}">&times;</button></span>`).join('') || '<span class="text-sm text-slate-400">No players yet</span>'}</div>
      <label class="${LBL}">Add players (one name per line, no limit)</label><textarea id="tp-names" rows="5" class="${IN} !h-auto py-2 mb-2" placeholder="Ali 7&#10;Ahmed 10&#10;(name, then jersey number)"></textarea>
      <button data-a="tp-add" data-id="${id}" class="${B2} w-full mb-3">Add players</button>
      <button data-a="team-del" data-id="${id}" class="${B3} w-full mb-2">Remove team</button>` : ''}
    <button data-a="close" class="${B2} w-full">Close</button>`);
}
async function saveTeam(id) {
  const name = $('#tf-name').value.trim(); if (!name) return toast('Enter a team name', true);
  const abbr = ($('#tf-abbr').value.trim() || name.slice(0, 3)).toUpperCase(), color = $('#tf-color').value, group = $('#tf-group') ? $('#tf-group').value : 'A';
  let logo = null; const f = $('#tf-logo').files[0];
  if (f) { try { logo = await resizeImg(f, 128, 128); } catch { return toast('Could not read that image', true); } }
  const tid = id || push(ref(db, `tournaments/${T}/meta/teams`)).key, b = `tournaments/${T}`, up = {};
  up[`${b}/meta/teams/${tid}`] = { ...(meta.teams?.[tid] || {}), name, abbr, color, group, order: meta.teams?.[tid]?.order ?? Date.now() };
  if (id) { up[`${b}/points_table/${tid}/team_name`] = name; up[`${b}/points_table/${tid}/team_abbr`] = abbr; up[`${b}/points_table/${tid}/group`] = group; }
  else up[`${b}/points_table/${tid}`] = { team_name: name, team_abbr: abbr, group, matches_played: 0, wins: 0, losses: 0, ties: 0, points: 0, total_runs_scored: 0, total_balls_faced: 0, total_overs_faced: 0, total_runs_conceded: 0, total_balls_bowled: 0, total_overs_bowled: 0, net_run_rate: 0 };
  if (logo) {
    up[`${b}/logos/${tid}`] = logo;
    Object.values(matches).forEach(m => { if (!m.token) return; if (m.team_a_id === tid) up[`overlay/${m.token}/logos/a`] = logo; if (m.team_b_id === tid) up[`overlay/${m.token}/logos/b`] = logo; });
  }
  update(ref(db), up).then(() => { closeSheet(); toast('Team saved'); }).catch(fail);
}
function addPlayers(tid) {
  const t = meta.teams[tid], lines = $('#tp-names').value.split('\n').map(s => s.trim()).filter(Boolean);
  if (!lines.length) return toast('Enter at least one name', true);
  const up = {}, existing = teamPlayers(tid).length;
  lines.forEach((ln, i) => {
    const mm = ln.match(/^(.*?\D)[\s,\-#]+(\d{1,3})$/), name = (mm ? mm[1] : ln).trim(), no = mm ? +mm[2] : null;
    const pid = push(ref(db, `tournaments/${T}/players`)).key;
    up[`tournaments/${T}/players/${pid}`] = { name, team_id: tid, team_name: t.name, order: existing + i, no };
    up[`tournaments/${T}/leaderboards/${pid}`] = lbRow(name, t.name);
  });
  update(ref(db), up).then(() => { toast(`${lines.length} player(s) added`); setTimeout(() => teamSheet(tid), 250); }).catch(fail);
}
function drawGroups() {
  const n = +meta.group_count || 1;
  if (!confirm(n > 1 ? `Randomly draw teams into ${n} groups? Current groups will be replaced.` : 'Put all teams in one group?')) return;
  const up = {}; shuffle(teams()).forEach((t, i) => {
    const g = n > 1 ? String.fromCharCode(65 + (i % n)) : 'A';
    up[`tournaments/${T}/meta/teams/${t.id}/group`] = g; up[`tournaments/${T}/points_table/${t.id}/group`] = g;
  });
  update(ref(db), up).then(() => toast('Draw complete')).catch(fail);
}
function genFixtures() {
  const overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5)), up = {};
  const exists = (a, b) => Object.values(matches).some(m => (m.stage || 'Group') === 'Group' && ((m.team_a_id === a && m.team_b_id === b) || (m.team_a_id === b && m.team_b_id === a)));
  let n = 0, t0 = Date.now();
  const gs = [...new Set(teams().map(grpOf))].sort();
  gs.forEach(g => {
    const list = teams().filter(t => grpOf(t) === g);
    for (let i = 0; i < list.length; i++) for (let j = i + 1; j < list.length; j++) {
      if (exists(list[i].id, list[j].id)) continue;
      const mid = push(ref(db, `tournaments/${T}/match_index`)).key;
      up[`tournaments/${T}/match_index/${mid}`] = matchInfo(list[i].id, list[j].id, { overs, mx, mw: 10, stage: 'Group', group: (+meta.group_count || 1) > 1 ? g : '', created: t0 + n }); n++;
    }
  });
  if (!n) return toast('All group fixtures already exist');
  if (!confirm(`Create ${n} group matches (${overs} overs each)?`)) return;
  update(ref(db), up).then(() => { toast(`${n} fixtures created`); tab = 'matches'; render(true); }).catch(fail);
}

/* ---------- MANUAL DRAW (paper slips): committee enters the pairs by hand ---------- */
const nextPow2 = n => { let s = 1; while (s < n) s *= 2; return s; };
const PALETTE = ['#e11d48', '#2563eb', '#16a34a', '#d97706', '#7c3aed', '#0891b2', '#db2777', '#65a30d', '#ea580c', '#4f46e5', '#0d9488', '#b91c1c'];
const initials = n => { const w = n.split(/\s+/).filter(Boolean); return (w.length > 1 ? w.map(x => x[0]).join('') : n).slice(0, w.length > 1 ? 4 : 3); };
function koRoundState() {
  const br = meta.bracket || {}, keys = Object.keys(br).sort((a, b) => +a.slice(1) - +b.slice(1));
  if (!keys.length) return { error: 'Make the first round first' };
  const last = br[keys[keys.length - 1]], ms = (last.matches || []).map(id => matches[id]);
  if (ms.some(m => !m || m.status !== 'completed' || !m.winner_id || m.winner_id === 'tie' || m.winner_id === 'none')) return { error: 'Finish every match in this round first. A tie or no result needs a replay or a super over.' };
  const pool = [...(last.byes || []), ...ms.map(m => m.winner_id)];
  if (pool.length === 1) return { error: `${meta.teams[pool[0]]?.name || 'The winner'} won the tournament` };
  return { pool, nextKey: 'r' + (keys.length + 1) };
}
function kpOpen(mode) {
  let pool, stage, excl = true;
  if (mode === 'group') { pool = teams().map(t => t.id); stage = 'Group'; excl = false; }
  else if (mode === 'ko1') {
    if (Object.keys(meta.bracket || {}).length && !confirm('A knockout has already started. Start a new bracket? The old matches stay in the list.')) return;
    pool = teams().map(t => t.id); stage = koName(nextPow2(pool.length));
  } else {
    const st = koRoundState(); if (st.error) return toast(st.error, true);
    pool = st.pool; stage = koName(nextPow2(pool.length));
  }
  if (pool.length < 2) return toast('You need at least 2 teams', true);
  pool.sort((a, b) => (meta.teams[a]?.name || '').localeCompare(meta.teams[b]?.name || ''));
  ui.kp = { mode, pool, stage, excl, pairs: Array.from({ length: mode === 'group' ? 3 : Math.floor(pool.length / 2) }, () => ['', '']) };
  showKp(true);
}
function showKp(fresh) {
  const k = ui.kp, used = new Set(k.pairs.flat().filter(Boolean)), body = $('#sheetBody'), st = (!fresh && body) ? body.scrollTop : 0;
  const opts = sel => `<option value="">Choose team</option>` + k.pool.map(id => `<option value="${id}" ${id === sel ? 'selected' : ''} ${(k.excl && used.has(id) && id !== sel) ? 'disabled' : ''}>${esc(meta.teams[id]?.name || '?')}</option>`).join('');
  const stages = [...new Set([k.stage, ...STAGES, 'Round of 64'])];
  const unpaired = k.excl ? k.pool.filter(id => !used.has(id)) : [];
  const title = k.mode === 'group' ? 'Group matches by hand' : k.mode === 'ko1' ? 'Knockout: first round by hand' : 'Next round by hand';
  showSheet(`<div class="font-display text-3xl font-bold mb-1">${title}</div>
    <p class="text-sm text-slate-500 mb-3">${k.mode === 'group' ? 'Enter the pairs drawn from the slips. A team can be in more than one match.' : 'Enter the pairs drawn from the slips. Teams you leave out get a <b>bye</b> into the next round.'}</p>
    <div class="mb-3"><label class="${LBL}">Stage</label><select id="kp-stage" class="${IN}">${stages.map(s => `<option ${s === k.stage ? 'selected' : ''}>${s}</option>`).join('')}</select></div>
    ${k.pairs.map((p, i) => `<div class="flex items-center gap-1.5 mb-2"><span class="w-6 text-xs text-slate-400">${i + 1}</span><select data-kp="${i}:0" class="${IN} !h-11 text-sm">${opts(p[0])}</select><span class="text-slate-400 text-xs">v</span><select data-kp="${i}:1" class="${IN} !h-11 text-sm">${opts(p[1])}</select><button data-a="kp-del" data-id="${i}" class="w-9 h-11 rounded-lg bg-slate-100 text-slate-500" aria-label="Remove">&times;</button></div>`).join('')}
    <div class="grid grid-cols-2 gap-2 my-3"><button data-a="kp-add" class="${B2} !h-10 text-sm">+ Add a match</button>${k.excl ? `<button data-a="kp-fill" class="${B2} !h-10 text-sm">Fill the rest at random</button>` : '<span></span>'}</div>
    ${k.excl ? `<div class="text-xs text-slate-500 mb-3">${k.pairs.filter(p => p[0] && p[1]).length} match(es), ${unpaired.length} team(s) not paired${unpaired.length ? ' (bye): ' + esc(unpaired.slice(0, 8).map(id => meta.teams[id].abbr).join(', ')) + (unpaired.length > 8 ? '...' : '') : ''}</div>` : ''}
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="kp-create" class="${B1}">Create matches</button></div>`);
  if (!fresh && $('#sheetBody')) $('#sheetBody').scrollTop = st;
}
function kpFill() {
  const k = ui.kp, pool = k.pool.length, S = nextPow2(pool), B = k.mode === 'ko1' ? S - pool : 0, M0 = (pool - B) / 2;
  const used = new Set(k.pairs.flat().filter(Boolean)), done = k.pairs.filter(p => p[0] && p[1]).length;
  const free = shuffle(k.pool.filter(id => !used.has(id))), need = Math.max(0, M0 - done);
  let fi = 0; k.pairs.forEach(p => { if (!p[0] && !p[1] && fi + 1 < free.length && need > 0) { /* filled below */ } });
  const rows = k.pairs.filter(p => !(p[0] && p[1]));
  let made = 0;
  for (const p of k.pairs) { if (made >= need || fi + 1 >= free.length) break; if (!p[0] && !p[1]) { p[0] = free[fi++]; p[1] = free[fi++]; made++; } }
  while (made < need && fi + 1 < free.length) { k.pairs.push([free[fi++], free[fi++]]); made++; }
  showKp();
}
function kpCreate() {
  const k = ui.kp, pairs = k.pairs.filter(p => p[0] || p[1]);
  if (!pairs.length) return toast('Add at least one match', true);
  if (pairs.some(p => !p[0] || !p[1])) return toast('Every match needs two teams', true);
  if (pairs.some(p => p[0] === p[1])) return toast('A match needs two different teams', true);
  if (k.excl) { const all = pairs.flat(); if (new Set(all).size !== all.length) return toast('A team is in two matches', true); }
  const overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5)), up = {}, mids = [], t0 = Date.now(), gc = +meta.group_count || 1;
  const stage = $('#kp-stage') ? $('#kp-stage').value : k.stage;
  pairs.forEach((p, i) => {
    const mid = push(ref(db, `tournaments/${T}/match_index`)).key; mids.push(mid);
    const ga = grpOf(meta.teams[p[0]]), gb = grpOf(meta.teams[p[1]]);
    up[`tournaments/${T}/match_index/${mid}`] = matchInfo(p[0], p[1], { overs, mx, mw: 10, stage, group: (stage === 'Group' && gc > 1 && ga === gb) ? ga : '', created: t0 + i });
  });
  if (k.mode !== 'group') {
    const used = new Set(pairs.flat()), byes = k.pool.filter(id => !used.has(id));
    if (k.mode === 'ko1') up[`tournaments/${T}/meta/bracket`] = { r1: { stage, matches: mids, byes } };
    else up[`tournaments/${T}/meta/bracket/${koRoundState().nextKey}`] = { stage, matches: mids, byes };
  }
  if (!confirm(`Create ${pairs.length} ${stage} match(es)?`)) return;
  update(ref(db), up).then(() => { closeSheet(); toast(`${pairs.length} match(es) created`); tab = 'matches'; render(true); }).catch(fail);
}
function groupSheet() {
  const gc = +meta.group_count || 1, letters = Array.from({ length: gc }, (_, i) => String.fromCharCode(65 + i));
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Choose groups by hand</div><p class="text-sm text-slate-500 mb-3">Set each team's group from the draw. ${gc} group(s): ${letters.join(', ')}.</p>
    <div class="max-h-[55vh] overflow-y-auto pr-1">${teams().map(t => `<div class="flex items-center gap-2 py-1.5 border-b border-slate-100"><span class="flex-1 truncate">${esc(t.name)}</span><select data-grp="${t.id}" class="${IN} !h-10 !w-24">${letters.map(l => `<option ${grpOf(t) === l ? 'selected' : ''}>${l}</option>`).join('')}</select></div>`).join('')}</div>
    <div class="grid grid-cols-2 gap-2 mt-3"><button data-a="close" class="${B2}">Cancel</button><button data-a="grp-save" class="${B1}">Save groups</button></div>`);
}
function saveGroups() {
  const up = {}, count = {};
  document.querySelectorAll('[data-grp]').forEach(s => { const id = s.dataset.grp; up[`tournaments/${T}/meta/teams/${id}/group`] = s.value; up[`tournaments/${T}/points_table/${id}/group`] = s.value; count[s.value] = (count[s.value] || 0) + 1; });
  update(ref(db), up).then(() => { closeSheet(); toast('Groups saved: ' + Object.keys(count).sort().map(g => `${g} ${count[g]}`).join(', ')); }).catch(fail);
}
function bulkSheet() {
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Add many teams</div><p class="text-sm text-slate-500 mb-3">One team per line. You can add a short code after a comma, like <b>Lions, LIO</b>. Colours are chosen for you, and you can add logos later.</p>
    <textarea id="bt-names" rows="12" class="${IN} !h-auto py-2 mb-3" placeholder="Lions, LIO&#10;Tigers&#10;Falcons"></textarea>
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="bulk-save" class="${B1}">Add teams</button></div>`);
}
function addBulkTeams() {
  const lines = $('#bt-names').value.split('\n').map(s => s.trim()).filter(Boolean).slice(0, 120);
  if (!lines.length) return toast('Enter at least one team', true);
  const have = new Set(teams().map(t => t.abbr)), names = new Set(teams().map(t => t.name.toLowerCase())), up = {}; let ord = Date.now(), ci = teams().length, added = 0;
  lines.forEach(ln => {
    const [nm0, ab0] = ln.split(',').map(s => s.trim()); if (!nm0 || names.has(nm0.toLowerCase())) return; names.add(nm0.toLowerCase());
    const ab = (ab0 || initials(nm0)).toUpperCase().slice(0, 4); let k = ab, n = 2; while (have.has(k)) k = ab.slice(0, 3) + (n++); have.add(k);
    const id = push(ref(db, `tournaments/${T}/meta/teams`)).key, t = { name: nm0, abbr: k, color: PALETTE[ci++ % PALETTE.length], group: 'A', order: ord++ };
    up[`tournaments/${T}/meta/teams/${id}`] = t; up[`tournaments/${T}/points_table/${id}`] = ptRow(t, 'A'); added++;
  });
  if (!added) return toast('Those teams already exist', true);
  update(ref(db), up).then(() => { closeSheet(); toast(`${added} team(s) added`); }).catch(fail);
}
function drawBrand(g, xRight, y, h) {
  g.save(); g.globalAlpha = 0.92; g.font = `800 ${h}px "Barlow Condensed"`; g.textAlign = 'left';
  const r = h * 0.42, w1 = g.measureText('JR').width, w2 = g.measureText('Cricks').width, total = r * 2 + 10 + w1 + w2, x0 = xRight - total, cy = y - h * 0.32;
  g.fillStyle = '#ef4444'; g.beginPath(); g.arc(x0 + r, cy, r, 0, Math.PI * 2); g.fill();
  g.strokeStyle = '#ffffff'; g.lineWidth = Math.max(2, h * 0.06); g.lineCap = 'round';
  g.beginPath(); g.arc(x0 - r * 0.35, cy, r * 1.15, -0.62, 0.62); g.stroke();
  g.beginPath(); g.arc(x0 + r * 2.35, cy, r * 1.15, Math.PI - 0.62, Math.PI + 0.62); g.stroke();
  g.fillStyle = '#fbbf24'; g.fillText('JR', x0 + r * 2 + 10, y); g.fillStyle = '#ffffff'; g.fillText('Cricks', x0 + r * 2 + 10 + w1, y);
  g.restore();
}

/* ---------- TABLE tab ---------- */
const nrrOf = r => (r.total_balls_faced && r.total_balls_bowled) ? (r.total_runs_scored || 0) / (r.total_balls_faced / 6) - (r.total_runs_conceded || 0) / (r.total_balls_bowled / 6) : 0;
async function loadTable() {
  if (ui.lbLoading) return; ui.lbLoading = true;
  try {
    const [pt, lb] = await Promise.all([get(ref(db, `tournaments/${T}/points_table`)), get(ref(db, `tournaments/${T}/leaderboards`))]);
    ui.lb = { pt: pt.val() || {}, lb: Object.values(lb.val() || {}) };
  } catch (e) { fail(e); ui.lb = { pt: {}, lb: [] }; }
  ui.lbLoading = false; render(true);
}
function tableTab() {
  if (!ui.lb) { loadTable(); return `<div class="${CARDC} text-center text-slate-500">Loading...</div>`; }
  const gc = (meta.format === 'knockout') ? 1 : (+meta.group_count || 1), rows = Object.entries(ui.lb.pt).map(([id, r]) => ({ id, ...r, nrr: nrrOf(r), group: gc === 1 ? 'A' : (r.group || meta.teams?.[id]?.group || 'A') }));
  const groups = [...new Set(rows.map(r => r.group))].sort(), ptsOf = r => (r.points || 0) + (r.adj || 0);
  const tbl = g => {
    const rs = rankRows(rows.filter(r => r.group === g));
    return `<div class="${CARDC} mb-3 !p-0 overflow-hidden"><div class="flex items-center justify-between px-4 pt-3 pb-2"><div class="font-display text-2xl font-bold">${gc > 1 ? 'Group ' + g : 'Points table'}</div><button data-a="card" data-k="table" data-id="${gc > 1 ? g : ''}" class="text-sm font-semibold text-brand">Make picture</button></div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-xs text-slate-500"><tr><th class="text-left px-4 py-2">Team</th><th class="px-2">P</th><th class="px-2">W</th><th class="px-2">L</th><th class="px-2">T</th><th class="px-2">Pts</th><th class="px-4 text-right">NRR</th></tr></thead><tbody>
      ${rs.map((r, i) => `<tr class="border-t border-slate-100"><td class="px-4 py-2.5"><div class="flex items-center gap-2">${av({ id: r.id, abbr: r.team_abbr, color: meta.teams?.[r.id]?.color }, 28)}<span class="font-semibold">${esc(r.team_abbr)}</span>${i === 0 && ptsOf(r) > 0 ? '<span class="text-[10px] font-bold text-brand">TOP</span>' : ''}<button data-a="adj" data-id="${r.id}" class="text-[11px] text-slate-400 underline ml-1">adjust</button></div></td><td class="text-center">${r.matches_played || 0}</td><td class="text-center">${r.wins || 0}</td><td class="text-center">${r.losses || 0}</td><td class="text-center">${r.ties || 0}</td><td class="text-center font-bold">${ptsOf(r)}${r.adj ? `<div class="text-[10px] font-normal text-slate-400">(${r.adj > 0 ? '+' : ''}${r.adj})</div>` : ''}</td><td class="px-4 text-right font-semibold ${r.nrr < 0 ? 'text-red-600' : 'text-emerald-600'}">${(r.nrr > 0 ? '+' : '') + r.nrr.toFixed(3)}</td></tr>`).join('')}</tbody></table></div></div>`;
  };
  const top = (f, sortFn, sub, kind, title) => {
    const l = ui.lb.lb.filter(p => (p[f] || 0) > 0).sort(sortFn).slice(0, 5);
    return `<div class="${CARDC} mb-3"><div class="flex items-center justify-between mb-2"><div class="font-display text-2xl font-bold">${title}</div><button data-a="card" data-k="${kind}" data-id="" class="text-sm font-semibold text-brand">Make picture</button></div>
      ${l.map((p, i) => `<div class="flex items-center gap-3 py-2 border-t border-slate-100 first:border-0"><span class="w-6 font-display text-xl ${i === 0 ? 'text-amber-500' : 'text-slate-400'}">${i + 1}</span><div class="flex-1 min-w-0"><div class="font-semibold truncate">${esc(p.player_name)}</div><div class="text-xs text-slate-500">${esc(p.team_name)}, ${sub(p)}</div></div><span class="font-display text-3xl font-bold">${p[f]}</span></div>`).join('') || '<p class="text-sm text-slate-400">Nobody yet</p>'}</div>`;
  };
  const econ = p => p.total_balls_bowled ? (p.total_runs_conceded || 0) / (p.total_balls_bowled / 6) : 99;
  const mos = ui.lb.lb.map(p => ({ ...p, pts: mosPts(p) })).filter(p => p.pts > 0).sort((a, b) => b.pts - a.pts).slice(0, 3);
  const ch = champion();
  return (groups.map(tbl).join('') || `<div class="${CARDC} text-slate-500 mb-3">No teams yet.</div>`)
    + top('total_runs', (a, b) => b.total_runs - a.total_runs || (a.total_balls_faced || 0) - (b.total_balls_faced || 0), p => `${p.total_balls_faced || 0} balls`, 'orange', 'Orange Cap')
    + top('total_wickets', (a, b) => b.total_wickets - a.total_wickets || econ(a) - econ(b), p => `econ ${p.total_balls_bowled ? econ(p).toFixed(2) : '-'}`, 'purple', 'Purple Cap')
    + top('total_boundaries', (a, b) => b.total_boundaries - a.total_boundaries || (b.total_sixes || 0) - (a.total_sixes || 0), p => `${p.total_sixes || 0} sixes, ${p.total_fours || 0} fours`, 'boundary', 'Boundary King')
    + `<div class="${CARDC} mb-3"><div class="flex items-center justify-between mb-2"><div class="font-display text-2xl font-bold">Man of the Tournament</div><button data-a="card" data-k="mos" data-id="" class="text-sm font-semibold text-brand">Make picture</button></div>
      ${mos.map((p, i) => `<div class="flex items-center gap-3 py-2 border-t border-slate-100 first:border-0"><span class="w-6 font-display text-xl ${i === 0 ? 'text-amber-500' : 'text-slate-400'}">${i + 1}</span><div class="flex-1 min-w-0"><div class="font-semibold truncate">${esc(p.player_name)}</div><div class="text-xs text-slate-500">${esc(p.team_name)}, ${p.total_runs || 0} runs, ${p.total_wickets || 0} wkts</div></div><span class="font-display text-3xl font-bold">${p.pts}</span></div>`).join('') || '<p class="text-sm text-slate-400">Nobody yet</p>'}
      <p class="text-xs text-slate-400 mt-2">Points: 1 per run, 25 per wicket, 2 per six, 1 per four, 8 per maiden.</p></div>
    ${ch ? `<button data-a="card" data-k="champion" data-id="" class="${B1} w-full mb-3">Champion poster</button>` : ''}
    <button data-a="refresh-table" class="${B2} w-full">Refresh</button>`;
}
function adjSheet(id) {
  const r = ui.lb.pt[id] || {};
  showSheet(`<div class="font-display text-3xl font-bold mb-1">Adjust points</div><p class="text-sm text-slate-500 mb-3">${esc(r.team_name || '')}. Use a minus number to take points away.</p>
    <label class="${LBL}">Points added or removed (total)</label><input id="adj-v" type="number" value="${r.adj || 0}" class="${IN} mb-3"><label class="${LBL}">Reason (optional)</label><input id="adj-n" value="${esc(r.adj_note || '')}" class="${IN} mb-3">
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Cancel</button><button data-a="adj-save" data-id="${id}" class="${B1}">Save</button></div>`);
}

/* ---------- SETTINGS tab ---------- */
function nameCard() {
  if (role === 'admin') return '';
  return `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-1">Committee owner name</div><p class="text-xs text-slate-500 mb-2">Saved a wrong name? Fix it here.</p><div class="flex gap-2"><input id="cname" value="${esc(committee?.name || '')}" maxlength="80" class="${IN}"><button data-a="save-cname" class="${B1}">Save</button></div></div>`;
}
function tnameCard() {
  if (!T || !meta) return '';
  return `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-1">Tournament name</div><p class="text-xs text-slate-500 mb-2">Saved a wrong tournament name? Fix it here.</p><div class="flex gap-2"><input id="tn2" value="${esc(meta.name || '')}" maxlength="80" class="${IN}"><button data-a="save-tname" class="${B1}">Save</button></div></div>`;
}
function saveTname() {
  const n = $('#tn2').value.trim();
  if (n.length < 2) return toast('Name is too short', true);
  const up = { [`tournaments/${T}/meta/name`]: n, [`user_tournaments/${meta.owner || user.uid}/${T}/name`]: n };
  Object.keys(matches || {}).forEach(id => putInfo(up, id, 'tname', n));
  update(ref(db), up).then(() => { toast('Tournament name saved'); render(true); }).catch(fail);
}
function saveCname() {
  const n = $('#cname').value.trim();
  if (n.length < 2) return toast('Name is too short', true);
  const up = { [`committees/${user.uid}/name`]: n };
  update(ref(db), up).then(() => { committee = { ...committee, name: n }; try { localStorage.setItem('cl_auth', JSON.stringify({ uid: user.uid, role, committee })); } catch (e) {} toast('Name saved'); render(true); }).catch(fail);
}
function settingsTab() {
  const topts = Object.entries(tournaments).map(([id, t]) => `<option value="${id}" ${id === T ? 'selected' : ''}>${esc(t.name)}</option>`).join('');
  const sp = logos.sponsor, spn = meta.sponsor_name || '', r = meta.rules || {}, tl = logos.tournament, th = meta.theme || 'dark', tb = meta.tiebreak || 'nrr';
  const chip = (on, a, v, l) => `<button data-a="${a}" data-v="${v}" class="h-10 px-4 rounded-full text-sm font-semibold ${on ? 'bg-navy-900 text-white' : 'bg-slate-100 text-slate-700'}">${l}</button>`;
  return licenseCard() + nameCard() + tnameCard() + `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Tournament</div>
      ${topts ? `<select id="tsel" class="${IN} mb-3">${topts}</select>` : ''}
      ${canMakeT() ? `<div class="flex gap-2"><input id="tname" placeholder="New tournament name" class="${IN}"><button data-a="tnew" class="${B1}">Create</button></div>` : `<p class="text-sm text-slate-600 mb-2">Your license covers 1 tournament. For another tournament, please contact the admin.</p><a href="${waLink(`Assalam o Alaikum, I am ${committee?.name || ''} (${user?.email || ''}). Please allow one more tournament.`)}" target="_blank" rel="noopener" class="${B2} w-full flex items-center justify-center">Ask admin on WhatsApp</a>`}</div>
    ${T ? `<div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Tournament look</div>
      <label class="${LBL}">Tournament logo (shown on pictures and the stream)</label>
      <div class="flex items-center gap-3 mb-3">${tl ? `<img src="${tl}" class="h-14 w-14 rounded-full object-cover border border-slate-200" alt="">` : '<span class="text-sm text-slate-400">No logo yet</span>'}<input id="tlogo" type="file" accept="image/*" class="text-sm flex-1"></div>
      <label class="${LBL}">Overlay style</label><div class="flex flex-wrap gap-2 mb-3">${chip(th === 'dark', 'theme', 'dark', 'Classic dark')}${chip(th === 'glass', 'theme', 'glass', 'Glass')}${chip(th === 'bold', 'theme', 'bold', 'Bold colour')}</div>
      <label class="${LBL}">Accent colour (overlay highlights)</label><input id="acc" type="color" value="${esc(meta.accent || '#fbbf24')}" class="h-12 w-24 rounded-xl border border-slate-300 p-1 bg-white mb-3">
      <button data-a="save-look" class="${B1} w-full">Save look</button></div>
    <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Rules</div>
      <div class="grid grid-cols-2 gap-3 mb-3"><div><label class="${LBL}">Points for a win</label><input id="pw" type="number" min="0" value="${meta.points_win ?? 2}" class="${IN}"></div>
      <div><label class="${LBL}">Points each for a tie</label><input id="pti" type="number" min="0" value="${meta.points_tie ?? 1}" class="${IN}"></div>
      <div><label class="${LBL}">Points each for no result</label><input id="pnr" type="number" min="0" value="${meta.points_nr ?? 1}" class="${IN}"></div>
      <div><label class="${LBL}">Default overs</label><input id="dov" type="number" min="1" max="50" value="${meta.default_overs ?? 10}" class="${IN}"></div>
      <div><label class="${LBL}">Runs for a wide</label><input id="rw" type="number" min="1" max="5" value="${r.wide_runs ?? 1}" class="${IN}"></div>
      <div><label class="${LBL}">Runs for a no ball</label><input id="rn" type="number" min="1" max="5" value="${r.nb_runs ?? 1}" class="${IN}"></div>
      <div><label class="${LBL}">Free hit after no ball</label><select id="rfh" class="${IN}"><option value="1" ${(r.free_hit ?? 1) ? 'selected' : ''}>Yes</option><option value="0" ${(r.free_hit ?? 1) ? '' : 'selected'}>No</option></select></div>
      <div><label class="${LBL}">Powerplay overs</label><input id="rpp" type="number" min="0" max="20" value="${r.powerplay ?? 0}" class="${IN}"></div></div>
      <label class="${LBL}">When teams are level on points</label><div class="flex flex-wrap gap-2 mb-3">${chip(tb === 'nrr', 'tiebreak', 'nrr', 'Net run rate')}${chip(tb === 'wins', 'tiebreak', 'wins', 'Most wins')}${chip(tb === 'h2h', 'tiebreak', 'h2h', 'Head to head')}</div>
      <p class="text-xs text-slate-500 mb-3">New matches use these rules. You can change a single match with More > Edit match details.</p>
      <button data-a="save-rules" class="${B1} w-full">Save rules</button></div>
    <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Sponsor</div>
      <p class="text-xs text-slate-500 mb-2">Shown on result pictures and the stream overlay.</p>
      <label class="${LBL}">Sponsor name</label><input id="spn" value="${esc(spn)}" class="${IN} mb-3">
      <div class="flex items-center gap-3 mb-3">${sp ? `<img src="${sp}" class="h-14 rounded bg-white p-1 border border-slate-200" alt="">` : '<span class="text-sm text-slate-400">No logo yet</span>'}<input id="splogo" type="file" accept="image/*" class="text-sm flex-1"></div>
      <div class="flex gap-2"><button data-a="save-sp" class="${B1} flex-1">Save sponsor</button>${sp ? `<button data-a="rm-logo" class="${B2}">Remove logo</button>` : ''}</div></div>
    <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-1">Backup</div><p class="text-xs text-slate-500 mb-2">Downloads everything in this tournament (teams, players, matches, balls) as a file you can keep.</p><button data-a="backup" class="${B2} w-full">Download backup</button></div>` : ''}
    <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-1">Problem report</div><p class="text-xs text-slate-500 mb-2">App version ${APP_VER}. If something goes wrong, copy this and send it to the admin on WhatsApp.</p><button data-a="copy-log" class="${B2} w-full">Copy problem report</button></div>
    <button data-a="signout" class="${B2} w-full">Sign out</button>`;
}
function createTournament() {
  if (!canMakeT()) return toast('Your license covers 1 tournament. Contact the admin for another.', true);
  const name = $('#tname').value.trim(); if (!name) return toast('Enter a tournament name', true);
  const id = push(ref(db, `user_tournaments/${user.uid}`)).key;
  update(ref(db), {
    [`user_tournaments/${user.uid}/${id}`]: { name, created: Date.now() },
    [`tournaments/${id}/meta`]: { name, owner: user.uid, created: Date.now(), total_fours: 0, total_sixes: 0, total_wickets: 0, points_win: 2, points_tie: 1, points_nr: 1, default_overs: 10, group_count: 1, format: 'league', theme: 'dark', rules: { wide_runs: 1, nb_runs: 1, free_hit: 1, powerplay: 0 } }
  }).then(() => { T = id; watchTournament(); render(true); toast('Tournament created'); }).catch(fail);
}
function saveRules() {
  const b = `tournaments/${T}/meta`, up = {
    [`${b}/points_win`]: +$('#pw').value, [`${b}/points_tie`]: +$('#pti').value, [`${b}/points_nr`]: +$('#pnr').value, [`${b}/default_overs`]: Math.max(1, +$('#dov').value || 10),
    [`${b}/rules`]: { wide_runs: Math.max(1, +$('#rw').value || 1), nb_runs: Math.max(1, +$('#rn').value || 1), free_hit: +$('#rfh').value, powerplay: Math.max(0, +$('#rpp').value || 0) }
  };
  update(ref(db), up).then(() => toast('Rules saved')).catch(fail);
}
async function saveSponsor() {
  const f = $('#splogo').files[0], name = $('#spn').value.trim(), up = { [`tournaments/${T}/meta/sponsor_name`]: name || null };
  if (f) { try { const lg = await resizeImg(f, 480, 160); up[`tournaments/${T}/logos/sponsor`] = lg; Object.values(matches).forEach(m => { if (m.token) up[`overlay/${m.token}/logos/sponsor`] = lg; }); } catch { return toast('Could not read that image', true); } }
  update(ref(db), up).then(() => { toast('Sponsor saved'); render(true); }).catch(fail);
}
async function saveLook() {
  const up = { [`tournaments/${T}/meta/accent`]: $('#acc').value }, f = $('#tlogo').files[0];
  propagate(up, 'accent', $('#acc').value);
  if (f) { try { const lg = await resizeImg(f, 200, 200); up[`tournaments/${T}/logos/tournament`] = lg; Object.values(matches).forEach(m => { if (m.token) up[`overlay/${m.token}/logos/tournament`] = lg; }); } catch { return toast('Could not read that image', true); } }
  update(ref(db), up).then(() => { toast('Look saved'); render(true); }).catch(fail);
}
async function downloadBackup() {
  try {
    toast('Preparing backup...');
    const data = (await get(ref(db, `tournaments/${T}`))).val() || {};
    const blob = new Blob([JSON.stringify({ exported: new Date().toISOString(), tournament: tournaments[T]?.name, data })], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `backup-${(tournaments[T]?.name || 'tournament').replace(/\W+/g, '-')}-${new Date().toISOString().slice(0, 10)}.json`; a.click();
  } catch (e) { fail(e); }
}

/* ---------- SCORECARD screen ---------- */
let cardRp = {};
function openCard(id) {
  CM = id; screen = 'card'; info = matches[id]; ui.tabCard = 1; ui.cardMode = 'card'; stats = {}; inns = {}; extrasN = {}; fow = {}; cardRp = {};
  csubs.forEach(f => f()); const p = `tournaments/${T}/matches/${id}`;
  csubs = [
    onValue(ref(db, `${p}/stats`), s => { stats = s.val() || {}; render(); }),
    onValue(ref(db, `${p}/innings`), s => { inns = s.val() || {}; render(); }),
    onValue(ref(db, `${p}/extras`), s => { extrasN = s.val() || {}; render(); }),
    onValue(ref(db, `${p}/fow`), s => { fow = s.val() || {}; render(); })
  ];
  loadRp(id); render(true); window.scrollTo(0, 0);
}
async function loadRp(id) {
  try {
    const p = `tournaments/${T}/matches/${id}`, st = (await get(ref(db, `${p}/start`))).val() || {}, led = (await get(ref(db, `${p}/ledger`))).val() || {};
    Object.keys(st).forEach(n => {
      const ents = Object.keys(led[n] || {}).sort().map(k => ({ ...led[n][k], key: k }));
      try { cardRp[n] = replayInnings(st[n], ents); } catch (e) {}
    });
  } catch (e) {}
  if (screen === 'card' && CM === id) render(true);
}
function dismissText(v) {
  const by = v.dismissed_by || '', f = v.fielder || '';
  if (!v.out) return v.rh ? 'retired hurt' : '';
  switch (v.dismissal) {
    case 'Bowled': return `b ${by}`;
    case 'LBW': return `lbw b ${by}`;
    case 'Caught': return f ? (f === by ? `c & b ${by}` : `c ${f} b ${by}`) : `c b ${by}`;
    case 'Stumped': return `st ${f} b ${by}`.replace('st  b', 'st b');
    case 'Run Out': return f ? `run out (${f})` : 'run out';
    case 'Hit Wicket': return `hit wicket b ${by}`;
    default: return String(v.dismissal || '').toLowerCase();
  }
}
const ord = n => { n = +n; const s = ['th', 'st', 'nd', 'rd'], v = n % 100; return n + (s[(v - 20) % 10] || s[v] || s[0]); };
function renderCard() {
  const v = $('#view'); v.className = 'mx-auto max-w-2xl min-h-[100dvh] pb-10';
  const m = matches[CM]; if (!m) return goHome();
  const A = mSide(m, 'a'), Bt = mSide(m, 'b'), n = ui.tabCard || 1, x = inns[n], mode = ui.cardMode || 'card';
  const keys = Object.keys(inns).map(Number).sort((a, b) => a - b);
  const tabs = keys.map(k => { const t = inns[k].batting_team_id === m.team_a_id ? A : Bt; return `<button data-a="card-tab" data-v="${k}" class="h-10 px-4 rounded-full text-sm font-semibold shrink-0 ${n === k ? 'bg-navy-900 text-white' : 'bg-white border border-slate-200 text-slate-600'}">${esc(t.abbr)} ${inns[k].runs}-${inns[k].wickets}${k > 2 ? ' (SO)' : ''}</button>`; }).join('');
  const modes = [['card', 'Scorecard'], ['overs', 'Overs'], ['parts', 'Partnerships'], ['bbb', 'Ball by ball']]
    .map(([k, l]) => `<button data-a="card-mode" data-v="${k}" class="h-9 px-3 rounded-lg text-sm font-semibold shrink-0 ${mode === k ? 'bg-brand text-white' : 'bg-slate-100 text-slate-600'}">${l}</button>`).join('');
  let body = `<div class="${CARDC} text-center text-slate-500">No innings recorded yet.</div>`;
  const rp = cardRp[n];
  if (x && mode === 'card') {
    const so = n > 2 ? Math.floor((n - 1) / 2) : 0, sx = sfxOf(so);
    const batT = x.batting_team_id === m.team_a_id ? A : Bt, bowlT = batT.id === A.id ? Bt : A, ex = extrasN[n] || {};
    const crew = teamPlayers(batT.id).map(p => [p.id, stats[p.id + sx]]).filter(([, s]) => s && (s.bo || s.bat_balls > 0 || s.out)).sort((a, b) => (a[1].bo || 99) - (b[1].bo || 99));
    const yet = xiOf(batT.id).filter(p => !crew.some(([id]) => id === p.id));
    const bowl = teamPlayers(bowlT.id).map(p => [p.id, stats[p.id + sx]]).filter(([, s]) => s && s.bowl_balls > 0).sort((a, b) => b[1].bowl_balls - a[1].bowl_balls);
    const exTot = (ex.wd || 0) + (ex.nb || 0) + (ex.b || 0) + (ex.lb || 0) + (ex.pen || 0);
    const exTxt = [ex.lb ? `${ex.lb}lb` : '', ex.b ? `${ex.b}b` : '', ex.wd ? `${ex.wd}wd` : '', ex.nb ? `${ex.nb}nb` : '', ex.pen ? `${ex.pen}pen` : ''].filter(Boolean).join(',');
    const fl = Object.entries(fow[n] || {}).sort((a, b) => +a[0] - +b[0]);
    const th = 'px-2 py-2 text-right text-xs font-semibold text-slate-500';
    body = `<div class="${CARDC} mb-3 !p-0 overflow-hidden"><div class="flex items-center gap-3 px-4 py-3 bg-slate-50">${av(batT, 36)}<div class="flex-1 font-display text-2xl font-bold">${esc(batT.name)}</div><div class="font-display text-2xl font-bold">${x.runs}-${x.wickets} <span class="text-slate-500 text-lg">(${oversText(x.balls)})</span></div></div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-slate-100"><th class="px-4 py-2 text-left text-xs font-semibold text-slate-500">Batter</th><th class="${th}">R</th><th class="${th}">B</th><th class="${th}">4s</th><th class="${th}">6s</th><th class="${th} pr-4">SR</th></tr></thead><tbody>
      ${crew.map(([id, s]) => `<tr class="border-b border-slate-50"><td class="px-4 py-2.5"><div class="font-semibold">${esc(dn(id))}</div><div class="text-xs ${s.out ? 'text-slate-500' : s.rh ? 'text-amber-600 font-semibold' : 'text-emerald-600 font-semibold'}">${s.out ? esc(dismissText(s)) : s.rh ? 'retired hurt' : 'not out'}</div></td><td class="px-2 text-right font-bold">${s.bat_runs || 0}</td><td class="px-2 text-right">${s.bat_balls || 0}</td><td class="px-2 text-right">${s.fours || 0}</td><td class="px-2 text-right">${s.sixes || 0}</td><td class="px-2 pr-4 text-right">${s.bat_balls ? (s.bat_runs / s.bat_balls * 100).toFixed(1) : '-'}</td></tr>`).join('')}</tbody></table></div>
      <div class="px-4 py-3 text-sm border-t border-slate-100 flex justify-between"><span class="font-semibold">Extras</span><span><b>${exTot}</b> <span class="text-slate-500">${exTxt ? `(${exTxt})` : ''}</span></span></div>
      <div class="px-4 py-3 text-sm border-t border-slate-100 flex justify-between"><span class="font-semibold">Total</span><span><b>${x.runs}</b> <span class="text-slate-500">(${x.wickets} wickets, ${oversText(x.balls)} overs)</span></span></div>
      ${yet.length ? `<div class="px-4 py-3 text-sm border-t border-slate-100"><span class="font-semibold">Yet to bat</span><div class="text-slate-600 mt-0.5">${yet.map(p => esc(p.name)).join(', ')}</div></div>` : ''}
      ${fl.length ? `<div class="px-4 py-3 text-sm border-t border-slate-100"><span class="font-semibold">Fall of wickets</span><div class="text-slate-600 mt-0.5">${fl.map(([k, f]) => `${k}-${f.runs} (${esc(nm(f.out))}, ${f.ball} ov)`).join(', ')}</div></div>` : ''}</div>
      <div class="${CARDC} !p-0 overflow-hidden"><div class="px-4 py-3 bg-slate-50 font-display text-2xl font-bold">${esc(bowlT.name)} bowling</div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-slate-100"><th class="px-4 py-2 text-left text-xs font-semibold text-slate-500">Bowler</th><th class="${th}">O</th><th class="${th}">M</th><th class="${th}">R</th><th class="${th}">W</th><th class="${th} pr-4">Econ</th></tr></thead><tbody>
      ${bowl.map(([id, s]) => `<tr class="border-b border-slate-50"><td class="px-4 py-2.5 font-semibold">${esc(nm(id))}</td><td class="px-2 text-right">${oversText(s.bowl_balls)}</td><td class="px-2 text-right">${s.maidens || 0}</td><td class="px-2 text-right">${s.bowl_runs || 0}</td><td class="px-2 text-right font-bold">${s.bowl_wkts || 0}</td><td class="px-2 pr-4 text-right">${(s.bowl_runs / (s.bowl_balls / 6)).toFixed(2)}</td></tr>`).join('')}</tbody></table></div></div>`;
  } else if (x && !rp) {
    body = `<div class="${CARDC} text-center text-slate-500">${Object.keys(cardRp).length || screen !== 'card' ? 'Loading...' : 'Loading...'} If this stays, the innings was scored before ball-by-ball records existed.</div>`;
  } else if (x && mode === 'overs') {
    body = rp.overs.map(o => `<div class="${CARDC} mb-2"><div class="flex items-center justify-between"><div class="font-display text-2xl font-bold">Over ${o.n}</div><div class="text-sm text-slate-500">${esc(o.bowler)}</div></div>
      <div class="flex flex-wrap gap-1.5 my-2">${o.tags.map(t => `<span class="min-w-[2rem] h-8 px-2 rounded-full flex items-center justify-center text-sm font-bold ${t === 'W' ? 'bg-red-600 text-white' : t === '6' ? 'bg-emerald-500 text-white' : t === '4' ? 'bg-amber-400 text-slate-900' : /^(Wd|Nb|P)/.test(t) ? 'bg-sky-200 text-sky-900' : 'bg-slate-100 text-slate-700'}">${esc(t)}</span>`).join('')}</div>
      <div class="text-sm text-slate-600"><b>${o.runs}</b> runs${o.wk ? `, <b>${o.wk}</b> wicket${o.wk > 1 ? 's' : ''}` : ''} &bull; score after the over: <b>${o.score}/${o.wkts}</b></div></div>`).join('') || `<div class="${CARDC} text-slate-500">No overs yet.</div>`;
  } else if (x && mode === 'parts') {
    body = rp.parts.map(p => `<div class="${CARDC} mb-2"><div class="flex items-center justify-between"><div class="text-xs font-semibold text-slate-500">${p.wkt == null ? 'UNBEATEN' : ord(p.wkt) + ' WICKET'}</div><div class="font-display text-3xl font-bold">${p.runs} <span class="text-slate-500 text-lg">(${p.balls})</span></div></div>
      <div class="font-semibold">${esc(nm(p.a))} &amp; ${esc(nm(p.b))}</div>
      <div class="text-sm text-slate-600">${esc(nm(p.a))} ${p.ra} (${p.ba}) &bull; ${esc(nm(p.b))} ${p.rb} (${p.bb}) &bull; extras ${p.runs - p.ra - p.rb}</div></div>`).join('') || `<div class="${CARDC} text-slate-500">No partnerships yet.</div>`;
  } else if (x && mode === 'bbb') {
    const byOver = {}; rp.log.forEach(b => { (byOver[b.over] = byOver[b.over] || []).push(b); });
    body = Object.keys(byOver).map(Number).sort((a, b) => b - a).map(o => `<div class="${CARDC} mb-2 !p-0 overflow-hidden"><div class="px-4 py-2 bg-slate-50 font-display text-xl font-bold">Over ${o + 1}</div>
      ${byOver[o].slice().reverse().map(b => `<div class="flex items-center gap-3 px-4 py-2 border-t border-slate-100"><span class="font-display text-lg text-slate-400 w-10">${b.label}</span><span class="flex-1 min-w-0 text-sm"><b>${esc(b.bowler)}</b> to ${esc(b.striker)}, <span class="${b.wicket ? 'text-red-600 font-semibold' : ''}">${esc(b.text)}</span></span><span class="font-display text-xl font-bold ${b.wicket ? 'text-red-600' : ''}">${esc(b.tag)}</span></div>`).join('')}</div>`).join('') || `<div class="${CARDC} text-slate-500">No balls yet.</div>`;
  }
  v.innerHTML = `<div class="bg-gradient-to-br from-navy-900 to-navy-700 text-white px-4 pt-4 pb-5 rounded-b-3xl mb-4">
    <button data-a="back" class="h-9 px-3 rounded-lg bg-white/10 text-sm font-semibold mb-3">&lsaquo; Back</button>
    <div class="flex items-center justify-between gap-2"><div class="flex items-center gap-2 min-w-0">${av(A, 52)}<div class="min-w-0"><div class="font-display text-2xl font-bold leading-none">${esc(A.abbr)}</div><div class="text-sm text-white/70 truncate">${esc(m.score_a || '')}</div></div></div>
      <div class="text-white/50 font-bold text-sm">VS</div>
      <div class="flex items-center gap-2 min-w-0 text-right"><div class="min-w-0"><div class="font-display text-2xl font-bold leading-none">${esc(Bt.abbr)}</div><div class="text-sm text-white/70 truncate">${esc(m.score_b || '')}</div></div>${av(Bt, 52)}</div></div>
    ${m.result ? `<div class="text-center mt-3 font-semibold text-emerald-300">${esc(m.result)}</div>` : ''}
    ${m.pom_name ? `<div class="text-center text-xs text-white/70 mt-1">Player of the match: <b class="text-white">${esc(m.pom_name)}</b> ${esc(m.pom_line || '')}</div>` : ''}</div>
    <div class="px-4"><div class="flex gap-2 mb-2 overflow-x-auto">${tabs}</div><div class="flex gap-2 mb-3 overflow-x-auto">${modes}</div>${body}
    <div class="grid grid-cols-2 gap-2 mt-4"><button data-a="card" data-k="summary" data-id="${CM}" class="${B2}">Scorecard picture</button><button data-a="card" data-k="result" data-id="${CM}" class="${B2}">Result picture</button></div></div>`;
}

/* ---------- OVERLAY STUDIO screen ---------- */
async function openStudio(id) {
  STU = id; screen = 'studio'; ui.stuTok = ''; render(true);
  try { ui.stuTok = await ensureToken(id); } catch (e) { fail(e); }
  render(true);
}
function renderStudio() {
  const v = $('#view'); v.className = 'mx-auto max-w-2xl min-h-[100dvh] pb-10';
  const m = matches[STU]; if (!m) return goHome();
  const tk = ui.stuTok, url = tk ? ovLink(tk) : '';
  const gb = (t, l) => `<button data-a="gfx" data-v="${t}" data-id="${STU}" class="${B2} !h-12">${l}</button>`;
  v.innerHTML = `<div class="bg-gradient-to-br from-navy-900 to-navy-700 text-white px-4 pt-4 pb-5 rounded-b-3xl mb-4">
      <button data-a="back" class="h-9 px-3 rounded-lg bg-white/10 text-sm font-semibold mb-3">&lsaquo; Back</button>
      <div class="font-display text-4xl font-extrabold leading-tight">Overlay Studio</div><div class="text-white/70 text-sm">${esc(m.team_a_abbr)} v ${esc(m.team_b_abbr)}</div></div>
    <div class="px-4">
      ${!licOk() ? '<div class="mb-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm p-3">Your overlay license is not active, so the preview below stays empty. Ask the admin to activate it.</div>' : ''}
      <div class="${CARDC} mb-3 !p-2"><div class="relative w-full rounded-xl overflow-hidden" style="aspect-ratio:16/9;background-color:#94a3b8;background-image:conic-gradient(#cbd5e1 25%,#e2e8f0 0 50%,#cbd5e1 0 75%,#e2e8f0 0);background-size:22px 22px">
        ${url ? `<iframe src="${esc(url)}&debug=1" class="absolute inset-0 w-full h-full" style="border:0;background:transparent" title="Overlay preview"></iframe>` : '<div class="absolute inset-0 flex items-center justify-center text-slate-600">Preparing preview...</div>'}</div>
        <div class="text-xs text-slate-500 px-2 pt-2">Preview of what viewers see. It uses one extra connection while this page is open.</div></div>
      <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Graphics</div>
        <div class="grid grid-cols-2 gap-2">${gb('strip', 'Scoreboard')}${gb('intro', 'Match intro')}${gb('batter', 'Batter card')}${gb('partnership', 'Partnership')}${gb('bowler', 'Bowler card')}${gb('overs', 'Over summary')}${gb('break', 'Innings break')}${gb('result', 'Result card')}</div>
        <button data-a="gfx" data-v="hide" data-id="${STU}" class="${B3} w-full mt-2">Hide everything</button>
        <p class="text-xs text-slate-500 mt-2">Four, six and wicket banners, the over summary and the innings break card also appear on their own.</p></div>
      <div class="${CARDC} mb-3"><div class="font-display text-2xl font-bold mb-2">Overlay link</div>
        <div class="flex gap-2"><input readonly value="${esc(url)}" class="${IN} text-xs font-mono"><button data-a="copy-text" data-v="${esc(url)}" class="${B1}" ${url ? '' : 'disabled'}>Copy</button></div></div>
      <div class="${CARDC}"><div class="font-display text-2xl font-bold mb-2">Add it to Prism, OBS or vMix</div>
        <ol class="list-decimal pl-5 text-sm text-slate-700 space-y-1.5"><li>Copy the overlay link above.</li><li>In Prism Live Studio add a <b>Web</b> source (in OBS or vMix, a <b>Browser</b> source) and paste the link.</li><li>Set the size to <b>1920 x 1080</b> (16:9).</li><li>The background is already transparent. Do not add a colour or chroma key.</li><li>Put it above your camera source. If you see "Shutdown source when not visible", turn it off.</li><li>Use the buttons above to show graphics while you stream.</li></ol></div>
    </div>`;
}

/* ---------- KNOCKOUTS ---------- */
async function koTeams() {
  const pt = (await get(ref(db, `tournaments/${T}/points_table`))).val() || {};
  const rows = Object.entries(pt).map(([id, r]) => ({ id, ...r, nrr: nrrOf(r), group: r.group || meta.teams?.[id]?.group || 'A' }));
  const srt = l => l.sort((a, b) => (b.points || 0) - (a.points || 0) || b.nrr - a.nrr || (b.wins || 0) - (a.wins || 0));
  return { rows, srt };
}
async function koSemis() {
  try {
    const gc = +meta.group_count || 1, { rows, srt } = await koTeams();
    if (Object.values(matches).some(m => m.stage === 'Semi Final')) return toast('Semi finals already exist', true);
    let pairs = [];
    if (gc === 1) { const s = srt(rows); if (s.length < 4) return toast('You need at least 4 teams', true); pairs = [[s[0], s[3]], [s[1], s[2]]]; }
    else if (gc === 2) { const A = srt(rows.filter(r => r.group === 'A')), B = srt(rows.filter(r => r.group === 'B')); if (A.length < 2 || B.length < 2) return toast('Each group needs at least 2 teams', true); pairs = [[A[0], B[1]], [B[0], A[1]]]; }
    else if (gc === 4) { const g = L => srt(rows.filter(r => r.group === L))[0]; pairs = [[g('A'), g('B')], [g('C'), g('D')]]; if (pairs.flat().some(x => !x)) return toast('Every group needs a team', true); }
    else return toast('Automatic semi finals work for 1, 2 or 4 groups. For other formats use + New and choose the stage.', true);
    const pending = Object.values(matches).filter(m => (m.stage || 'Group') === 'Group' && m.status !== 'completed').length;
    const txt = pairs.map(p => `${p[0].team_abbr} v ${p[1].team_abbr}`).join(' and ');
    if (!confirm(`${pending ? pending + ' group match(es) are not finished yet. ' : ''}Create semi finals from the table now: ${txt}?`)) return;
    const overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5)), up = {}, t0 = Date.now();
    pairs.forEach((p, i) => { const mid = push(ref(db, `tournaments/${T}/match_index`)).key; up[`tournaments/${T}/match_index/${mid}`] = matchInfo(p[0].id, p[1].id, { overs, mx, mw: 10, stage: 'Semi Final', group: '', created: t0 + i }); });
    await update(ref(db), up); toast('Semi finals created'); tab = 'matches'; render(true);
  } catch (e) { fail(e); }
}
async function koFinal() {
  try {
    const sfs = Object.values(matches).filter(m => m.stage === 'Semi Final');
    if (sfs.length < 2 || sfs.some(m => m.status !== 'completed' || !m.winner_id || m.winner_id === 'tie')) return toast('Both semi finals must be finished with a winner', true);
    if (Object.values(matches).some(m => m.stage === 'Final')) return toast('The final already exists', true);
    const [a, b] = sfs.map(m => m.winner_id), overs = +meta.default_overs || 10, mx = Math.max(1, Math.ceil(overs / 5));
    if (!confirm(`Create the final: ${meta.teams[a].abbr} v ${meta.teams[b].abbr}?`)) return;
    const mid = push(ref(db, `tournaments/${T}/match_index`)).key;
    await update(ref(db, `tournaments/${T}/match_index/${mid}`), matchInfo(a, b, { overs, mx, mw: 10, stage: 'Final', group: '' }));
    toast('Final created'); tab = 'matches'; render(true);
  } catch (e) { fail(e); }
}

/* ---------- sheets ---------- */
function showSheet(html, lock, dark) {
  const b = $('#sheetBody'); b.className = `w-full max-w-md rounded-t-3xl max-h-[92dvh] overflow-y-auto p-4 pb-[max(1rem,env(safe-area-inset-bottom))] ${dark ? 'bg-ink-800 text-white' : 'bg-white text-slate-900'}`;
  b.innerHTML = html; const s = $('#sheet'); s.classList.remove('hidden'); s.classList.add('flex'); ui.lock = !!lock;
}
const showDark = (h, lock) => showSheet(h, lock, true);
function closeSheet() { const s = $('#sheet'); s.classList.add('hidden'); s.classList.remove('flex'); ui.sheet = null; ui.lock = false; }
$('#sheet').addEventListener('click', e => { if (e.target.id === 'sheet' && !ui.lock) closeSheet(); });

/* ---------- SCORING screen ---------- */
const rid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
const SESSION = rid();
let readOnly = false, lockTimer = null, ledSub = null, ledInn = 0, flushP = Promise.resolve(), netOn = true, STU = null;

/* ----- outbox: every ball is kept on the phone until the server confirms it ----- */
const OB = 'cl_outbox_v1';
const obLoad = () => { try { return JSON.parse(localStorage.getItem(OB) || '[]'); } catch { return []; } };
const obSave = a => { try { localStorage.setItem(OB, JSON.stringify(a)); } catch (e) {} };
const decodeUp = up => { const o = {}; for (const k in up) { const v = up[k]; o[k] = (v && typeof v === 'object' && '__inc' in v) ? increment(v.__inc) : v; } return o; };
function updatePending() { const n = $('#net'); if (!n) return; const q = obLoad().length; n.textContent = (netOn ? 'Online' : 'Offline, scores will sync') + (q ? ` (${q} saving)` : ''); }
function send(up, meta) {
  const id = rid(), q = obLoad(); q.push({ id, session: SESSION, up, meta, ts: Date.now() }); obSave(q); updatePending();
  return update(ref(db), decodeUp(up)).then(() => { obSave(obLoad().filter(x => x.id !== id)); updatePending(); })
    .catch(e => { if (e.code === 'PERMISSION_DENIED') { obSave(obLoad().filter(x => x.id !== id)); updatePending(); } toast('Save problem: ' + (e.code || e.message), true); });
}
async function flushOutbox() {
  const q = obLoad().filter(x => x.session !== SESSION);
  for (const it of q) {
    try {
      let applied = false; const m = it.meta;
      if (m) {
        const v = (await get(ref(db, `tournaments/${m.t}/matches/${m.m}/ledger/${m.n}/${m.key}`))).val();
        if (v) { applied = true; if (v.id !== m.opId) toast('One saved ball clashed with a newer entry and was skipped', true); }
      }
      if (!applied) await update(ref(db), decodeUp(it.up));
    } catch (e) { if (e.code !== 'PERMISSION_DENIED') return; }
    obSave(obLoad().filter(x => x.id !== it.id));
  }
  updatePending();
}

/* ----- one scorer at a time ----- */
async function acquireLock(force) {
  const r = await runTransaction(ref(db, `${MP()}/lock`), cur => {
    const now = Date.now();
    if (!cur || force || cur.session === SESSION || now - (cur.ts || 0) > 90000) return { session: SESSION, who: user.email || '', ts: now };
    return;
  });
  return r.committed;
}
function releaseLock() { if (!M) return; runTransaction(ref(db, `${MP()}/lock`), cur => (cur && cur.session === SESSION) ? null : undefined).catch(() => {}); }
const oneScorerOk = () => { if (readOnly) { toast('Another device is scoring this match. Tap Take over to continue here.', true); return false; } return true; };

async function openMatch(id) {
  M = id; info = matches[id]; screen = 'score'; ui.viewKey = ''; ui.toss = null; ui.soN = 0; readOnly = false;
  Object.assign(loaded, { live: 0, stats: 0, inns: 0 }); live = null; stats = {}; inns = {}; lastBall = null; ledInn = 0;
  msubs.forEach(f => f()); msubs = []; if (ledSub) { ledSub(); ledSub = null; } clearInterval(lockTimer);
  ensureToken(id).catch(() => {});
  setTheme(true); $('#nav').classList.add('hidden');
  $('#view').className = 'mx-auto max-w-md min-h-[100dvh]';
  $('#view').innerHTML = backBar + '<div class="p-10 text-center text-gray-400">Opening match...</div>';
  try { await withTimeout(flushP, 4000); } catch (e) {}
  let ok = true; try { ok = await withTimeout(acquireLock(false), 3000); } catch (e) { ok = true; }
  if (M !== id) return;
  readOnly = !ok;
  msubs = [
    watchV(`${MP()}/live`, v => { live = v; loaded.live = 1; if (live && live.innings !== ledInn) watchLedger(live.innings); render(); }),
    watchV(`${MP()}/stats`, v => { stats = v || {}; loaded.stats = 1; render(); }),
    watchV(`${MP()}/innings`, v => { inns = v || {}; loaded.inns = 1; render(); }),
    onValue(ref(db, `${MP()}/lock`), s => { const l = s.val(), o = !!(l && l.session !== SESSION && Date.now() - (l.ts || 0) < 90000); if (o !== readOnly) { readOnly = o; ui.viewKey = ''; render(); } })
  ];
  lockTimer = setInterval(() => runTransaction(ref(db, `${MP()}/lock`), cur => (cur && cur.session === SESSION) ? { ...cur, ts: Date.now() } : undefined).catch(() => {}), 30000);
  render(true);
}
function watchLedger(n) {
  ledInn = n; if (ledSub) ledSub(); lastBall = null;
  ledSub = onValue(query(ref(db, `${MP()}/ledger/${n}`), orderByKey(), limitToLast(1)), s => { lastBall = null; s.forEach(c => { lastBall = { ...c.val(), key: c.key }; }); render(); });
}
function goHome() {
  msubs.forEach(f => f()); csubs.forEach(f => f()); msubs = []; csubs = []; if (ledSub) { ledSub(); ledSub = null; }
  clearInterval(lockTimer); releaseLock(); closeSheet(); M = null; CM = null; STU = null; info = null; screen = 'home'; render(true); window.scrollTo(0, 0);
}
const backBar = `<div class="px-4 pt-3"><button data-a="back" class="h-10 px-4 rounded-xl bg-ink-700 text-white font-semibold">&lsaquo; Matches</button></div>`;
const lockBar = () => readOnly ? `<div class="mx-3 mt-2 rounded-xl bg-amber-500/20 border border-amber-400/40 text-amber-200 text-sm p-3 flex items-center gap-3"><span class="flex-1">Another device is scoring this match. This screen is read-only.</span><button data-a="takeover" class="h-10 px-3 rounded-lg bg-amber-400 text-black font-semibold">Take over</button></div>` : '';

function renderScore() {
  const v = $('#view'); v.className = 'mx-auto max-w-md min-h-[100dvh] pb-[max(0.75rem,env(safe-area-inset-bottom))]';
  if (Object.values(loaded).some(x => !x)) return;
  if (!info) return goHome();
  if (info.active === false) { v.innerHTML = backBar + `<div class="p-8 mt-10 text-center text-gray-300">The overlay for this match is switched off. Switch it on (More) to keep scoring.</div>`; return; }
  const st = live?.status, key = `${st || 'none'}|${live?.innings || 0}|${ui.toss ? ui.toss.win + ui.toss.dec : ''}|${ui.soN || 0}|${readOnly ? 1 : 0}`, isSetup = !live || st === 'innings_break' || ui.soN;
  if (isSetup && ui.viewKey === key && $('#setup')) return;
  ui.viewKey = key;
  let body;
  if (ui.soN) body = startView(ui.soN);
  else if (!live) body = startView(1);
  else if (st === 'innings_break') body = startView(live.innings + 1);
  else if (st === 'completed' || st === 'finalized') body = resultView();
  else body = scoringView();
  v.innerHTML = backBar + lockBar() + body;
  autoSheet();
}

function batFor(n) {
  if (n === 1) return info.batting_first_id || (ui.toss && (ui.toss.dec === 'bat' ? ui.toss.win : other(ui.toss.win)));
  if (n === 2) return other(inns[1].batting_team_id);
  if (n % 2 === 0) return other(inns[n - 1].batting_team_id);
  return (Math.floor((n - 1) / 2) % 2 === 1 ? inns[2] : inns[1]).batting_team_id;
}
function startView(n) {
  const so = n > 2 ? Math.floor((n - 1) / 2) : 0;
  const darkChip = (on, label, attrs) => `<button ${attrs} class="min-h-[52px] px-3 rounded-xl font-semibold text-lg border-2 transition active:scale-95 ${on ? 'bg-gold text-black border-gold' : 'bg-ink-700 border-ink-600 text-white'}">${label}</button>`;
  let tossHtml = '';
  if (n === 1 && !info.batting_first_id) {
    if (!ui.toss) ui.toss = { win: info.team_a_id, dec: 'bat' };
    const t = ui.toss;
    tossHtml = `<div class="text-sm text-gray-400 mb-1">Toss won by</div><div class="grid grid-cols-2 gap-2 mb-3">${darkChip(t.win === info.team_a_id, esc(info.team_a_abbr), `data-a="toss-win" data-id="${info.team_a_id}"`)}${darkChip(t.win === info.team_b_id, esc(info.team_b_abbr), `data-a="toss-win" data-id="${info.team_b_id}"`)}</div>
      <div class="text-sm text-gray-400 mb-1">Elected to</div><div class="grid grid-cols-2 gap-2 mb-4">${darkChip(t.dec === 'bat', 'Bat first', 'data-a="toss-dec" data-v="bat"')}${darkChip(t.dec === 'bowl', 'Bowl first', 'data-a="toss-dec" data-v="bowl"')}</div>`;
  }
  const batId = batFor(n), bowlId = other(batId), bp = xiOf(batId), wp = xiOf(bowlId);
  let summary = '';
  if (n % 2 === 0 && inns[n - 1]) { const pr = inns[n - 1]; summary = `<div class="rounded-2xl bg-ink-800 p-4 mb-4"><div class="text-gray-400 text-sm">${so ? 'Super Over' : 'Innings 1'}</div><div class="font-display text-4xl font-bold">${esc(tm(pr.batting_team_id).name)} ${pr.runs}/${pr.wickets} <span class="text-gray-400 text-2xl">(${oversText(pr.balls)})</span></div><div class="mt-1 text-gold font-semibold">Target ${pr.runs + 1} in ${so ? 1 : info.overs} over${so || info.overs === 1 ? '' : 's'}</div></div>`; }
  else if (so) summary = `<div class="rounded-2xl bg-ink-800 p-4 mb-4 text-gold font-semibold">The match is tied. Each side plays one over and has 2 wickets.</div>`;
  if (bp.length < 2 || wp.length < 1) return `<div class="p-6 mt-6 text-center"><div class="font-display text-3xl font-bold mb-2">Add players first</div><p class="text-gray-300">Each team needs at least 2 players (Teams tab).</p></div>`;
  const opts = (arr, sel) => arr.map((p, i) => `<option value="${p.id}" ${i === sel ? 'selected' : ''}>${esc(p.name)}</option>`).join('');
  const cls = 'w-full h-14 rounded-xl bg-ink-700 border-2 border-ink-600 px-3 text-lg font-semibold text-white';
  return `<div id="setup" class="p-4">${summary}
    <div class="flex items-center gap-3 mb-3">${av(tm(batId), 48)}<div><div class="font-display text-4xl font-bold leading-none">${so ? 'Super Over' + (so > 1 ? ' ' + so : '') : 'Start innings ' + n}</div><div class="text-gray-300">${esc(tm(batId).name)} batting, ${so ? 1 : info.overs} over${so || info.overs === 1 ? '' : 's'}</div></div></div>
    ${tossHtml}
    <label class="block text-sm text-gray-400 mb-1">Striker</label><select id="s1" class="${cls} mb-3">${opts(bp, 0)}</select>
    <label class="block text-sm text-gray-400 mb-1">Non-striker</label><select id="s2" class="${cls} mb-3">${opts(bp, 1)}</select>
    <label class="block text-sm text-gray-400 mb-1">${so ? 'Bowler' : 'Opening bowler'} (${esc(tm(bowlId).name)})</label><select id="s3" class="${cls} mb-6">${opts(wp, 0)}</select>
    <button data-a="start" data-n="${n}" class="w-full h-16 rounded-2xl bg-pitch text-black font-display text-3xl font-bold active:scale-95 transition">${so ? 'Start Super Over' : 'Start innings ' + n}</button></div>`;
}

function scoringView() {
  const L = live, maxB = L.max_overs * 6, crr = L.total_balls ? L.live_score / L.total_balls * 6 : 0;
  const bt = tm(L.batting_team_id), wt = tm(L.bowling_team_id);
  let line;
  if (L.target) { const nr = Math.max(0, L.target - L.live_score), left = Math.max(0, maxB - L.total_balls); line = `Need <b class="text-gold">${nr}</b> off <b class="text-gold">${left}</b> balls | RRR ${left ? (nr / left * 6).toFixed(2) : '-'}`; }
  else line = `Run rate ${crr.toFixed(2)} | Projected ${Math.round(crr * L.max_overs)}`;
  const bat = (id, strike) => { const s = sget(id); return `<div class="flex items-center justify-between ${strike ? 'text-white' : 'text-gray-400'}"><span class="font-display text-2xl font-semibold truncate pr-2">${esc(nm(id))}${strike ? ' <span class="text-pitch">*</span>' : ''}</span><span class="font-display text-2xl font-semibold">${s.bat_runs} <span class="text-lg text-gray-400">(${s.bat_balls})</span></span></div>`; };
  const bw = sget(L.active_bowler_id);
  const chipC = t => t === 'W' ? 'bg-ball text-white' : t === '6' ? 'bg-pitch text-black' : t === '4' ? 'bg-gold text-black' : /^(Wd|Nb|P)/.test(t) ? 'bg-sky-500 text-black' : t === '0' ? 'bg-ink-600 text-gray-300' : 'bg-ink-700 text-white';
  const over = (L.this_over || []).map(t => `<span class="shrink-0 min-w-[2.4rem] h-10 px-2 rounded-full flex items-center justify-center font-display text-xl font-bold ${chipC(t)}">${esc(t)}</span>`).join('') || '<span class="text-gray-500 text-sm">New over</span>';
  const run = (v, c) => `<button data-a="run" data-v="${v}" class="h-[72px] rounded-2xl font-display text-4xl font-bold active:scale-95 transition ${c}">${v}</button>`;
  const canUndo = !!lastBall && live.status !== 'finalized';
  return `<div class="mx-3 mt-3 rounded-3xl bg-gradient-to-br from-navy-800 to-navy-950 p-4">
    ${L.so ? '<div class="text-gold font-display text-xl font-bold mb-1">SUPER OVER</div>' : (L.pp && L.total_balls < L.pp * 6 ? '<div class="text-sky-300 font-display text-xl font-bold mb-1">POWERPLAY</div>' : '')}
    <div class="flex items-center justify-between"><div class="flex items-center gap-3">${av(bt, 56)}<div><div class="font-display text-2xl font-bold leading-none">${esc(bt.abbr)}</div><div class="font-display text-[3.4rem] leading-[0.95] font-extrabold">${L.live_score}<span class="text-gray-400 text-4xl">/${L.wickets}</span></div><div class="text-gray-300 text-sm">(${L.overs}.${L.current_ball_count} of ${L.max_overs} overs)</div></div></div>
      <div class="text-right">${av(wt, 44)}<div class="font-display text-xl font-bold mt-1">${esc(wt.abbr)}</div><div class="text-xs text-gray-400">${L.target ? 'Target ' + L.target : 'Bowling'}</div></div></div>
    <div class="mt-3 rounded-xl bg-white/5 text-center py-2 text-sm text-gray-200">${line}</div></div>
  ${L.free_hit_active ? '<div class="mx-4 mt-2 rounded-xl bg-gold text-black text-center font-display text-3xl font-extrabold py-1 animate-glow">FREE HIT</div>' : ''}
  <div class="mx-3 mt-3 rounded-2xl bg-ink-800 p-3 space-y-1">${bat(L.striker_id, true)}${bat(L.non_striker_id, false)}
    <div class="text-right text-sm text-gray-400">${L.p_runs || 0} (${L.p_balls || 0}) partnership</div>
    <div class="border-t border-ink-600 pt-1 mt-1 flex items-center justify-between"><span class="font-display text-xl text-gray-300 truncate pr-2">${esc(nm(L.active_bowler_id))}</span><span class="font-display text-xl text-gray-300">${bw.bowl_wkts}/${bw.bowl_runs} | ${oversText(bw.bowl_balls)} ov</span></div></div>
  <div class="mx-3 mt-3 flex items-center gap-2 overflow-x-auto pb-1"><span class="text-sm text-gray-400 shrink-0">Over ${L.overs + (L.current_ball_count === 0 && L.status === 'need_bowler' ? 0 : 1)}:</span>${over}</div>
  <div class="grid grid-cols-4 gap-2 p-3">
    ${run(0, 'bg-ink-700 text-white')}${run(1, 'bg-ink-700 text-white')}${run(2, 'bg-ink-700 text-white')}${run(3, 'bg-ink-700 text-white')}
    ${run(4, 'bg-gold/15 text-gold border-2 border-gold')}${run(5, 'bg-ink-700 text-white')}${run(6, 'bg-pitch text-black')}
    <button data-a="out" class="h-[72px] rounded-2xl bg-ball text-white font-display text-2xl font-bold active:scale-95 transition">Wicket</button>
    <button data-a="wd" class="h-[72px] rounded-2xl bg-sky-500 text-black font-display text-2xl font-bold active:scale-95 transition">Wide</button>
    <button data-a="nb" class="h-[72px] rounded-2xl bg-sky-500 text-black font-display text-2xl font-bold active:scale-95 transition">No ball</button>
    <button data-a="bye" class="h-[72px] rounded-2xl bg-sky-500 text-black font-display text-2xl font-bold active:scale-95 transition">Bye</button>
    <button data-a="lb" class="h-[72px] rounded-2xl bg-sky-500 text-black font-display text-2xl font-bold active:scale-95 transition">Leg bye</button>
    <button data-a="undo" ${canUndo ? '' : 'disabled'} class="h-14 rounded-2xl border-2 border-white/80 font-display text-2xl font-bold active:scale-95 transition disabled:opacity-30">Undo</button>
    <button data-a="extras" class="h-14 rounded-2xl bg-ink-700 font-display text-2xl font-bold active:scale-95 transition">Extras</button>
    <button data-a="swap" class="h-14 rounded-2xl bg-ink-700 font-display text-2xl font-bold active:scale-95 transition">Swap</button>
    <button data-a="menu" class="h-14 rounded-2xl bg-ink-700 font-display text-2xl font-bold active:scale-95 transition">More</button></div>`;
}

function resultView() {
  const r = resultOf(), fin = live.status === 'finalized', tie = r && r.winner === 'tie';
  const keys = Object.keys(inns).map(Number).sort((a, b) => a - b), lastN = keys.length ? keys[keys.length - 1] : 2;
  const line = n => { const i = inns[n]; return i ? `<div class="flex items-center justify-between font-display text-3xl font-bold"><span class="flex items-center gap-2">${av(tm(i.batting_team_id), 36)}${esc(tm(i.batting_team_id).name)}${n > 2 ? ' <span class="text-sm text-gold">SO</span>' : ''}</span><span>${i.runs}/${i.wickets} <span class="text-gray-400 text-xl">(${oversText(i.balls)})</span></span></div>` : ''; };
  const canUndo = !fin && !!lastBall;
  return `<div class="p-4"><div class="rounded-2xl bg-ink-800 p-5 space-y-3">${keys.map(line).join('')}
    <div class="pt-3 border-t border-ink-600 font-display text-3xl font-extrabold text-gold">${esc(r ? r.text : 'Match complete')}</div></div>
    ${tie && !fin ? `<button data-a="so-start" data-n="${lastN % 2 === 0 ? lastN + 1 : lastN}" class="mt-4 w-full h-14 rounded-2xl bg-sky-500 text-black font-display text-2xl font-bold active:scale-95 transition">Play a Super Over</button>` : ''}
    <button data-a="pom" data-id="${M}" class="mt-4 w-full min-h-[56px] rounded-2xl bg-ink-800 border-2 border-gold/60 px-4 text-left active:scale-95 transition"><span class="block text-xs text-gray-400">Player of the match</span><span class="font-display text-2xl font-bold">${esc(info.pom_name || 'Tap to choose')}</span></button>
    ${fin ? `<div class="mt-5 rounded-2xl bg-pitch/15 text-pitch p-4 text-center font-semibold text-lg">Match finalised. Open the Scorecard from the Matches list, or make pictures in the Table tab.</div>`
      : `<button data-a="finalize" class="mt-5 w-full h-16 rounded-2xl bg-pitch text-black font-display text-3xl font-bold active:scale-95 transition">Finalise and update points table</button>
         <button data-a="undo" ${canUndo ? '' : 'disabled'} class="mt-3 w-full h-14 rounded-2xl border-2 border-white/80 font-display text-2xl font-bold disabled:opacity-30">Undo last ball</button>
         <p class="mt-3 text-sm text-gray-400 text-center">Check the result first. Undo is locked once you finalise.</p>`}</div>`;
}
function resultOf() {
  const a = inns[1], b = inns[2]; if (!a || !b) return null;
  const t1 = a.batting_team_id, t2 = b.batting_team_id;
  const tgt = b.target || (a.runs + 1);
  if (b.runs >= tgt) { const left = Math.max(1, wLimit(t2) - b.wickets); return { winner: t2, text: `${tm(t2).name} won by ${left} wicket${left === 1 ? '' : 's'}` }; }
  if (b.runs < tgt - 1) { const d = tgt - 1 - b.runs; return { winner: t1, text: `${tm(t1).name} won by ${d} run${d === 1 ? '' : 's'}` }; }
  for (let r = 1; inns[2 * r + 1] && inns[2 * r + 2]; r++) {
    const x = inns[2 * r + 1], y = inns[2 * r + 2];
    if (y.runs > x.runs) return { winner: y.batting_team_id, text: `${tm(y.batting_team_id).name} won the Super Over` };
    if (y.runs < x.runs) return { winner: x.batting_team_id, text: `${tm(x.batting_team_id).name} won the Super Over` };
  }
  return { winner: 'tie', text: 'Match tied' };
}

const dchip = (on, label, attrs, extra = '') => `<button ${attrs} class="min-h-[52px] px-4 rounded-xl font-semibold text-lg border-2 transition active:scale-95 disabled:opacity-30 ${on ? 'bg-gold text-black border-gold' : 'bg-ink-700 border-ink-600 text-white'} ${extra}">${label}</button>`;
const dBtn = (a, t, c = 'bg-ink-700', extra = '') => `<button data-a="${a}" ${extra} class="w-full h-14 rounded-xl ${c} font-display text-2xl font-bold active:scale-95 transition">${t}</button>`;
function autoSheet() {
  if (live?.status === 'need_bowler' && ui.sheet !== 'bowler') { ui.sheet = 'bowler'; showDark(bowlerSheet(false), true); }
  else if (live?.status !== 'need_bowler' && ui.sheet === 'bowler') closeSheet();
}
function bowlerSheet(change) {
  const maxO = live.so ? 0 : (+info.max_bowler_overs || 0);
  const all = xiOf(live.bowling_team_id).map(p => { const s = sget(p.id); return { p, s, used: maxO > 0 && s.bowl_balls >= maxO * 6, consec: !change && p.id === live.last_bowler_id }; });
  const strict = all.some(x => !x.used && !x.consec);
  const rows = all.map(({ p, s, used, consec }) => {
    const dis = consec || (strict && used), note = consec ? 'bowled last over' : used ? 'quota used' : '';
    return `<button ${dis ? 'disabled' : ''} data-a="bowler" data-id="${p.id}" class="w-full min-h-[60px] px-4 rounded-xl bg-ink-700 border-2 border-ink-600 flex items-center justify-between active:scale-95 transition disabled:opacity-30"><span class="font-display text-2xl font-semibold">${esc(p.name)}</span><span class="text-right"><span class="font-display text-xl text-gray-300">${oversText(s.bowl_balls)}-${s.maidens}-${s.bowl_runs}-${s.bowl_wkts}</span>${note ? `<span class="block text-xs text-gray-400">${note}</span>` : ''}</span></button>`;
  }).join('');
  return `<div class="font-display text-3xl font-bold mb-3">${change ? 'Change bowler' : `Over ${live.overs} complete. Pick the next bowler`}</div><div class="space-y-2">${rows}</div>
    ${change ? dBtn('close', 'Cancel', 'bg-ink-700 mt-3') : dBtn('undo', 'Undo last ball', 'border-2 border-white/80 mt-3')}`;
}
const availBats = () => xiOf(live.batting_team_id).filter(p => !sget(p.id).out && p.id !== live.striker_id && p.id !== live.non_striker_id);
const WTYPES = ['Bowled', 'Caught', 'LBW', 'Stumped', 'Run Out', 'Hit Wicket', 'Handled Ball', 'Obstructing'];
function wicketSheet() {
  const w = ui.w, fh = live.free_hit_active;
  const ok = t => (fh || w.kind === 'nb') ? ['Run Out', 'Handled Ball', 'Obstructing'].includes(t) : (w.kind === 'wd' ? ['Stumped', 'Run Out', 'Hit Wicket'].includes(t) : true);
  if (w.type && !ok(w.type)) w.type = '';
  const allOut = live.wickets + 1 >= wLimL(live);
  if (w.step === 'f') {
    return `<div class="font-display text-3xl font-bold mb-1">Who took the ${w.type === 'Run Out' ? 'run out' : w.type === 'Stumped' ? 'stumping' : 'catch'}?</div><div class="text-sm text-gray-400 mb-3">Optional. You can skip.</div>
      <div class="space-y-2">${xiOf(live.bowling_team_id).map(p => `<button data-a="w-fld" data-id="${p.id}" class="w-full min-h-[56px] px-4 rounded-xl bg-ink-700 border-2 border-ink-600 text-left font-display text-2xl font-semibold active:scale-95 transition">${esc(p.name)}</button>`).join('')}</div>
      <div class="grid grid-cols-2 gap-2 mt-3"><button data-a="w-back" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Back</button><button data-a="w-fld" data-id="" class="h-14 rounded-xl bg-ink-600 font-display text-2xl font-bold">Skip</button></div>`;
  }
  if (w.step === 2) {
    return `<div class="font-display text-3xl font-bold mb-3">Who is the new batsman?</div>
      <div class="space-y-2">${availBats().map(p => `<button data-a="w-in" data-id="${p.id}" class="w-full min-h-[60px] px-4 rounded-xl bg-ink-700 border-2 border-ink-600 text-left font-display text-2xl font-semibold active:scale-95 transition">${esc(p.name)}</button>`).join('')}</div>
      ${dBtn('w-back', 'Back', 'bg-ink-700 mt-3')}`;
  }
  const needWho = ['Run Out', 'Obstructing'].includes(w.type), ro = w.type === 'Run Out';
  return `<div class="font-display text-3xl font-bold mb-1">Wicket</div>
    ${fh ? '<div class="text-gold font-semibold mb-2">Free hit: only run out, handled ball or obstructing is allowed.</div>' : ''}
    <div class="text-sm text-gray-400 mb-1">How was the batsman out?</div>
    <div class="grid grid-cols-2 gap-2 mb-3">${WTYPES.map(t => dchip(w.type === t, t, `data-a="w-type" data-v="${t}" ${ok(t) ? '' : 'disabled'}`)).join('')}</div>
    <div class="text-sm text-gray-400 mb-1">Delivery</div>
    <div class="grid grid-cols-3 gap-2 mb-3">${dchip(w.kind === 'run', 'Legal', 'data-a="w-kind" data-v="run"')}${dchip(w.kind === 'wd', 'Wide', 'data-a="w-kind" data-v="wd"')}${dchip(w.kind === 'nb', 'No ball', 'data-a="w-kind" data-v="nb"')}</div>
    ${needWho ? `<div class="text-sm text-gray-400 mb-1">Who is out?</div>
      <div class="grid grid-cols-2 gap-2 mb-3">${dchip(w.who === 'striker', esc(nm(live.striker_id)), 'data-a="w-who" data-v="striker"', 'truncate')}${dchip(w.who === 'non', esc(nm(live.non_striker_id)), 'data-a="w-who" data-v="non"', 'truncate')}</div>` : ''}
    ${ro ? `<div class="text-sm text-gray-400 mb-1">Runs completed before the run out</div>
      <div class="grid grid-cols-4 gap-2 mb-3">${[0, 1, 2, 3].map(n => dchip(w.runs === n, n, `data-a="w-runs" data-v="${n}"`)).join('')}</div>` : ''}
    <div class="grid grid-cols-2 gap-2 mt-2"><button data-a="close" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Cancel</button>
      <button data-a="w-next" ${w.type ? '' : 'disabled'} class="h-14 rounded-xl bg-ball text-white font-display text-2xl font-bold disabled:opacity-30">${allOut && !['Caught', 'Stumped', 'Run Out'].includes(w.type) ? 'Confirm, innings ends' : 'Next'}</button></div>`;
}
function retireSheet() {
  const r = ui.rt;
  if (r.step === 2) return `<div class="font-display text-3xl font-bold mb-3">Who comes in?</div>
    <div class="space-y-2">${availBats().map(p => `<button data-a="rt-in" data-id="${p.id}" class="w-full min-h-[60px] px-4 rounded-xl bg-ink-700 border-2 border-ink-600 text-left font-display text-2xl font-semibold active:scale-95 transition">${esc(p.name)}${sget(p.id).rh ? ' <span class="text-sm text-gray-400">(retired hurt, can return)</span>' : ''}</button>`).join('')}</div>${dBtn('rt-back', 'Back', 'bg-ink-700 mt-3')}`;
  return `<div class="font-display text-3xl font-bold mb-3">Retire or timed out</div>
    <div class="grid grid-cols-1 gap-2 mb-3">${['Retired Hurt', 'Retired Out', 'Timed Out'].map(t => dchip(r.type === t, t, `data-a="rt-type" data-v="${t}"`)).join('')}</div>
    <div class="text-sm text-gray-400 mb-1">Which batsman?</div>
    <div class="grid grid-cols-2 gap-2 mb-4">${dchip(r.who === 'striker', esc(nm(live.striker_id)), 'data-a="rt-who" data-v="striker"', 'truncate')}${dchip(r.who === 'non', esc(nm(live.non_striker_id)), 'data-a="rt-who" data-v="non"', 'truncate')}</div>
    <p class="text-xs text-gray-400 mb-3">Retired hurt is not a wicket. Retired out and timed out count as a wicket but not for the bowler.</p>
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Cancel</button><button data-a="rt-next" class="h-14 rounded-xl bg-ball text-white font-display text-2xl font-bold">Next</button></div>`;
}
function exPreview(e) {
  const WD = live.wd_runs || 1, NB = live.nb_runs || 1, n = e.n || 0;
  if (e.kind === 'wd') return `Wide ${WD} + ${n} run${n === 1 ? '' : 's'} = ${WD + n} runs`;
  if (e.kind === 'nb') return `No ball ${NB} + ${n} off the bat = ${NB + n} runs${live.fh === 0 ? '' : '. Next ball is a FREE HIT'}`;
  if (e.kind === 'bye') return `${n} bye${n === 1 ? '' : 's'} = ${n} run${n === 1 ? '' : 's'} (not the batsman's)`;
  if (e.kind === 'lb') return `${n} leg bye${n === 1 ? '' : 's'} = ${n} run${n === 1 ? '' : 's'} (not the batsman's)`;
  return `${n} penalty runs`;
}
function extrasSheet() {
  const e = ui.ex, lbl = { wd: 'Extra runs run besides the wide', nb: 'Runs off the bat', bye: 'Byes run', lb: 'Leg byes run', pen: 'Penalty runs given to the batting team' }[e.kind], min = (e.kind === 'bye' || e.kind === 'lb' || e.kind === 'pen') ? 1 : 0;
  return `<div class="font-display text-3xl font-bold mb-3">Extras</div>
    <div class="grid grid-cols-3 gap-2 mb-3">${dchip(e.kind === 'wd', 'Wide', 'data-a="ex-kind" data-v="wd"')}${dchip(e.kind === 'nb', 'No ball', 'data-a="ex-kind" data-v="nb"')}${dchip(e.kind === 'bye', 'Bye', 'data-a="ex-kind" data-v="bye"')}${dchip(e.kind === 'lb', 'Leg bye', 'data-a="ex-kind" data-v="lb"')}${dchip(e.kind === 'pen', 'Penalty', 'data-a="ex-kind" data-v="pen"')}</div>
    <div class="text-sm text-gray-400 mb-1">${lbl}</div>
    <div class="grid grid-cols-4 gap-2 mb-4">${[0, 1, 2, 3, 4, 5, 6].map(n => dchip(e.n === n, n, `data-a="ex-n" data-v="${n}" ${n < min ? 'disabled' : ''}`)).join('')}</div>
    <div class="rounded-xl bg-gold/15 border-2 border-gold text-gold font-display text-2xl font-bold p-3 mb-3">${exPreview(e)}</div>
    <div class="grid grid-cols-2 gap-2"><button data-a="close" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Cancel</button><button data-a="ex-ok" class="h-14 rounded-xl bg-pitch text-black font-display text-2xl font-bold">Add</button></div>`;
}
function menuSheet() {
  return `<div class="font-display text-3xl font-bold mb-3">More</div><div class="space-y-2">${dBtn('gfx-sheet-score', 'Live graphics')}${dBtn('fix-open', 'Fix an earlier ball')}${dBtn('rv-open', 'Revise overs / target (rain)')}${dBtn('swap', 'Swap batsmen at the crease')}${dBtn('rt-open', 'Retired hurt / timed out')}${dBtn('add-bat', 'Add player to batting team')}${dBtn('add-bowl', 'Add player to bowling team')}${live.current_ball_count === 0 ? dBtn('chg-bowler', 'Change bowler') : ''}${dBtn('end-inn', 'End innings now', 'bg-ball/90')}${dBtn('toggle-lt', isLight() ? 'Night screen (dark)' : 'Day screen (white)', 'bg-ink-600')}${dBtn('close', 'Close', 'bg-ink-600')}</div>`;
}
const KIND_LBL = { run: 'Runs', bye: 'Bye', lb: 'Leg bye', wd: 'Wide', nb: 'No ball' };
function fixListSheet() {
  const items = ui.fix.log.slice().reverse().slice(0, 60);
  return `<div class="font-display text-3xl font-bold mb-1">Fix an earlier ball</div><div class="text-sm text-gray-400 mb-3">Tap the ball to change. Score, batsman, bowler and extras update by themselves.</div>
    <div class="space-y-2">${items.map(x => `<button data-a="fix-pick" data-key="${x.key}" class="w-full px-3 py-2 rounded-xl bg-ink-700 border-2 border-ink-600 flex items-center gap-3 text-left active:scale-95 transition"><span class="font-display text-xl text-gray-400 w-12">${x.label}</span><span class="flex-1 min-w-0"><span class="block font-semibold truncate">${esc(x.text)}</span><span class="block text-xs text-gray-400 truncate">${esc(x.bowler)} to ${esc(x.striker)}</span></span><span class="font-display text-2xl font-bold">${esc(x.tag)}</span></button>`).join('') || '<p class="text-gray-400">No balls yet.</p>'}</div>
    ${dBtn('close', 'Close', 'bg-ink-700 mt-3')}`;
}
function fixEditSheet() {
  const f = ui.fixEdit, group = ['run', 'bye', 'lb'].includes(f.k0) ? ['run', 'bye', 'lb'] : ['wd', 'nb'];
  const min = (f.k === 'bye' || f.k === 'lb') ? 1 : 0;
  return `<div class="font-display text-3xl font-bold mb-3">Change ball ${esc(f.label)}</div>
    <div class="grid grid-cols-${group.length} gap-2 mb-3">${group.map(k => dchip(f.k === k, KIND_LBL[k], `data-a="fix-kind" data-v="${k}"`)).join('')}</div>
    <div class="text-sm text-gray-400 mb-1">${f.k === 'run' || f.k === 'nb' ? 'Runs off the bat' : f.k === 'wd' ? 'Extra runs run besides the wide' : 'Runs run'}</div>
    <div class="grid grid-cols-4 gap-2 mb-4">${[0, 1, 2, 3, 4, 5, 6].map(n => dchip(f.n === n, n, `data-a="fix-n" data-v="${n}" ${n < min ? 'disabled' : ''}`)).join('')}</div>
    ${f.hasWicket ? '<p class="text-xs text-gray-400 mb-3">This ball has a wicket. The wicket stays as it is; only the runs change.</p>' : ''}
    <div class="grid grid-cols-2 gap-2"><button data-a="fix-list" class="h-14 rounded-xl bg-ink-700 font-display text-2xl font-bold">Back</button><button data-a="fix-save" class="h-14 rounded-xl bg-pitch text-black font-display text-2xl font-bold">Save</button></div>`;
}

/* ENGINE START */
const BAT_F = ['bat_runs', 'bat_balls', 'fours', 'sixes', 'out', 'dismissal', 'dismissed_by', 'fielder', 'bo', 'rh'];
const BOWL_F = ['bowl_balls', 'bowl_runs', 'bowl_wkts', 'maidens'];
const BOWLER_CREDIT = ['Bowled', 'Caught', 'LBW', 'Stumped', 'Hit Wicket'];
const sfxOf = so => so ? '~s' + so : '';
const wLimL = L => Math.max(1, Math.min(xiOf(L.batting_team_id).length - 1, L.max_wk || +info?.max_wickets || 99));

function buildDisplay(L, S) {
  const sx = sfxOf(L.so), g = id => ({ ...blank(), ...(S[id + sx] || {}) }), a = g(L.striker_id), b = g(L.non_striker_id), c = g(L.active_bowler_id);
  return {
    striker: { name: dn(L.striker_id), runs: a.bat_runs, balls: a.bat_balls, fours: a.fours, sixes: a.sixes },
    non_striker: { name: dn(L.non_striker_id), runs: b.bat_runs, balls: b.bat_balls, fours: b.fours, sixes: b.sixes },
    bowler: { name: dn(L.active_bowler_id), balls: c.bowl_balls, runs: c.bowl_runs, wkts: c.bowl_wkts, maidens: c.maidens }
  };
}
function initLive(cfg) {
  const bt = tm(cfg.batId), wt = tm(cfg.bowlId);
  return {
    innings: cfg.n, status: 'live', batting_team_id: cfg.batId, bowling_team_id: cfg.bowlId,
    batting_abbr: bt.abbr, bowling_abbr: wt.abbr, batting_color: bt.color, bowling_color: wt.color,
    live_score: 0, wickets: 0, overs: 0, current_ball_count: 0, total_balls: 0, max_overs: cfg.maxOvers, max_wk: cfg.maxWk || 0, so: cfg.so || 0, wd_runs: cfg.wdRuns || 1, nb_runs: cfg.nbRuns || 1, fh: cfg.fh === 0 ? 0 : 1, pp: cfg.pp || 0,
    target: cfg.target || null, striker_id: cfg.s1, non_striker_id: cfg.s2, active_bowler_id: cfg.s3, last_bowler_id: '',
    free_hit_active: false, over_runs: 0, ov_runs: 0, ov_wk: 0, bat_n: 2, p_runs: 0, p_balls: 0, seq: 0, this_over: [], event: { n: cfg.eventN || 0, type: null }
  };
}
function finishInnings(L, allOut) {
  L.status = L.innings % 2 === 1 ? 'innings_break' : 'completed'; L.free_hit_active = false;
  return { batting_team_id: L.batting_team_id, runs: L.live_score, wickets: L.wickets, balls: L.total_balls, all_out: !!allOut, target: L.target || null, mo: L.max_overs };
}
function applyBall(L0, S0, e) {
  const L = clone(L0), kind = e.k, bat = e.bat || 0, ran = e.ran || 0, w = e.w || null, sx = sfxOf(L.so);
  const sk = id => id + sx, sg = id => ({ ...blank(), ...(S0[sk(id)] || {}) });
  const strikerId = L.striker_id, bowlerId = L.active_bowler_id;
  const WD = L.wd_runs || 1, NB = L.nb_runs || 1;
  let teamRuns, bowlerRuns, faced, legal, runsRun;
  if (kind === 'run') { teamRuns = bat; bowlerRuns = bat; faced = 1; legal = 1; runsRun = bat; }
  else if (kind === 'wd') { teamRuns = WD + ran; bowlerRuns = WD + ran; faced = 0; legal = 0; runsRun = ran; }
  else if (kind === 'nb') { teamRuns = NB + bat; bowlerRuns = NB + bat; faced = 1; legal = 0; runsRun = bat; }
  else if (kind === 'pen') { teamRuns = ran; bowlerRuns = 0; faced = 0; legal = 0; runsRun = 0; }
  else { teamRuns = ran; bowlerRuns = 0; faced = 1; legal = 1; runsRun = ran; }
  const batRuns = (kind === 'run' || kind === 'nb') ? bat : 0, isFour = batRuns === 4, isSix = batRuns === 6;

  const ss = sg(strikerId), bs = sg(bowlerId), changes = {};
  ss.bat_runs += batRuns; ss.bat_balls += faced;
  if (isFour) ss.fours++; if (isSix) ss.sixes++;
  bs.bowl_runs += bowlerRuns; bs.bowl_balls += legal;
  changes[sk(strikerId)] = ss; changes[sk(bowlerId)] = bs;

  let tag;
  if (w) tag = 'W'; else if (kind === 'wd') tag = ran ? `Wd+${ran}` : 'Wd'; else if (kind === 'nb') tag = bat ? `Nb+${bat}` : 'Nb';
  else if (kind === 'bye') tag = `B${ran}`; else if (kind === 'lb') tag = `Lb${ran}`; else if (kind === 'pen') tag = `P${ran}`; else tag = String(bat);

  let striker = L.striker_id, non = L.non_striker_id, bowlerWicket = 0, outId = null;
  if (w) {
    outId = w.out_id || (w.who === 'non' ? L.non_striker_id : L.striker_id);
    const os = outId === strikerId ? ss : sg(outId);
    os.out = true; os.dismissal = w.type; if (w.fld) os.fielder = nm(w.fld);
    if (BOWLER_CREDIT.includes(w.type)) { bs.bowl_wkts++; bowlerWicket = 1; os.dismissed_by = nm(bowlerId); }
    changes[sk(outId)] = os;
    if (w.in_id) {
      if (outId === striker) striker = w.in_id; else non = w.in_id;
      const ins = sg(w.in_id); if (!ins.bo) { L.bat_n = (L.bat_n || 2) + 1; ins.bo = L.bat_n; } ins.rh = false; changes[sk(w.in_id)] = ins;
    }
  }
  if (runsRun % 2 === 1) [striker, non] = [non, striker];

  const newBalls = L.total_balls + legal, overComplete = legal === 1 && newBalls % 6 === 0;
  let overRuns = (L.over_runs || 0) + bowlerRuns, maiden = 0;
  L.ov_runs = (L.ov_runs || 0) + teamRuns; if (w) L.ov_wk = (L.ov_wk || 0) + 1;
  L.this_over = [...(L.this_over || []), tag];
  if (overComplete) {
    if (overRuns === 0) { bs.maidens++; maiden = 1; }
    overRuns = 0; [striker, non] = [non, striker];
    L.last_over = { n: Math.floor(newBalls / 6), bw: nm(bowlerId), runs: L.ov_runs, wk: L.ov_wk || 0, tags: L.this_over };
    L.ov_runs = 0; L.ov_wk = 0;
  }
  L.live_score += teamRuns; L.wickets += w ? 1 : 0; L.total_balls = newBalls;
  L.overs = Math.floor(newBalls / 6); L.current_ball_count = newBalls % 6;
  L.striker_id = striker; L.non_striker_id = non; L.over_runs = overRuns;
  L.free_hit_active = L.fh !== 0 && (kind === 'nb' || (!!L.free_hit_active && kind === 'wd'));
  L.p_runs = (L.p_runs || 0) + teamRuns; L.p_balls = (L.p_balls || 0) + legal;
  L.last_12_balls_array = [...(L.last_12_balls_array || []), tag].slice(-12);
  L.event = { n: (L.event?.n || 0) + 1, type: w ? 'WICKET' : isSix ? 'SIX' : isFour ? 'FOUR' : kind === 'nb' ? 'NO BALL' : null };

  let fow = null;
  if (w) { fow = { key: `${L.innings}/${L.wickets}`, val: { runs: L.live_score, ball: oversText(newBalls), out: outId } }; L.p_runs = 0; L.p_balls = 0; }

  const allOut = L.wickets >= wLimL(L);
  const finished = allOut || L.total_balls >= L.max_overs * 6 || (!!L.target && L.live_score >= L.target);
  let inningsRec = null;
  if (finished) inningsRec = finishInnings(L, allOut);
  else if (overComplete) { L.status = 'need_bowler'; L.last_bowler_id = bowlerId; }
  L.display = buildDisplay(L, { ...S0, ...changes });

  const D = {}, add = (p, v) => { if (v) D[p] = (D[p] || 0) + v; }, lb = (id, f, v) => add(`leaderboards/${id}/${f}`, v);
  if (!L.so) {
    lb(strikerId, 'total_runs', batRuns); lb(strikerId, 'total_balls_faced', faced);
    lb(strikerId, 'total_fours', isFour ? 1 : 0); lb(strikerId, 'total_sixes', isSix ? 1 : 0); lb(strikerId, 'total_boundaries', (isFour || isSix) ? 1 : 0);
    lb(bowlerId, 'total_runs_conceded', bowlerRuns); lb(bowlerId, 'total_balls_bowled', legal); lb(bowlerId, 'total_wickets', bowlerWicket); lb(bowlerId, 'total_maidens', maiden);
    add('meta/total_fours', isFour ? 1 : 0); add('meta/total_sixes', isSix ? 1 : 0); add('meta/total_wickets', w ? 1 : 0);
  }
  const ex = {};
  if (kind === 'wd') ex.wd = WD + ran; else if (kind === 'nb') ex.nb = NB; else if (kind === 'bye' && ran) ex.b = ran; else if (kind === 'lb' && ran) ex.lb = ran; else if (kind === 'pen' && ran) ex.pen = ran;
  return { L, changes, D, ex, fow, inningsRec };
}
/* Entry types: b = ball, bw = bowler chosen, sw = swap strike, en = end innings, rt = retire / timed out */
function applyEntry(L0, S0, e) {
  if (e.t === 'b') {
    if (L0.status !== 'live') return { L: L0, changes: {}, D: {}, ex: {}, fow: null, inningsRec: null, skipped: true };
    return applyBall(L0, S0, e);
  }
  const L = clone(L0), changes = {}, D = {}, sx = sfxOf(L.so), sk = id => id + sx, sg = id => ({ ...blank(), ...(S0[sk(id)] || {}) });
  let fow = null, inningsRec = null;
  if (e.t === 'bw') {
    L.active_bowler_id = e.id;
    if (L.status === 'need_bowler') { L.status = 'live'; L.over_runs = 0; L.this_over = []; }
    if (!S0[sk(e.id)]) changes[sk(e.id)] = blank();
  } else if (e.t === 'sw') {
    [L.striker_id, L.non_striker_id] = [L.non_striker_id, L.striker_id];
  } else if (e.t === 'en') {
    inningsRec = finishInnings(L, L.wickets >= wLimL(L));
  } else if (e.t === 'rv') {
    if (e.overs) L.max_overs = e.overs;
    if (e.target) L.target = e.target;
    if ((L.status === 'live' || L.status === 'need_bowler') && (L.total_balls >= L.max_overs * 6 || (L.target && L.live_score >= L.target))) inningsRec = finishInnings(L, false);
  } else if (e.t === 'rt') {
    const outId = e.who === 'non' ? L.non_striker_id : L.striker_id, real = e.type !== 'Retired Hurt', os = sg(outId);
    if (real) { os.out = true; os.dismissal = e.type; os.rh = false; } else os.rh = true;
    changes[sk(outId)] = os;
    if (e.in_id) {
      if (outId === L.striker_id) L.striker_id = e.in_id; else L.non_striker_id = e.in_id;
      const ins = sg(e.in_id); if (!ins.bo) { L.bat_n = (L.bat_n || 2) + 1; ins.bo = L.bat_n; } ins.rh = false; changes[sk(e.in_id)] = ins;
    }
    L.p_runs = 0; L.p_balls = 0;
    if (real) {
      L.wickets++; fow = { key: `${L.innings}/${L.wickets}`, val: { runs: L.live_score, ball: oversText(L.total_balls), out: outId } };

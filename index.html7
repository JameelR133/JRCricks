}
/* what each player's innings numbers add to the tournament totals, as a difference */
function contribDiff(oldS, W, cfg, oldWk, newWk) {
  const D = {}, add = (p, v) => { if (v) D[p] = (D[p] || 0) + v; };
  if (cfg.so) return D;
  let dF = 0, dS = 0;
  Object.keys(W).forEach(k => {
    const pl = players[k]; if (!pl) return;
    const o = oldS[k] || {}, w = W[k], lb = (f, v) => add(`leaderboards/${k}/${f}`, v);
    if (pl.team_id === cfg.batId) {
      const df = (w.fours || 0) - (o.fours || 0), ds = (w.sixes || 0) - (o.sixes || 0);
      lb('total_runs', (w.bat_runs || 0) - (o.bat_runs || 0)); lb('total_balls_faced', (w.bat_balls || 0) - (o.bat_balls || 0));
      lb('total_fours', df); lb('total_sixes', ds); lb('total_boundaries', df + ds); dF += df; dS += ds;
    } else {
      lb('total_runs_conceded', (w.bowl_runs || 0) - (o.bowl_runs || 0)); lb('total_balls_bowled', (w.bowl_balls || 0) - (o.bowl_balls || 0));
      lb('total_wickets', (w.bowl_wkts || 0) - (o.bowl_wkts || 0)); lb('total_maidens', (w.maidens || 0) - (o.maidens || 0));
    }
  });
  add('meta/total_fours', dF); add('meta/total_sixes', dS); add('meta/total_wickets', newWk - oldWk);
  return D;
}
/* ENGINE END */

function commitEntry(e) {
  if (!live || !oneScorerOk()) return;
  if (e.t === 'b' && live.status !== 'live') return;
  const r = applyEntry(live, stats, e); if (r.skipped) return;
  const L = r.L, seq = (live.seq || 0) + 1; L.seq = seq;
  const opId = rid(), key = pad(seq), up = {};
  putLive(up, clone(L));
  Object.entries(r.changes).forEach(([k, v]) => { up[`${MP()}/stats/${k}`] = clone(v); });
  if (r.inningsRec) up[`${MP()}/innings/${L.innings}`] = r.inningsRec;
  if (r.fow) up[`${MP()}/fow/${r.fow.key}`] = r.fow.val;
  for (const f in r.ex) up[`${MP()}/extras/${L.innings}/${f}`] = { __inc: r.ex[f] };
  for (const k in r.D) up[`tournaments/${T}/${k}`] = { __inc: r.D[k] };
  up[`${MP()}/ledger/${L.innings}/${key}`] = clone({ ...e, id: opId, ts: Date.now() });
  send(up, { t: T, m: M, n: L.innings, key, opId });
}
function runBall(inp) {
  if (!live || live.status !== 'live') return;
  const now = Date.now(); if (now - lastTap < 140) return; lastTap = now;
  navigator.vibrate?.(inp.w ? 40 : 15);
  commitEntry({ t: 'b', k: inp.k, bat: inp.bat || 0, ran: inp.ran || 0, w: inp.w || null });
}
async function getLedger(n) {
  const o = (await get(ref(db, `${MP()}/ledger/${n}`))).val() || {};
  return Object.keys(o).sort().map(k => ({ ...o[k], key: k }));
}
async function rebuildInnings(n, ents, mod) {
  const cfg = (await get(ref(db, `${MP()}/start/${n}`))).val();
  if (!cfg) throw new Error('This innings was scored before this update, so it cannot be changed.');
  const rp = replayInnings(cfg, ents), L = rp.L, sx = sfxOf(cfg.so), up = {}, merged = {};
  L.seq = ents.length ? parseInt(ents[ents.length - 1].key, 10) : 0;
  Object.keys(rp.W).forEach(k => {
    const rid0 = sx ? k.slice(0, -sx.length) : k, pl = players[rid0]; if (!pl) return;
    const fields = pl.team_id === cfg.batId ? BAT_F : BOWL_F, res = { ...blank(), ...(stats[k] || {}) };
    fields.forEach(f => { res[f] = rp.W[k][f]; });
    merged[k] = res; up[`${MP()}/stats/${k}`] = clone(res);
  });
  const dd = contribDiff(stats, merged, cfg, live.innings === n ? live.wickets : 0, L.wickets);
  for (const k in dd) up[`tournaments/${T}/${k}`] = { __inc: dd[k] };
  putLive(up, clone(L));
  up[`${MP()}/innings/${n}`] = rp.inningsRec || null;
  up[`${MP()}/extras/${n}`] = Object.keys(rp.ex).length ? rp.ex : null;
  up[`${MP()}/fow/${n}`] = Object.keys(rp.fow).length ? rp.fow : null;
  if (mod.del) up[`${MP()}/ledger/${n}/${mod.del}`] = null;
  if (mod.set) { const { key, ...rest } = mod.set.entry; up[`${MP()}/ledger/${n}/${mod.set.key}`] = clone(rest); }
  await update(ref(db), decodeUp(up));
}
async function undoLast() {
  if (!live || !oneScorerOk()) return;
  if (live.status === 'finalized') return toast('The match is finalised', true);
  try {
    const n = live.innings, ents = await getLedger(n);
    if (!ents.length) return toast('Nothing to undo', true);
    await rebuildInnings(n, ents.slice(0, -1), { del: ents[ents.length - 1].key });
    navigator.vibrate?.(25); toast('Last ball undone');
  } catch (e) { fail(e); }
}
async function openFix() {
  if (!live || !oneScorerOk()) return;
  try {
    const n = live.innings, cfg = (await get(ref(db, `${MP()}/start/${n}`))).val();
    if (!cfg) return toast('This innings was scored before the update, so it cannot be fixed.', true);
    const ents = await getLedger(n), rp = replayInnings(cfg, ents);
    ui.fix = { n, ents, log: rp.log }; ui.sheet = 'fix'; showDark(fixListSheet());
  } catch (e) { fail(e); }
}
async function saveFix() {
  const f = ui.fixEdit, { n, ents } = ui.fix, i = ents.findIndex(x => x.key === f.key);
  if (i < 0) return;
  const old = ents[i], ne = { ...old, k: f.k, bat: (f.k === 'run' || f.k === 'nb') ? f.n : 0, ran: (f.k === 'run' || f.k === 'nb') ? 0 : f.n };
  const legal = ['run', 'bye', 'lb'];
  if (legal.includes(old.k) !== legal.includes(ne.k)) return toast('You can switch between runs, bye and leg bye, or between wide and no ball. For other changes use Undo.', true);
  try {
    const list = ents.slice(); list[i] = ne;
    await rebuildInnings(n, list, { set: { key: f.key, entry: ne } });
    closeSheet(); toast('Ball corrected');
  } catch (e) { fail(e); }
}
function doWicket(inId) {
  const w = ui.w, ro = w.type === 'Run Out', k = w.kind, runs = ro ? w.runs : 0;
  closeSheet();
  runBall({ k, bat: (k === 'run' || k === 'nb') ? runs : 0, ran: k === 'wd' ? runs : 0, w: { type: w.type, who: (['Run Out', 'Obstructing'].includes(w.type) && w.who === 'non') ? 'non' : 'striker', in_id: inId || null, fld: w.fld || null } });
}
function doRetire(inId) {
  const r = ui.rt; closeSheet();
  commitEntry({ t: 'rt', type: r.type, who: r.who, in_id: inId || null });
}
function endInnings() {
  if (!confirm('End this innings now?')) return;
  commitEntry({ t: 'en' });
}
function startInnings(n) {
  if (!oneScorerOk()) return;
  const s1 = $('#s1').value, s2 = $('#s2').value, s3 = $('#s3').value;
  if (s1 === s2) return toast('Striker and non-striker must be different', true);
  const up = {}; let batId;
  if (n === 1) {
    if (info.batting_first_id) batId = info.batting_first_id;
    else { const t = ui.toss || { win: info.team_a_id, dec: 'bat' }; batId = t.dec === 'bat' ? t.win : other(t.win); putInfo(up, M, 'toss_winner_id', t.win); putInfo(up, M, 'toss_decision', t.dec); putInfo(up, M, 'batting_first_id', batId); }
  } else batId = batFor(n);
  const so = n > 2 ? Math.floor((n - 1) / 2) : 0, sx = sfxOf(so);
  const cfg = { n, batId, bowlId: other(batId), s1, s2, s3, target: n % 2 === 0 ? inns[n - 1].runs + 1 : null, maxOvers: so ? 1 : +info.overs, maxWk: so ? 2 : 0, so, eventN: live?.event?.n || 0, wdRuns: info.wd_runs || 1, nbRuns: info.nb_runs || 1, fh: info.fh === 0 ? 0 : 1, pp: so ? 0 : (+info.pp || 0) };
  const L = initLive(cfg);
  const st1 = { ...(stats[s1 + sx] || blank()), bo: 1 }, st2 = { ...(stats[s2 + sx] || blank()), bo: 2 }, st3 = stats[s3 + sx] || blank();
  L.display = buildDisplay(L, { ...stats, [s1 + sx]: st1, [s2 + sx]: st2, [s3 + sx]: st3 });
  putLive(up, clone(L)); up[`${MP()}/start/${n}`] = clone(cfg); putInfo(up, M, 'status', 'live');
  up[`${MP()}/stats/${s1 + sx}`] = clone(st1); up[`${MP()}/stats/${s2 + sx}`] = clone(st2); if (!stats[s3 + sx]) up[`${MP()}/stats/${s3 + sx}`] = blank();
  ui.viewKey = ''; ui.soN = 0;
  update(ref(db), up).catch(e => toast('Could not start: ' + (e.code || e.message), true));
}
async function finalize() {
  if (!oneScorerOk()) return;
  const r = resultOf(), a = inns[1], b = inns[2];
  if (!r || !confirm('Finalise this match? Undo will be locked and the points table will be updated.')) return;
  const lock = await runTransaction(ref(db, `${IP()}/finalized`), cur => cur ? undefined : true);
  if (!lock.committed) return toast('This match was already finalised');
  const unlock = () => runTransaction(ref(db, `${IP()}/finalized`), () => null).catch(() => {});
  try {
  const winPts = +(meta.points_win ?? 2), tiePts = +(meta.points_tie ?? 1), maxB = info.overs * 6, adj = i => i.all_out ? (i.mo || info.overs) * 6 : i.balls, up = {}, fin = {};
  if ((info.stage || 'Group') === 'Group') {
    for (const [own, opp] of [[a, b], [b, a]]) {
      const id = own.batting_team_id, t = tm(id);
      const row = { team_name: t.name, team_abbr: t.abbr, group: meta.teams?.[id]?.group || 'A', matches_played: 0, wins: 0, losses: 0, ties: 0, points: 0, total_runs_scored: 0, total_balls_faced: 0, total_runs_conceded: 0, total_balls_bowled: 0, ...((await get(ref(db, `tournaments/${T}/points_table/${id}`))).val() || {}) };
      row.matches_played++;
      if (r.winner === 'tie') { row.ties++; row.points += tiePts; } else if (r.winner === id) { row.wins++; row.points += winPts; } else row.losses++;
      row.total_runs_scored += own.runs; row.total_balls_faced += adj(own); row.total_runs_conceded += opp.runs; row.total_balls_bowled += adj(opp);
      row.total_overs_faced = +(row.total_balls_faced / 6).toFixed(3); row.total_overs_bowled = +(row.total_balls_bowled / 6).toFixed(3);
      row.net_run_rate = +nrrOf(row).toFixed(3);
      up[`tournaments/${T}/points_table/${id}`] = row;
      fin[id] = { p: 1, w: r.winner === id ? 1 : 0, l: (r.winner !== 'tie' && r.winner !== id) ? 1 : 0, t: r.winner === 'tie' ? 1 : 0, pts: r.winner === 'tie' ? tiePts : r.winner === id ? winPts : 0, rs: own.runs, bf: adj(own), rc: opp.runs, bb: adj(opp) };
    }
  }
  up[`${IP()}/fin`] = fin;
  const sc = i => `${i.runs}-${i.wickets} (${oversText(i.balls)})`;
  [a, b].forEach(i => putInfo(up, M, i.batting_team_id === info.team_a_id ? 'score_a' : 'score_b', sc(i)));
  putInfo(up, M, 'status', 'completed'); putInfo(up, M, 'result', r.text); putInfo(up, M, 'winner_id', r.winner);
  up[`${MP()}/live/status`] = 'finalized'; if (info.token) up[`overlay/${info.token}/live/status`] = 'finalized';
  if (!info.pom_id) { const top = rankPom(stats, r.winner)[0]; if (top) { putInfo(up, M, 'pom_id', top.id); putInfo(up, M, 'pom_name', top.name); putInfo(up, M, 'pom_line', top.line); } }
  update(ref(db), up).then(() => toast('Match finalised')).catch(e => { unlock(); toast('Finalise failed: ' + (e.code || e.message), true); });
  } catch (e) { unlock(); toast('Finalise failed: ' + (e.code || e.message), true); }
}

/* ---------- player of the match ---------- */
function pomPoints(v, won) {
  let p = 0;
  if (v.bat_balls > 0) {
    const r = v.bat_runs || 0, sr = r / v.bat_balls * 100;
    p += r; if (r >= 100) p += 40; else if (r >= 50) p += 20; else if (r >= 30) p += 10;
    if (v.bat_balls >= 6) { if (sr >= 150) p += 10; else if (sr >= 120) p += 5; else if (sr < 80 && v.bat_balls >= 10) p -= 5; }
  }
  if (v.bowl_balls > 0) {
    const w = v.bowl_wkts || 0, eco = (v.bowl_runs || 0) / (v.bowl_balls / 6);
    p += w * 20; if (w >= 5) p += 25; else if (w >= 3) p += 10;
    p += (v.maidens || 0) * 8;
    if (v.bowl_balls >= 6) { if (eco <= 6) p += 15; else if (eco <= 8) p += 8; else if (eco <= 10) p += 3; else if (eco >= 14) p -= 5; }
  }
  if (won) p += 10;
  return Math.round(p);
}
const pomLine = v => [v.bat_balls > 0 ? `${v.bat_runs} (${v.bat_balls})` : '', v.bowl_balls > 0 ? `${v.bowl_wkts}/${v.bowl_runs}` : ''].filter(Boolean).join(' and ');
function rankPom(st, winner) {
  return Object.entries(st).filter(([id, v]) => players[id] && (v.bat_balls > 0 || v.bowl_balls > 0))
    .map(([id, v]) => ({ id, name: players[id].name, team: players[id].team_name, line: pomLine(v), pts: pomPoints(v, players[id].team_id === winner) }))
    .sort((a, b) => b.pts - a.pts);
}
async function openPom(mid) {
  try {
    const st = (await get(ref(db, `tournaments/${T}/matches/${mid}/stats`))).val() || {};
    const winner = (M === mid && inns[1] && inns[2]) ? resultOf()?.winner : matches[mid]?.winner_id;
    const rows = rankPom(st, winner);
    if (!rows.length) return toast('No player stats yet', true);
    ui.pom = { mid, rows }; ui.sheet = 'pom';
    const dark = screen === 'score', bg = dark ? 'bg-ink-700 border-ink-600' : 'bg-slate-50 border-slate-200', sub = dark ? 'text-gray-400' : 'text-slate-500';
    showSheet(`<div class="font-display text-3xl font-bold mb-1">Player of the match</div><div class="text-sm ${sub} mb-3">The app ranks players by points. You can pick anyone.</div>
      <div class="space-y-2">${rows.map((r, i) => `<button data-a="pom-pick" data-i="${i}" class="w-full min-h-[60px] px-4 rounded-xl ${bg} border-2 ${i === 0 ? '!border-amber-400' : ''} flex items-center justify-between active:scale-95 transition"><span class="text-left"><span class="font-display text-2xl font-semibold block">${esc(r.name)}</span><span class="text-xs ${sub}">${esc(r.team)}${i === 0 ? ', suggested' : ''}</span></span><span class="text-right"><span class="font-display text-xl block">${esc(r.line)}</span><span class="text-xs text-amber-500">${r.pts} pts</span></span></button>`).join('')}</div>
      <button data-a="close" class="mt-3 w-full h-14 rounded-xl ${dark ? 'bg-ink-700' : 'bg-slate-100'} font-display text-2xl font-bold">Cancel</button>`, false, dark);
  } catch (e) { fail(e); }
}
function savePom(i) {
  const { mid, rows } = ui.pom, r = rows[i], up = {};
  closeSheet();
  putInfo(up, mid, 'pom_id', r.id); putInfo(up, mid, 'pom_name', r.name); putInfo(up, mid, 'pom_line', r.line);
  update(ref(db), up).then(() => toast('Player of the match saved')).catch(fail);
}

/* ---------- share pictures ---------- */
const loadImg = src => new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src; });
async function makeCard(kind, arg) {
  await Promise.all([document.fonts.load('800 40px "Barlow Condensed"'), document.fonts.load('600 30px "Barlow Condensed"'), document.fonts.load('600 30px "Barlow"')]);
  const W = 1080, H = 1350, c = document.createElement('canvas'); c.width = W; c.height = H;
  const g = c.getContext('2d');
  const txt = (s, x, y, font, color, align = 'left', maxW) => {
    g.font = font; g.fillStyle = color; g.textAlign = align; s = String(s ?? '');
    if (maxW) while (s.length > 1 && g.measureText(s).width > maxW) s = s.slice(0, -1);
    g.fillText(s, x, y);
  };
  const circle = async (id, abbr, color, x, y, r) => {
    g.save(); g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.closePath(); g.clip();
    if (logos[id]) { try { const im = await loadImg(logos[id]); g.fillStyle = '#fff'; g.fillRect(x - r, y - r, r * 2, r * 2); g.drawImage(im, x - r, y - r, r * 2, r * 2); } catch (e) { g.fillStyle = color; g.fillRect(x - r, y - r, r * 2, r * 2); } }
    else { g.fillStyle = color || '#64748b'; g.fillRect(x - r, y - r, r * 2, r * 2); }
    g.restore();
    if (!logos[id]) txt((abbr || '?').slice(0, 2), x, y + r * .3, `800 ${Math.round(r * .9)}px "Barlow Condensed"`, '#fff', 'center');
  };
  const bg = g.createLinearGradient(0, 0, 0, H); bg.addColorStop(0, '#0b1f30'); bg.addColorStop(1, '#061018');
  g.fillStyle = bg; g.fillRect(0, 0, W, H); g.fillStyle = '#fbbf24'; g.fillRect(0, 0, W, 16);
  txt((meta.name || '').toUpperCase(), 60, 90, '600 36px "Barlow Condensed"', 'rgba(255,255,255,.75)', 'left', 860);
  if (logos.tournament) await circle('tournament', 'T', '#fff', 985, 80, 50);
  const title = { table: arg ? `GROUP ${arg}` : 'POINTS TABLE', orange: 'ORANGE CAP', purple: 'PURPLE CAP', boundary: 'BOUNDARY KING', result: 'MATCH RESULT', summary: 'SCORECARD', fixtures: 'FIXTURES', champion: 'CHAMPIONS', mos: 'MAN OF THE SERIES' }[kind];
  txt(title, 60, 190, '800 110px "Barlow Condensed"', '#ffffff');

  const row = i => { g.fillStyle = i % 2 ? 'rgba(255,255,255,0)' : 'rgba(255,255,255,.07)'; g.fillRect(40, 320 + i * 76, 1000, 72); return 372 + i * 76; };
  if (kind === 'table') {
    const all = Object.entries((await get(ref(db, `tournaments/${T}/points_table`))).val() || {}).map(([id, r]) => ({ id, ...r, nrr: nrrOf(r), group: r.group || meta.teams?.[id]?.group || 'A' }));
    const rows = rankRows(all.filter(r => !arg || r.group === arg)).slice(0, 11);
    const hy = 290, f = '600 32px "Barlow Condensed"', hc = '#fbbf24';
    txt('#', 70, hy, f, hc); txt('TEAM', 130, hy, f, hc); [['P', 640], ['W', 720], ['L', 800], ['PTS', 905]].forEach(([l, x]) => txt(l, x, hy, f, hc, 'center')); txt('NRR', 1020, hy, f, hc, 'right');
    if (!rows.length) txt('No results yet', 60, 380, '600 44px "Barlow"', '#fff');
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i], y = row(i);
      txt(i + 1, 70, y, '700 44px "Barlow Condensed"', i === 0 ? '#fbbf24' : '#fff');
      await circle(r.id, r.team_abbr, meta.teams?.[r.id]?.color, 170, y - 14, 26);
      txt(r.team_abbr, 215, y, '800 48px "Barlow Condensed"', '#fff'); txt(r.team_name, 330, y - 2, '500 28px "Barlow"', 'rgba(255,255,255,.65)', 'left', 250);
      [[r.matches_played, 640], [r.wins, 720], [r.losses, 800]].forEach(([v, x]) => txt(v || 0, x, y, '600 44px "Barlow Condensed"', '#fff', 'center'));
      txt((r.points || 0) + (r.adj || 0), 905, y, '800 52px "Barlow Condensed"', '#fbbf24', 'center');
      txt((r.nrr > 0 ? '+' : '') + r.nrr.toFixed(3), 1020, y, '600 36px "Barlow Condensed"', r.nrr < 0 ? '#fca5a5' : '#86efac', 'right');
    }
  } else if (kind === 'summary') {
    const m = matches[arg], base2 = `tournaments/${T}/matches/${arg}`;
    const iv = (await get(ref(db, `${base2}/innings`))).val() || {}, st = (await get(ref(db, `${base2}/stats`))).val() || {};
    let y = 240;
    for (const n of [1, 2]) {
      const x = iv[n]; if (!x) continue;
      const s2 = x.batting_team_id === m.team_a_id ? mSide(m, 'a') : mSide(m, 'b');
      const bowlTeam = x.batting_team_id === m.team_a_id ? m.team_b_id : m.team_a_id;
      g.fillStyle = s2.color; g.fillRect(40, y, 1000, 78);
      await circle(s2.id, s2.abbr, s2.color, 90, y + 39, 30);
      txt(s2.name.toUpperCase(), 140, y + 56, '800 54px "Barlow Condensed"', '#fff', 'left', 540);
      txt(`${x.runs}-${x.wickets}  (${oversText(x.balls)})`, 1016, y + 56, '800 54px "Barlow Condensed"', '#fff', 'right');
      y += 128;
      const bats = Object.entries(st).filter(([id, v]) => players[id]?.team_id === x.batting_team_id && (v.bat_balls > 0 || v.out)).sort((p, q) => q[1].bat_runs - p[1].bat_runs).slice(0, 3);
      const bowls = Object.entries(st).filter(([id, v]) => players[id]?.team_id === bowlTeam && v.bowl_balls > 0).sort((p, q) => q[1].bowl_wkts - p[1].bowl_wkts || p[1].bowl_runs - q[1].bowl_runs).slice(0, 3);
      for (let i = 0; i < 3; i++) {
        if (bats[i]) { const [id, v] = bats[i]; txt(players[id].name + (v.out ? '' : '*'), 64, y, '600 42px "Barlow Condensed"', '#fff', 'left', 280); txt(`${v.bat_runs}(${v.bat_balls})`, 500, y, '800 44px "Barlow Condensed"', '#fbbf24', 'right'); }
        if (bowls[i]) { const [id, v] = bowls[i]; txt(players[id].name, 560, y, '600 42px "Barlow Condensed"', 'rgba(255,255,255,.85)', 'left', 270); txt(`${v.bowl_wkts}-${v.bowl_runs}`, 1016, y, '800 44px "Barlow Condensed"', '#fff', 'right'); }
        y += 58;
      }
      y += 34;
    }
    g.fillStyle = 'rgba(255,255,255,.2)'; g.fillRect(40, 905, 1000, 2);
    txt('WINNER', 64, 955, '600 30px "Barlow Condensed"', 'rgba(255,255,255,.6)');
    txt(m.result || 'Match in progress', 64, 1015, '800 66px "Barlow Condensed"', '#fbbf24', 'left', 960);
    if (m.pom_name) {
      g.fillStyle = 'rgba(251,191,36,.15)'; g.fillRect(40, 1050, 1000, 150);
      txt('PLAYER OF THE MATCH', 64, 1098, '600 30px "Barlow Condensed"', '#fbbf24');
      txt(m.pom_name, 64, 1170, '800 74px "Barlow Condensed"', '#fff', 'left', 560);
      txt(m.pom_line || '', 1016, 1170, '800 54px "Barlow Condensed"', '#fbbf24', 'right', 400);
    }
  } else if (kind === 'fixtures') {
    const list = Object.values(matches).filter(m => (m.status || 'scheduled') === 'scheduled').sort((a, b) => (a.date || a.created || 0) - (b.date || b.created || 0)).slice(0, 7);
    if (!list.length) txt('No upcoming matches', 60, 380, '600 44px "Barlow"', '#fff');
    for (let i = 0; i < list.length; i++) {
      const m = list[i], y = 270 + i * 135;
      g.fillStyle = i % 2 ? 'rgba(255,255,255,.04)' : 'rgba(255,255,255,.08)'; g.fillRect(40, y, 1000, 125);
      txt(m.date ? fmtWhen(m.date) : (m.stage && m.stage !== 'Group' ? m.stage : 'Date to be announced'), 64, y + 52, '600 34px "Barlow Condensed"', '#fbbf24', 'left', 330);
      if (m.ground) txt(m.ground, 64, y + 98, '500 28px "Barlow"', 'rgba(255,255,255,.65)', 'left', 330);
      await circle(m.team_a_id, m.team_a_abbr, m.team_a_color, 470, y + 62, 38);
      txt(m.team_a_abbr, 525, y + 78, '800 54px "Barlow Condensed"', '#fff');
      txt('v', 640, y + 74, '600 34px "Barlow Condensed"', 'rgba(255,255,255,.5)', 'center');
      txt(m.team_b_abbr, 745, y + 78, '800 54px "Barlow Condensed"', '#fff', 'right');
      await circle(m.team_b_id, m.team_b_abbr, m.team_b_color, 825, y + 62, 38);
      txt(m.stage && m.stage !== 'Group' ? m.stage : (m.group ? 'Group ' + m.group : ''), 1016, y + 76, '600 28px "Barlow Condensed"', 'rgba(255,255,255,.7)', 'right', 150);
    }
  } else if (kind === 'champion') {
    const f = Object.values(matches).find(m => m.stage === 'Final' && m.status === 'completed' && m.winner_id && m.winner_id !== 'tie' && m.winner_id !== 'none');
    if (!f) txt('The final is not finished yet', 60, 380, '600 44px "Barlow"', '#fff');
    else {
      const win = f.winner_id === f.team_a_id ? mSide(f, 'a') : mSide(f, 'b'), run = win.id === f.team_a_id ? mSide(f, 'b') : mSide(f, 'a');
      await circle(win.id, win.abbr, win.color, 540, 540, 200);
      txt('CHAMPIONS', 540, 850, '800 150px "Barlow Condensed"', '#fbbf24', 'center');
      txt(win.name.toUpperCase(), 540, 940, '800 84px "Barlow Condensed"', '#fff', 'center', 980);
      txt('Runners-up: ' + run.name, 540, 1010, '600 44px "Barlow Condensed"', 'rgba(255,255,255,.75)', 'center', 980);
      const best = Object.values((await get(ref(db, `tournaments/${T}/leaderboards`))).val() || {}).map(p => ({ ...p, pts: mosPts(p) })).sort((a, b) => b.pts - a.pts)[0];
      if (best && best.pts > 0) txt('Man of the Tournament: ' + best.player_name, 540, 1100, '700 50px "Barlow Condensed"', '#fff', 'center', 980);
    }
  } else if (kind === 'mos') {
    const list = Object.values((await get(ref(db, `tournaments/${T}/leaderboards`))).val() || {}).map(p => ({ ...p, pts: mosPts(p) })).filter(p => p.pts > 0).sort((a, b) => b.pts - a.pts).slice(0, 3);
    if (!list.length) txt('Nobody on the board yet', 60, 380, '600 44px "Barlow"', '#fff');
    list.forEach((p, i) => {
      const y = 290 + i * 300;
      g.fillStyle = i === 0 ? 'rgba(251,191,36,.18)' : 'rgba(255,255,255,.06)'; g.fillRect(40, y, 1000, 270);
      txt(i + 1, 90, y + 150, '800 130px "Barlow Condensed"', i === 0 ? '#fbbf24' : '#fff', 'center');
      txt(p.player_name, 160, y + 100, '800 76px "Barlow Condensed"', '#fff', 'left', 600);
      txt(p.team_name, 160, y + 150, '500 36px "Barlow"', 'rgba(255,255,255,.65)', 'left', 600);
      txt(`${p.total_runs || 0} runs, ${p.total_wickets || 0} wickets, ${p.total_sixes || 0} sixes`, 160, y + 210, '600 38px "Barlow Condensed"', 'rgba(255,255,255,.85)', 'left', 700);
      txt(p.pts, 1010, y + 150, '800 120px "Barlow Condensed"', i === 0 ? '#fbbf24' : '#fff', 'right');
      txt('POINTS', 1010, y + 200, '600 30px "Barlow Condensed"', 'rgba(255,255,255,.6)', 'right');
    });
  } else if (kind === 'result') {
    const m = matches[arg], iv = (await get(ref(db, `tournaments/${T}/matches/${arg}/innings`))).val() || {};
    for (const [i, n] of [1, 2].entries()) {
      const x = iv[n]; if (!x) continue;
      const s = x.batting_team_id === m.team_a_id ? mSide(m, 'a') : mSide(m, 'b'), y = 300 + i * 330;
      g.fillStyle = s.color; g.fillRect(40, y, 18, 270);
      await circle(s.id, s.abbr, s.color, 150, y + 100, 70);
      txt(s.abbr, 250, y + 120, '800 130px "Barlow Condensed"', '#fff');
      txt(s.name, 250, y + 175, '500 40px "Barlow"', 'rgba(255,255,255,.7)', 'left', 380);
      txt(`${x.runs}/${x.wickets}`, 1020, y + 140, '800 150px "Barlow Condensed"', '#fff', 'right');
      txt(`${oversText(x.balls)} overs`, 1020, y + 200, '600 44px "Barlow Condensed"', 'rgba(255,255,255,.75)', 'right');
    }
    const words = String(m.result || 'Match in progress').split(' '); let line = '', y = 1030; const lines = [];
    g.font = '800 78px "Barlow Condensed"';
    words.forEach(w => { const t = (line + ' ' + w).trim(); if (g.measureText(t).width > 960) { lines.push(line); line = w; } else line = t; }); lines.push(line);
    lines.slice(0, 2).forEach(l => { txt(l, 540, y, '800 78px "Barlow Condensed"', '#fbbf24', 'center'); y += 86; });
    if (m.pom_name) txt(`Player of the match: ${m.pom_name} ${m.pom_line || ''}`, 540, 1215, '600 38px "Barlow Condensed"', 'rgba(255,255,255,.85)', 'center', 980);
  } else {
    const f = { orange: 'total_runs', purple: 'total_wickets', boundary: 'total_boundaries' }[kind];
    const unit = { orange: 'runs', purple: 'wickets', boundary: 'boundaries' }[kind];
    const list = Object.values((await get(ref(db, `tournaments/${T}/leaderboards`))).val() || {}).filter(p => (p[f] || 0) > 0)
      .sort((a, b) => kind === 'orange' ? b.total_runs - a.total_runs || (a.total_balls_faced || 0) - (b.total_balls_faced || 0)
        : kind === 'purple' ? b.total_wickets - a.total_wickets : b.total_boundaries - a.total_boundaries || (b.total_sixes || 0) - (a.total_sixes || 0)).slice(0, 5);
    if (!list.length) txt('Nobody on the board yet', 60, 380, '600 44px "Barlow"', '#fff');
    list.forEach((p, i) => {
      const y = 300 + i * 185;
      g.fillStyle = i === 0 ? 'rgba(251,191,36,.18)' : 'rgba(255,255,255,.06)'; g.fillRect(40, y, 1000, 165);
      txt(i + 1, 90, y + 105, '800 90px "Barlow Condensed"', i === 0 ? '#fbbf24' : '#fff', 'center');
      txt(p.player_name, 160, y + 80, '800 62px "Barlow Condensed"', '#fff', 'left', 560);
      const sub = kind === 'orange' ? `${p.team_name}, ${p.total_balls_faced || 0} balls` : kind === 'purple' ? `${p.team_name}, econ ${p.total_balls_bowled ? ((p.total_runs_conceded || 0) / (p.total_balls_bowled / 6)).toFixed(2) : '-'}` : `${p.team_name}, ${p.total_sixes || 0} sixes ${p.total_fours || 0} fours`;
      txt(sub, 160, y + 128, '500 32px "Barlow"', 'rgba(255,255,255,.65)', 'left', 560);
      txt(p[f], 1010, y + 100, '800 110px "Barlow Condensed"', i === 0 ? '#fbbf24' : '#fff', 'right');
      txt(unit.toUpperCase(), 1010, y + 142, '600 30px "Barlow Condensed"', 'rgba(255,255,255,.6)', 'right');
    });
  }
  if (meta.sponsor_name || logos.sponsor) {
    g.fillStyle = 'rgba(0,0,0,.4)'; g.fillRect(0, 1240, W, 110);
    txt('SPONSORED BY', 60, 1290, '600 30px "Barlow Condensed"', 'rgba(255,255,255,.65)');
    if (meta.sponsor_name) txt(meta.sponsor_name, 60, 1335, '800 50px "Barlow Condensed"', '#fff', 'left', logos.sponsor ? 560 : 960);
    if (logos.sponsor) try {
      const im = await loadImg(logos.sponsor), s = Math.min(380 / im.width, 90 / im.height), w = im.width * s, h = im.height * s;
      g.fillStyle = '#fff'; g.fillRect(1020 - w - 20, 1295 - h / 2 - 12, w + 20, h + 24); g.drawImage(im, 1010 - w, 1295 - h / 2, w, h);
    } catch (e) {}
  }
  drawBrand(g, 1040, 232, 44);
  return c;
}
async function showCard(kind, arg) {
  toast('Making picture...');
  try {
    const c = await makeCard(kind, arg);
    ui.card = { c, name: `${kind}-${Date.now()}` };
    showSheet(`<img src="${c.toDataURL('image/png')}" class="w-full rounded-xl mb-3" alt="Preview"><div class="grid grid-cols-2 gap-2"><button data-a="close" class="${B2}">Close</button><button data-a="dl" class="${B1}">Share / Save</button></div>`);
  } catch (e) { fail(e); }
}
async function shareCard() {
  const { c, name } = ui.card;
  const blob = await new Promise(r => c.toBlob(r, 'image/png')), file = new File([blob], name + '.png', { type: 'image/png' });
  if (navigator.canShare?.({ files: [file] })) { try { await navigator.share({ files: [file] }); return; } catch (e) { if (e.name === 'AbortError') return; } }
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name + '.png'; a.click();
}

/* ---------- events ---------- */
document.addEventListener('change', e => {
  const t = e.target;
  if (t.id === 'tsel') { T = t.value; watchTournament(); render(true); }
  else if (t.dataset && t.dataset.kp !== undefined && ui.kp) { const [i, sd] = t.dataset.kp.split(':').map(Number); ui.kp.pairs[i][sd] = t.value; showKp(); }
  else if (t.id === 'kp-stage' && ui.kp) ui.kp.stage = t.value;
});
document.addEventListener('input', e => { if (e.target.id === 'mq') { ui.q = e.target.value; ui.mlimit = 30; const el = $('#mlist'); if (el) el.innerHTML = matchCards(); } });
document.addEventListener('click', e => {
  const el = e.target.closest('[data-a]'); if (!el) return;
  const a = el.dataset.a, v = el.dataset.v, id = el.dataset.id, w = ui.w, ex = ui.ex;
  switch (a) {
    case 'tab': tab = v; render(true); window.scrollTo(0, 0); break;
    case 'signout': signOut(auth); break;
    case 'toggle-lt': try { localStorage.setItem('cl_lt', isLight() ? '0' : '1'); } catch (e) {} closeSheet(); setTheme(true); render(true); break;
    case 'save-cname': saveCname(); break;
    case 'save-tname': saveTname(); break;
    case 'copy-log': copy('JRCricks ' + APP_VER + '\n' + (errLog.length ? errLog.join('\n') : 'no errors recorded')); break;
    case 'extra-toggle': update(ref(db), { [`licenses/${id}/extra`]: allLic[id]?.extra ? null : true }).then(() => toast(allLic[id]?.extra ? 'Extra tournament switched off' : 'One more tournament allowed')).catch(fail); break;
    case 'cu': copy(user.uid); break;
    case 'reload': location.reload(); break;
    case 'filter': ui.filter = v; render(true); break;
    case 'new-match': newMatchSheet(); break;
    case 'mk': makeMatch(); break;
    case 'more': moreSheet(id); break;
    case 'gfx-sheet': gfxSheet(id); break;
    case 'gfx-sheet-score': closeSheet(); gfxSheet(M); break;
    case 'gfx': ensureToken(id).then(tk => update(ref(db), { [`overlay/${tk}/gfx`]: { type: v, n: Date.now() } })).then(() => toast('Sent to overlay')).catch(fail); break;
    case 'score': openMatch(id); break;
    case 'scorecard': openCard(id); break;
    case 'copy-ov': ensureToken(id).then(tk => { copy(ovLink(tk)); if (!licOk()) toast('Copied. The overlay shows after the admin activates your license.'); }).catch(fail); break;
    case 'open-ov': ensureToken(id).then(tk => window.open(ovLink(tk) + '&debug=1', '_blank')).catch(fail); break;
    case 'rotate': rotateToken(id); break;
    case 'toggle': { const up = {}; putInfo(up, id, 'active', matches[id].active === false); update(ref(db), up).then(() => moreSheet(id)).catch(fail); break; }
    case 'delmatch':
      if (confirm('Delete this match and its ball log? Stats already added to the tables stay.')) { const up = { [`tournaments/${T}/match_index/${id}`]: null, [`tournaments/${T}/matches/${id}`]: null }; if (matches[id]?.token) up[`overlay/${matches[id].token}`] = null; update(ref(db), up).then(closeSheet).catch(fail); } break;
    case 'team': teamSheet(id); break;
    case 'team-save': saveTeam(id); break;
    case 'team-del': {
      if (!confirm('Remove this team and its players?')) break;
      const up = { [`tournaments/${T}/meta/teams/${id}`]: null, [`tournaments/${T}/points_table/${id}`]: null, [`tournaments/${T}/logos/${id}`]: null };
      teamPlayers(id).forEach(p => { up[`tournaments/${T}/players/${p.id}`] = null; up[`tournaments/${T}/leaderboards/${p.id}`] = null; });
      update(ref(db), up).then(closeSheet).catch(fail); break;
    }
    case 'tp-add': addPlayers(id); break;
    case 'delplayer':
      if (confirm('Remove this player and their stats?')) update(ref(db), { [`tournaments/${T}/players/${id}`]: null, [`tournaments/${T}/leaderboards/${id}`]: null }).then(() => setTimeout(() => teamSheet(el.dataset.t), 250)).catch(fail); break;
    case 'groups': { let n = +v; if (v === 'x') n = +(prompt('How many groups? (1 to 26)') || 0); if (!(n >= 1 && n <= 26)) break; update(ref(db), { [`tournaments/${T}/meta/group_count`]: n }).catch(fail); break; }
    case 'draw': drawGroups(); break;
    case 'fixtures': genFixtures(); break;
    case 'refresh-table': ui.lb = null; render(true); break;
    case 'tnew': createTournament(); break;
    case 'save-rules': saveRules(); break;
    case 'save-sp': saveSponsor(); break;
    case 'rm-logo': update(ref(db), { [`tournaments/${T}/logos/sponsor`]: null }).then(() => render(true)).catch(fail); break;
    case 'card': showCard(el.dataset.k, id); break;
    case 'card-tab': ui.tabCard = +v; render(true); break;
    case 'dl': shareCard(); break;
    case 'back': goHome(); break;
    case 'pom': openPom(id); break;
    case 'pom-pick': savePom(+el.dataset.i); break;
    case 'toss-win': ui.toss = { ...(ui.toss || { dec: 'bat' }), win: id }; ui.viewKey = ''; render(); break;
    case 'toss-dec': ui.toss = { ...(ui.toss || { win: info.team_a_id }), dec: v }; ui.viewKey = ''; render(); break;
    case 'takeover': acquireLock(true).then(() => { readOnly = false; ui.viewKey = ''; render(true); }).catch(fail); break;
    case 'so-start': ui.soN = +el.dataset.n; ui.viewKey = ''; render(); break;
    case 'run': runBall({ k: 'run', bat: +v }); break;
    case 'wd': runBall({ k: 'wd' }); break;
    case 'nb': runBall({ k: 'nb' }); break;
    case 'undo': undoLast(); break;
    case 'out': ui.w = { type: '', kind: 'run', who: 'striker', runs: 0, step: 1, fld: '' }; ui.sheet = 'wicket'; showDark(wicketSheet()); break;
    case 'w-type': w.type = v; showDark(wicketSheet()); break;
    case 'w-kind': w.kind = v; showDark(wicketSheet()); break;
    case 'w-who': w.who = v; showDark(wicketSheet()); break;
    case 'w-runs': w.runs = +v; showDark(wicketSheet()); break;
    case 'w-back': w.step = (w.step === 2 && ['Caught', 'Stumped', 'Run Out'].includes(w.type)) ? 'f' : 1; showDark(wicketSheet()); break;
    case 'w-next': {
      const allOut = live.wickets + 1 >= wLimL(live);
      if (['Caught', 'Stumped', 'Run Out'].includes(w.type)) { w.step = 'f'; showDark(wicketSheet()); }
      else if (allOut) doWicket(null); else { w.step = 2; showDark(wicketSheet()); }
      break;
    }
    case 'w-fld': w.fld = id || ''; if (live.wickets + 1 >= wLimL(live)) doWicket(null); else { w.step = 2; showDark(wicketSheet()); } break;
    case 'w-in': doWicket(id); break;
    case 'bye': case 'lb': ui.ex = { kind: el.dataset.a, n: 1 }; ui.sheet = 'extras'; showDark(extrasSheet()); break;
    case 'extras': ui.ex = { kind: 'wd', n: 0 }; ui.sheet = 'extras'; showDark(extrasSheet()); break;
    case 'ex-kind': ex.kind = v; ex.n = v === 'pen' ? 5 : (v === 'bye' || v === 'lb') ? Math.max(1, ex.n) : ex.n; showDark(extrasSheet()); break;
    case 'ex-n': ex.n = +v; showDark(extrasSheet()); break;
    case 'ex-ok': {
      if (['bye', 'lb', 'pen'].includes(ex.kind) && ex.n < 1) return toast('Pick how many runs', true);
      const inp = ex.kind === 'nb' ? { k: 'nb', bat: ex.n } : { k: ex.kind, ran: ex.n };
      closeSheet(); runBall(inp); break;
    }
    case 'menu': ui.sheet = 'menu'; showDark(menuSheet()); break;
    case 'fix-open': openFix(); break;
    case 'fix-list': showDark(fixListSheet()); break;
    case 'fix-pick': {
      const e = ui.fix.ents.find(x => x.key === el.dataset.key), lg = ui.fix.log.find(x => x.key === el.dataset.key);
      if (!e || e.t !== 'b' || !['run', 'bye', 'lb', 'wd', 'nb'].includes(e.k)) return toast('This entry cannot be edited. Use Undo.', true);
      ui.fixEdit = { key: e.key, k0: e.k, k: e.k, n: (e.k === 'run' || e.k === 'nb') ? e.bat : e.ran, label: lg ? lg.label : '', hasWicket: !!e.w }; showDark(fixEditSheet()); break;
    }
    case 'fix-kind': ui.fixEdit.k = v; if ((v === 'bye' || v === 'lb') && ui.fixEdit.n < 1) ui.fixEdit.n = 1; showDark(fixEditSheet()); break;
    case 'fix-n': ui.fixEdit.n = +v; showDark(fixEditSheet()); break;
    case 'fix-save': saveFix(); break;
    case 'rt-open': ui.rt = { type: 'Retired Hurt', who: 'striker', step: 1 }; showDark(retireSheet()); break;
    case 'rt-type': ui.rt.type = v; showDark(retireSheet()); break;
    case 'rt-who': ui.rt.who = v; showDark(retireSheet()); break;
    case 'rt-back': ui.rt.step = 1; showDark(retireSheet()); break;
    case 'rt-next': {
      const real = ui.rt.type !== 'Retired Hurt';
      if (real && live.wickets + 1 >= wLimL(live)) doRetire(null);
      else if (!availBats().length) toast('No batsman is available to come in', true);
      else { ui.rt.step = 2; showDark(retireSheet()); }
      break;
    }
    case 'rt-in': doRetire(id); break;
    case 'swap': closeSheet(); commitEntry({ t: 'sw' }); break;
    case 'add-bat': case 'add-bowl': {
      const tid = a === 'add-bat' ? live.batting_team_id : live.bowling_team_id, name = (prompt('Player name') || '').trim();
      if (!name) break; closeSheet();
      const pid = push(ref(db, `tournaments/${T}/players`)).key, t = tm(tid);
      update(ref(db), {
        [`tournaments/${T}/players/${pid}`]: { name, team_id: tid, team_name: t.name, order: Date.now() },
        [`tournaments/${T}/leaderboards/${pid}`]: { player_name: name, team_name: t.name, total_runs: 0, total_balls_faced: 0, total_fours: 0, total_sixes: 0, total_boundaries: 0, total_wickets: 0, total_runs_conceded: 0, total_balls_bowled: 0, total_maidens: 0 }
      }).then(() => toast('Player added')).catch(fail); break;
    }
    case 'chg-bowler': ui.sheet = 'bowler-change'; showDark(bowlerSheet(true)); break;
    case 'bowler': closeSheet(); commitEntry({ t: 'bw', id }); break;
    case 'end-inn': closeSheet(); endInnings(); break;
    case 'start': startInnings(+el.dataset.n); break;
    case 'finalize': finalize(); break;
    case 'studio': openStudio(id); break;
    case 'card-mode': ui.cardMode = v; render(true); break;
    case 'copy-text': copy(v); break;
    case 'ko-semi': koSemis(); break;
    case 'ko-final': koFinal(); break;
    case 'format': update(ref(db), { [`tournaments/${T}/meta/format`]: v }).catch(fail); break;
    case 'ko-start': koStart(v === '1'); break;
    case 'ko-next': koNext(); break;
    case 'copy-open': copySheet(); break;
    case 'copy-do': copyTeams(id); break;
    case 'edit-match': editMatchSheet(id); break;
    case 'save-match': saveMatchEdit(id); break;
    case 'xi-open': xiSheet(id); break;
    case 'xi-all': document.querySelectorAll(`.xi-${v}`).forEach(c => { c.checked = true; }); break;
    case 'xi-save': saveXI(id); break;
    case 'res-open': ui.mr = null; resultSheet(id); break;
    case 'res-type': ui.mr.type = v; resultSheet(ui.mr.id); break;
    case 'res-save': { const w2 = $('#res-w') ? $('#res-w').value : ''; manualResult(id, ui.mr.type, w2 || ui.mr.winner); break; }
    case 'reopen': reopenMatch(id); break;
    case 'sched-open': schedSheet(); break;
    case 'sched-save': applySchedule(); break;
    case 'rv-open': reviseSheet(); break;
    case 'rv-save': { const o = +$('#rv-o').value, tg = $('#rv-t') ? +$('#rv-t').value : 0; if (!(o >= 1)) return toast('Enter the overs', true); closeSheet(); commitEntry({ t: 'rv', overs: o, target: tg || null }); break; }
    case 'adj': adjSheet(id); break;
    case 'adj-save': update(ref(db), { [`tournaments/${T}/points_table/${id}/adj`]: +$('#adj-v').value || 0, [`tournaments/${T}/points_table/${id}/adj_note`]: $('#adj-n').value.trim() || null }).then(() => { closeSheet(); ui.lb = null; render(true); toast('Points adjusted'); }).catch(fail); break;
    case 'tiebreak': update(ref(db), { [`tournaments/${T}/meta/tiebreak`]: v }).catch(fail); break;
    case 'theme': { const up = { [`tournaments/${T}/meta/theme`]: v }; propagate(up, 'theme', v); update(ref(db), up).catch(fail); break; }
    case 'save-look': saveLook(); break;
    case 'backup': downloadBackup(); break;
    case 'pay': { const amt = +(prompt('Amount received (numbers only)') || 0); if (!amt) break; const note = (prompt('Note (optional)') || '').trim(), cur = allLic[id] || {}; update(ref(db), { [`licenses/${id}/paid`]: (cur.paid || 0) + amt, [`licenses/${id}/last_paid`]: Date.now(), [`licenses/${id}/note`]: note || null }).then(() => toast('Payment recorded')).catch(fail); break; }
    case 'ko-hand': kpOpen('ko1'); break;
    case 'ko-next-hand': kpOpen('konext'); break;
    case 'group-hand': kpOpen('group'); break;
    case 'grp-open': groupSheet(); break;
    case 'grp-save': saveGroups(); break;
    case 'kp-add': ui.kp.pairs.push(['', '']); showKp(); break;
    case 'kp-del': ui.kp.pairs.splice(+id, 1); if (!ui.kp.pairs.length) ui.kp.pairs.push(['', '']); showKp(); break;
    case 'kp-fill': kpFill(); break;
    case 'kp-create': kpCreate(); break;
    case 'bulk-open': bulkSheet(); break;
    case 'bulk-save': addBulkTeams(); break;
    case 'm-more': { ui.mlimit = (ui.mlimit || 30) + 30; const el2 = $('#mlist'); if (el2) el2.innerHTML = matchCards(); break; }
    case 'mode': mode = v; loginView(); break;
    case 'do-login': signInWithEmailAndPassword(auth, $('#em').value.trim(), $('#pw').value).catch(e => loginView('Could not sign in: ' + (e.code || e.message))); break;
    case 'do-register': {
      const n = $('#rn').value.trim(); if (!n) return loginView('Enter your committee name');
      regName = n; regPhone = $('#rp') ? $('#rp').value.trim() : ''; createUserWithEmailAndPassword(auth, $('#em').value.trim(), $('#pw').value).catch(e => { regName = ''; loginView('Could not register: ' + (e.code || e.message)); }); break;
    }
    case 'forgot': { const em = $('#em').value.trim(); if (!em) return loginView('Type your email above first'); sendPasswordResetEmail(auth, em).then(() => loginView('Password reset email sent. Check your inbox.')).catch(e => loginView(e.code || e.message)); break; }
    case 'finish-profile': { const n = $('#rn').value.trim(); if (!n) return toast('Enter a name', true); regName = n; afterAuth(); break; }
    case 'refresh-auth': afterAuth(); break;
    case 'approve': case 'disable': update(ref(db), { [`committees/${id}/approved`]: a === 'approve' }).catch(fail); break;
    case 'del-committee': if (confirm('Remove this committee account record? Their tournaments are not deleted.')) update(ref(db), { [`committees/${id}`]: null, [`licenses/${id}`]: null }).catch(fail); break;
    case 'lic-add': {
      const cur = allLic[id], from = Math.max(Date.now(), cur?.on ? (cur.until || 0) : 0), until = from + (+el.dataset.days) * 86400000;
      update(ref(db), { [`licenses/${id}/on`]: true, [`licenses/${id}/until`]: until }).then(() => toast('Overlay active until ' + fmtDate(until))).catch(fail); break;
    }
    case 'lic-off': update(ref(db), { [`licenses/${id}/on`]: false }).then(() => toast('Overlay switched off')).catch(fail); break;
    case 'ad-add': addAd(); break;
    case 'ad-del': if (confirm('Delete this ad?')) update(ref(db), { [`ads/${id}`]: null }).catch(fail); break;
    case 'ad-toggle': update(ref(db), { [`ads/${id}/on`]: adminData.ads[id]?.on === false }).catch(fail); break;
    case 'close': closeSheet(); break;
  }
});
if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {});
</script>
</body>
</html>

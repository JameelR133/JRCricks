<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>JRCricks Overlay</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  /* Transparent canvas for browser-source use. 1rem = 16px at 1920px wide, so everything scales with the source width. */
  html { background: transparent !important; font-size: 0.8333vw; }
  body { background: transparent !important; margin: 0; overflow: hidden; }
  .theme-glass [class*="bg-slate-9"], .theme-glass [class*="from-slate-9"] { background: rgba(15,23,42,.5) !important; background-image: none !important; backdrop-filter: blur(14px); }
  .theme-bold #teamBlock { background: #0b1220 !important; }
  .theme-bold [class*="bg-slate-9"], .theme-bold [class*="from-slate-9"] { background: var(--tc, #e11d48) !important; background-image: none !important; }
</style>
<script>
tailwind.config = {
  theme: { extend: {
    fontFamily: { display: ['"Barlow Condensed"', 'sans-serif'], sans: ['Barlow', 'sans-serif'] },
    keyframes: {
      freehit: { '0%,100%': { boxShadow: '0 0 0 0 rgba(251,191,36,0)', filter: 'brightness(1)' }, '50%': { boxShadow: '0 0 1.6rem 0.3rem rgba(251,191,36,.85)', filter: 'brightness(1.25)' } },
      bump: { '0%': { transform: 'scale(1.18)' }, '100%': { transform: 'scale(1)' } }
    },
    animation: { freehit: 'freehit 1.1s ease-in-out infinite', bump: 'bump .28s ease-out' }
  } }
};
</script>
</head>
<body class="font-sans text-white">

<!-- Big moment banner: FOUR / SIX / WICKET -->
<div id="flash" class="fixed left-1/2 top-[30%] -translate-x-1/2 -translate-y-1/2 opacity-0 scale-75 transition-all duration-300 ease-out pointer-events-none z-30">
  <div id="flashBox" class="px-[5rem] py-[0.6rem] font-display font-extrabold text-[8rem] leading-none tracking-wide shadow-[0_0_4rem_rgba(0,0,0,.6)]" style="clip-path:polygon(3% 0,100% 0,97% 100%,0 100%)"><span id="flashText">FOUR</span></div>
</div>

<!-- Full graphics: intro / result (centre of screen) -->
<div id="big" class="fixed left-1/2 top-1/2 w-[70rem] -translate-x-1/2 -translate-y-1/2 opacity-0 scale-95 transition-all duration-500 ease-out pointer-events-none z-20"></div>

<!-- Cards above the strip: batter / partnership -->
<div id="card" class="fixed left-1/2 bottom-[13rem] w-[52rem] -translate-x-1/2 translate-y-8 opacity-0 transition-all duration-500 ease-out pointer-events-none z-10"></div>

<div id="stage" class="fixed left-1/2 bottom-[3.4rem] w-[78rem] -translate-x-1/2 translate-y-10 opacity-0 transition-all duration-500 ease-out">
  <div class="flex items-end justify-between mb-[0.35rem] px-[1rem] h-[2.3rem]">
    <div class="flex items-end gap-[0.6rem]">
      <div id="freeHit" class="opacity-0 transition-opacity duration-200 px-[1.2rem] py-[0.15rem] bg-amber-400 text-black font-display font-extrabold text-[1.6rem] tracking-wider animate-freehit" style="clip-path:polygon(6% 0,100% 0,94% 100%,0 100%)">FREE HIT</div>
      <div id="stageTag" class="opacity-0 transition-opacity duration-300 px-[1.2rem] py-[0.15rem] bg-slate-950/90 text-white/90 font-display font-semibold text-[1.4rem] tracking-wide" style="clip-path:polygon(6% 0,100% 0,94% 100%,0 100%)"></div>
    </div>
    <div class="flex items-end gap-[0.6rem]">
      <div id="chase" class="px-[1.4rem] py-[0.2rem] bg-slate-950/90 text-white font-display font-semibold text-[1.5rem] opacity-0 transition-opacity duration-300" style="clip-path:polygon(4% 0,100% 0,96% 100%,0 100%)"></div>
      <img id="sponsor" alt="" class="hidden transition-opacity duration-300 h-[2.2rem] w-auto bg-white px-[0.5rem] py-[0.2rem] rounded-[0.3rem]">
    </div>
  </div>

  <div class="flex items-stretch h-[5.6rem] shadow-[0_0.6rem_2rem_rgba(0,0,0,.55)]">
    <div id="teamBlock" class="w-[12rem] flex items-center gap-[0.7rem] pl-[0.9rem] text-white transition-colors duration-500" style="background:var(--tc,#e11d48);clip-path:polygon(0 0,100% 0,94% 100%,0 100%)">
      <div class="w-[3.9rem] h-[3.9rem] rounded-full bg-white/95 flex items-center justify-center overflow-hidden shrink-0 shadow-[0_0_0.6rem_rgba(0,0,0,.35)]"><img id="logoBat" alt="" class="hidden w-full h-full object-cover"><span id="logoBatFb" class="font-display font-extrabold text-[1.6rem] text-slate-700">--</span></div>
      <div><div id="abbr" class="font-display font-extrabold text-[2.9rem] leading-none tracking-wide">---</div><div id="vs" class="font-display font-semibold text-[1.05rem] leading-none opacity-85 mt-[0.2rem]">v ---</div></div>
    </div>
    <div class="flex items-center gap-[0.4rem] pl-[1.2rem] pr-[1.3rem] bg-slate-950/95">
      <span id="runs" class="font-display font-extrabold text-[4.2rem] leading-none tabular-nums inline-block">0</span>
      <span class="font-display font-bold text-[3rem] text-slate-400 leading-none">-</span>
      <span id="wkts" class="font-display font-extrabold text-[4.2rem] leading-none tabular-nums inline-block">0</span>
    </div>
    <div class="flex flex-col items-center justify-center px-[1.2rem] bg-slate-900/95 border-l border-white/10">
      <span id="overs" class="font-display font-bold text-[2.6rem] leading-none tabular-nums inline-block">0.0</span>
      <span id="oversOf" class="font-display font-semibold text-[1rem] text-slate-400 leading-none mt-[0.2rem]">OVERS</span>
    </div>
    <div class="flex-1 min-w-0 flex flex-col justify-center px-[1.4rem] gap-[0.1rem] bg-gradient-to-r from-slate-900/95 to-slate-950/95">
      <div class="flex items-baseline justify-between"><span id="b1n" class="font-display font-bold text-[1.9rem] leading-tight truncate">-</span><span class="font-display font-bold text-[1.9rem] leading-tight tabular-nums"><span id="b1r" class="inline-block">0</span> <span id="b1b" class="text-[1.3rem] text-slate-400">(0)</span></span></div>
      <div class="flex items-baseline justify-between text-slate-300"><span id="b2n" class="font-display font-semibold text-[1.9rem] leading-tight truncate">-</span><span class="font-display font-semibold text-[1.9rem] leading-tight tabular-nums"><span id="b2r" class="inline-block">0</span> <span id="b2b" class="text-[1.3rem] text-slate-500">(0)</span></span></div>
    </div>
    <div class="w-[16rem] flex flex-col justify-center px-[1.3rem] bg-white text-slate-900" style="clip-path:polygon(6% 0,100% 0,100% 100%,0 100%)">
      <span id="bwn" class="font-display font-bold text-[1.7rem] leading-tight truncate pl-[0.6rem]">-</span>
      <span class="font-display font-extrabold text-[2.1rem] leading-tight tabular-nums pl-[0.6rem]"><span id="bwf" class="inline-block">0.0 - 0 - 0 - 0</span></span>
    </div>
  </div>

  <div class="flex items-center justify-end gap-[0.35rem] mt-[0.45rem] h-[2.2rem]">
    <span id="tickLabel" class="font-display font-semibold text-[1.1rem] text-white/80 mr-[0.4rem] px-[0.7rem] bg-slate-950/80 opacity-0 transition-opacity duration-300">LAST 12</span>
    <div id="ticker" class="flex items-center gap-[0.35rem]"></div>
  </div>
</div>

<!-- JRCricks watermark -->
<div id="wm" class="fixed top-[2.2rem] right-[2.8rem] z-40 pointer-events-none flex items-center gap-[0.55rem] opacity-0 transition-opacity duration-500" style="text-shadow:0 0.1rem 0.45rem rgba(0,0,0,.75)">
  <svg viewBox="0 0 40 40" class="w-[2.6rem] h-[2.6rem]"><circle cx="20" cy="20" r="18" fill="#ef4444"/><path d="M9 8c5 5 5 19 0 24M31 8c-5 5-5 19 0 24" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round"/></svg>
  <span class="font-display font-extrabold text-[2.3rem] leading-none tracking-wide"><span style="color:#fbbf24">JR</span><span class="text-white">Cricks</span></span>
</div>
<div id="inactive" class="hidden fixed left-4 bottom-4 text-white/70 text-[1.2rem] font-display">Overlay inactive: license expired, switched off, or this link was replaced.</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import { getDatabase, ref, onValue, get } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-database.js";

/* ====== FIREBASE CONFIG ====== */
const firebaseConfig = {
  apiKey: "AIzaSyDkLxwnT685zj2qYSAs4lCe-u-FYjVmnZA",
  authDomain: "jrcricks.firebaseapp.com",
  databaseURL: "https://jrcricks-default-rtdb.firebaseio.com",
  projectId: "jrcricks",
  appId: "1:924049422792:web:be1c1dd705b70b89ebe8fd"
};
/* ============================= */

const P = new URLSearchParams(location.search);
const K = P.get('k'), DEMO = P.get('demo') === '1', DEBUG = P.get('debug') === '1';
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const cache = {};
let info = null, last = null, hidden = false, lastEvent = null, tickKey = '', flashTimer, cardTimer, lastGfx = null, bigType = '', prevBat = null, prevOver = null, prevBrk = null;
const logoCache = {};

function setText(id, v, bump = true) {
  v = String(v); if (cache[id] === v) return; cache[id] = v;
  const e = $(id); e.textContent = v;
  if (bump) { e.classList.remove('animate-bump'); void e.offsetWidth; e.classList.add('animate-bump'); }
}
const setOpacity = (id, on) => { const c = on ? '1' : '0'; if (cache['o' + id] !== c) { cache['o' + id] = c; $(id).style.opacity = c; } };

const chipClass = t => t === 'W' ? 'bg-red-600 text-white' : t === '6' ? 'bg-emerald-400 text-slate-900' : t === '4' ? 'bg-amber-400 text-slate-900'
  : /^(Wd|Nb)/.test(t) ? 'bg-sky-400 text-slate-900' : /^(B|Lb)/.test(t) ? 'bg-violet-400 text-slate-900' : t === '0' ? 'bg-slate-700/90 text-slate-300' : 'bg-white text-slate-900';

function flash(type) {
  const box = $('flashBox'), f = $('flash');
  const style = { FOUR: ['bg-amber-400 text-slate-900', 'FOUR'], SIX: ['bg-emerald-400 text-slate-900', 'SIX'], WICKET: ['bg-red-600 text-white', 'WICKET'], 'NO BALL': ['bg-sky-400 text-slate-900', 'NO BALL'] }[type];
  if (!style) return;
  box.className = `px-[5rem] py-[0.6rem] font-display font-extrabold text-[8rem] leading-none tracking-wide shadow-[0_0_4rem_rgba(0,0,0,.6)] ${style[0]}`;
  $('flashText').textContent = style[1];
  f.classList.remove('opacity-0', 'scale-75'); f.classList.add('opacity-100', 'scale-100');
  clearTimeout(flashTimer);
  flashTimer = setTimeout(() => { f.classList.add('opacity-0', 'scale-75'); f.classList.remove('opacity-100', 'scale-100'); }, 2600);
}

/* ---------- logos ---------- */
function logoHtml(id, abbr, color, size) {
  const src = logoCache[id];
  return src ? `<img src="${src}" style="width:${size}rem;height:${size}rem" class="rounded-full object-cover bg-white" alt="">`
    : `<span style="width:${size}rem;height:${size}rem;background:${esc(color || '#64748b')};font-size:${size * .38}rem" class="rounded-full inline-flex items-center justify-center font-display font-extrabold">${esc((abbr || '?').slice(0, 2))}</span>`;
}
let rawLogos = {}, adImgs = [], spList = [], spIdx = 0, spTimer = null, blocked = false, unsubs = [];
function rebuildSponsors() {
  spList = [...(rawLogos.sponsor ? [rawLogos.sponsor] : []), ...adImgs];
  const el = $('sponsor'); clearInterval(spTimer); spIdx = 0;
  if (!spList.length) { el.classList.add('hidden'); return; }
  el.style.opacity = 1; el.src = spList[0]; el.classList.remove('hidden');
  if (spList.length > 1) spTimer = setInterval(() => { el.style.opacity = 0; setTimeout(() => { spIdx = (spIdx + 1) % spList.length; el.src = spList[spIdx]; el.style.opacity = 1; }, 350); }, 8000);
}
function applyLogos() {
  if (info) { if (rawLogos.a) logoCache[info.team_a_id] = rawLogos.a; if (rawLogos.b) logoCache[info.team_b_id] = rawLogos.b; }
  if (rawLogos.tournament) logoCache.tournament = rawLogos.tournament; else delete logoCache.tournament;
  if (info) { document.documentElement.className = 'theme-' + (info.theme || 'dark'); document.documentElement.style.setProperty('--ac', info.accent || '#fbbf24'); }
  rebuildSponsors(); paint(last); refreshBig();
}

/* ---------- panels ---------- */
const stageLabel = () => !info ? '' : (info.stage && info.stage !== 'Group') ? info.stage : (info.group ? 'Group ' + info.group : '');
function bigHtml(type) {
  if (!info) return '';
  const a = { id: info.team_a_id, abbr: info.team_a_abbr, name: info.team_a_name, color: info.team_a_color }, b = { id: info.team_b_id, abbr: info.team_b_abbr, name: info.team_b_name, color: info.team_b_color };
  const side = (t, score, right) => `<div class="flex-1 flex flex-col items-center gap-[0.8rem]">${logoHtml(t.id, t.abbr, t.color, 11)}<div class="font-display font-extrabold text-[4rem] leading-none">${esc(t.abbr)}</div><div class="font-display text-[1.7rem] text-white/75 leading-none">${esc(t.name)}</div>${score ? `<div class="font-display font-extrabold text-[3.6rem] leading-none mt-[0.4rem]">${esc(score)}</div>` : ''}</div>`;
  const tl = logoCache.tournament ? `<img src="${logoCache.tournament}" style="height:3rem;width:3rem" class="rounded-full object-cover bg-white" alt="">` : '';
  const wrap = (head, mid, foot) => `<div class="rounded-[1.6rem] overflow-hidden shadow-[0_1rem_4rem_rgba(0,0,0,.6)]"><div class="px-[2rem] py-[0.9rem] flex items-center justify-center gap-[1rem] font-display font-bold text-[1.9rem] tracking-[0.15em] bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900">${tl}<span>${head}</span></div><div class="bg-slate-950/95 px-[2rem] py-[2.2rem]"><div class="flex items-center">${mid}</div></div><div class="px-[2rem] py-[0.9rem] text-center font-display font-bold text-[2.2rem] text-slate-900" style="background:var(--ac,#fbbf24)">${foot}</div></div>`;
  const vs = `<div class="font-display font-extrabold text-[3rem] text-white/50 px-[1rem]">VS</div>`;
  if (type === 'intro') return wrap(esc((info.tname || 'LIVE CRICKET').toUpperCase()) + (stageLabel() ? ' &bull; ' + esc(stageLabel().toUpperCase()) : ''), side(a) + vs + side(b), `${info.overs} OVERS MATCH`);
  if (type === 'result') return wrap(esc((info.tname || 'MATCH').toUpperCase()) + ' &bull; RESULT', side(a, info.score_a) + vs + side(b, info.score_b), esc(info.result || 'Match in progress') + (info.pom_name ? `<div class="font-display font-semibold text-[1.4rem] mt-[0.1rem]">Player of the match: ${esc(info.pom_name)} ${esc(info.pom_line || '')}</div>` : ''));
  if (type === 'xi') {
    const col = (n, c, list) => `<div class="flex-1"><div style="color:${esc(c)}" class="font-display font-extrabold text-[2.4rem] mb-[0.4rem]">${esc(n)}</div>${(list || []).map(x => `<div class="font-display text-[1.7rem] leading-[1.35]">${esc(x)}</div>`).join('') || '<div class="text-white/50">Squad not announced</div>'}</div>`;
    return wrap(esc((info.tname || 'MATCH').toUpperCase()) + ' &bull; PLAYING XI', col(info.team_a_name, info.team_a_color, info.xi_a_n) + '<div class="w-[2px] bg-white/20 self-stretch mx-[1.5rem]"></div>' + col(info.team_b_name, info.team_b_color, info.xi_b_n), esc(info.ground || (info.overs + ' OVERS MATCH')));
  }
  return '';
}
function refreshBig() { if (bigType && (bigType === 'intro' || bigType === 'result' || bigType === 'xi')) $('big').innerHTML = bigHtml(bigType); }
function setBig(type) {
  const big = $('big');
  if (type === 'intro' || type === 'result' || type === 'xi') { bigType = type; big.innerHTML = bigHtml(type); big.classList.remove('opacity-0', 'scale-95'); big.classList.add('opacity-100', 'scale-100'); }
  else { bigType = ''; big.classList.add('opacity-0', 'scale-95'); big.classList.remove('opacity-100', 'scale-100'); }
}
function cardHtml(type) {
  const L = last; if (!L || !L.display) return '';
  const d = L.display, s = d.striker || {}, n = d.non_striker || {};
  const sr = (r, b) => b ? (r / b * 100).toFixed(1) : '-';
  const color = L.batting_color || '#e11d48';
  if (type === 'batter') return `<div class="flex items-stretch rounded-[1.2rem] overflow-hidden shadow-[0_0.8rem_2.4rem_rgba(0,0,0,.55)]"><div style="background:${esc(color)}" class="w-[1.2rem]"></div><div class="flex-1 bg-slate-950/95 px-[1.6rem] py-[1rem] flex items-center justify-between"><div><div class="font-display font-bold text-[1.2rem] text-white/60 tracking-widest">BATTER</div><div class="font-display font-extrabold text-[3rem] leading-none">${esc(s.name)}</div></div><div class="text-right"><div class="font-display font-extrabold text-[4rem] leading-none">${s.runs ?? 0} <span class="text-[2rem] text-white/60">(${s.balls ?? 0})</span></div><div class="font-display text-[1.4rem] text-white/75">4s ${s.fours ?? 0} &nbsp; 6s ${s.sixes ?? 0} &nbsp; SR ${sr(s.runs, s.balls)}</div></div></div></div>`;
  if (type === 'partnership') return `<div class="rounded-[1.2rem] overflow-hidden shadow-[0_0.8rem_2.4rem_rgba(0,0,0,.55)] bg-slate-950/95"><div style="background:${esc(color)}" class="px-[1.6rem] py-[0.4rem] font-display font-bold text-[1.3rem] tracking-widest text-center">PARTNERSHIP</div><div class="flex items-center px-[1.6rem] py-[1rem]"><div class="flex-1"><div class="font-display font-bold text-[1.9rem] leading-tight">${esc(s.name)}</div><div class="font-display text-[2.2rem] font-extrabold">${s.runs ?? 0} <span class="text-[1.3rem] text-white/60">(${s.balls ?? 0})</span></div></div><div class="px-[1.4rem] text-center"><div class="font-display font-extrabold text-[4rem] leading-none">${L.p_runs ?? 0}</div><div class="font-display text-[1.2rem] text-white/70">${L.p_balls ?? 0} balls</div></div><div class="flex-1 text-right"><div class="font-display font-bold text-[1.9rem] leading-tight">${esc(n.name)}</div><div class="font-display text-[2.2rem] font-extrabold">${n.runs ?? 0} <span class="text-[1.3rem] text-white/60">(${n.balls ?? 0})</span></div></div></div></div>`;
  if (type === 'bowler') {
    const b = d.bowler || {}, bb = b.balls ?? 0, econ = bb ? ((b.runs ?? 0) / (bb / 6)).toFixed(2) : '-';
    return `<div class="flex items-stretch rounded-[1.2rem] overflow-hidden shadow-[0_0.8rem_2.4rem_rgba(0,0,0,.55)]"><div class="w-[1.2rem] bg-white"></div><div class="flex-1 bg-slate-950/95 px-[1.6rem] py-[1rem] flex items-center justify-between"><div><div class="font-display font-bold text-[1.2rem] text-white/60 tracking-widest">BOWLER</div><div class="font-display font-extrabold text-[3rem] leading-none">${esc(b.name)}</div></div><div class="text-right"><div class="font-display font-extrabold text-[4rem] leading-none">${b.wkts ?? 0}/${b.runs ?? 0} <span class="text-[2rem] text-white/60">(${Math.floor(bb / 6)}.${bb % 6})</span></div><div class="font-display text-[1.4rem] text-white/75">Maidens ${b.maidens ?? 0} &nbsp; Econ ${econ}</div></div></div></div>`;
  }
  if (type === 'overs') {
    const lo = L.last_over; if (!lo) return '';
    const chips = (lo.tags || []).map(t => `<span class="min-w-[2.6rem] h-[2.6rem] px-[0.6rem] flex items-center justify-center rounded-full font-display font-bold text-[1.5rem] ${chipClass(t)}">${t === '0' ? '&bull;' : esc(t)}</span>`).join('');
    return `<div class="rounded-[1.2rem] overflow-hidden shadow-[0_0.8rem_2.4rem_rgba(0,0,0,.55)] bg-slate-950/95"><div style="background:${esc(color)}" class="px-[1.6rem] py-[0.4rem] font-display font-bold text-[1.3rem] tracking-widest flex justify-between"><span>OVER ${lo.n}</span><span>${esc(lo.bw)}</span></div><div class="flex items-center justify-between px-[1.6rem] py-[1rem]"><div class="flex gap-[0.4rem]">${chips}</div><div class="text-right"><div class="font-display font-extrabold text-[3rem] leading-none">${lo.runs} <span class="text-[1.4rem] text-white/60">RUNS${lo.wk ? ' &bull; ' + lo.wk + ' WKT' : ''}</span></div><div class="font-display text-[1.3rem] text-white/70">SCORE ${L.live_score}/${L.wickets}</div></div></div></div>`;
  }
  if (type === 'break') {
    if (L.status !== 'innings_break') return '';
    const tg = L.live_score + 1, mo = L.max_overs ?? '';
    return `<div class="rounded-[1.2rem] overflow-hidden shadow-[0_0.8rem_2.4rem_rgba(0,0,0,.55)] bg-slate-950/95"><div style="background:${esc(color)}" class="px-[1.6rem] py-[0.4rem] font-display font-bold text-[1.3rem] tracking-widest text-center">INNINGS BREAK</div><div class="flex items-center justify-between px-[1.6rem] py-[1.1rem]"><div><div class="font-display font-extrabold text-[2.6rem] leading-none">${esc(L.batting_abbr)} ${L.live_score}/${L.wickets}</div><div class="font-display text-[1.3rem] text-white/70">${L.overs}.${L.current_ball_count} overs</div></div><div class="text-right"><div class="font-display font-bold text-[1.3rem] text-white/70 tracking-widest">${esc(L.bowling_abbr)} NEED</div><div class="font-display font-extrabold text-[3.2rem] leading-none">${tg} <span class="text-[1.4rem] text-white/60">IN ${mo} OVERS</span></div></div></div></div>`;
  }
  return '';
}
function showCard(type, ms) {
  const c = $('card'); c.innerHTML = cardHtml(type);
  if (!c.innerHTML) return;
  c.classList.remove('opacity-0', 'translate-y-8'); c.classList.add('opacity-100', 'translate-y-0');
  clearTimeout(cardTimer); cardTimer = setTimeout(hideCard, ms || 8000);
}
function hideCard() { const c = $('card'); c.classList.add('opacity-0', 'translate-y-8'); c.classList.remove('opacity-100', 'translate-y-0'); }

function applyGfx(g, first) {
  if (!g || !g.n) return;
  if (g.n === lastGfx) return;
  const was = lastGfx; lastGfx = g.n;
  const t = g.type;
  if (first && was === null && ['batter', 'partnership', 'bowler', 'overs', 'break', 'strip'].includes(t)) { return; }
  if (t === 'hide') { hidden = true; setBig(''); hideCard(); }
  else if (t === 'strip') { hidden = false; setBig(''); hideCard(); }
  else if (t === 'intro' || t === 'result' || t === 'xi') { hidden = false; setBig(t); hideCard(); }
  else if (['batter', 'partnership', 'bowler', 'overs', 'break'].includes(t)) { hidden = false; showCard(t, t === 'break' ? 14000 : 9000); }
  paint(last);
}

/* ---------- strip ---------- */
function paint(L) {
  const stage = $('stage');
  $('wm').style.opacity = (L && info && info.active !== false && !hidden) ? '0.92' : '0';
  const showStrip = L && L.batting_abbr && info && info.active !== false && !hidden && bigType !== 'intro' && bigType !== 'result' && bigType !== 'xi';
  if (!showStrip) { stage.classList.add('opacity-0', 'translate-y-10'); return; }
  stage.classList.remove('opacity-0', 'translate-y-10');

  const batA = L.batting_team_id === info.team_a_id, batId = L.batting_team_id;
  if (cache.col !== L.batting_color) { cache.col = L.batting_color; $('teamBlock').style.setProperty('--tc', L.batting_color || '#e11d48'); }
  const lg = logoCache[batId], img = $('logoBat'), fb = $('logoBatFb');
  if (lg) { if (img.src !== lg) img.src = lg; img.classList.remove('hidden'); fb.classList.add('hidden'); } else { img.classList.add('hidden'); fb.classList.remove('hidden'); fb.textContent = (L.batting_abbr || '').slice(0, 2); }
  setText('abbr', L.batting_abbr, false); setText('vs', 'v ' + (L.bowling_abbr || ''), false);
  setText('runs', L.live_score ?? 0); setText('wkts', L.wickets ?? 0);
  setText('overs', `${L.overs ?? 0}.${L.current_ball_count ?? 0}`); setText('oversOf', `OF ${L.max_overs ?? '-'}`, false);

  const d = L.display || {}, s = d.striker || {}, n = d.non_striker || {}, b = d.bowler || {};
  setText('b1n', (s.name || '-') + '*', false); setText('b1r', s.runs ?? 0); setText('b1b', `(${s.balls ?? 0})`, false);
  setText('b2n', n.name || '-', false); setText('b2r', n.runs ?? 0); setText('b2b', `(${n.balls ?? 0})`, false);
  setText('bwn', b.name || '-', false);
  const bb = b.balls ?? 0;
  setText('bwf', `${Math.floor(bb / 6)}.${bb % 6} - ${b.maidens ?? 0} - ${b.runs ?? 0} - ${b.wkts ?? 0}`);

  const tb = L.total_balls ?? 0, maxB = (L.max_overs ?? 0) * 6;
  let line = '';
  if (L.target) { const needR = Math.max(0, L.target - L.live_score), left = Math.max(0, maxB - tb); line = `NEED ${needR} OFF ${left} BALLS    RRR ${left ? (needR / left * 6).toFixed(2) : '-'}`; }
  else if (tb) line = `CRR ${(L.live_score / tb * 6).toFixed(2)}`;
  setText('chase', line, false); setOpacity('chase', !!line);
  const ppOn = !L.so && L.pp && (L.total_balls ?? 0) < L.pp * 6;
  const tagTxt = L.so ? 'SUPER OVER' : ppOn ? 'POWERPLAY' : (stageLabel() || '').toUpperCase();
  setText('stageTag', tagTxt, false); setOpacity('stageTag', !!tagTxt);
  setOpacity('freeHit', !!L.free_hit_active);

  const arr = L.last_12_balls_array || [], key = arr.join(',');
  if (key !== tickKey) {
    tickKey = key;
    $('ticker').innerHTML = arr.map(t => `<span class="min-w-[2.2rem] h-[2.2rem] px-[0.5rem] flex items-center justify-center rounded-full font-display font-bold text-[1.3rem] ${chipClass(t)}">${t === '0' ? '&bull;' : esc(t)}</span>`).join('');
    setOpacity('tickLabel', arr.length > 0);
  }

  // events: flash banner (never on first load, never on undo)
  const ev = L.event;
  if (ev && typeof ev.n === 'number') {
    if (lastEvent === null) lastEvent = ev.n;
    else if (ev.n > lastEvent) { lastEvent = ev.n; if (ev.type) flash(ev.type); }
    else if (ev.n < lastEvent) lastEvent = ev.n;
  }
  // automatic cards: over summary after each over, innings break card
  const lon = L.last_over ? L.last_over.n : -1;
  if (prevOver === null) prevOver = lon; else if (lon !== prevOver) { if (lon > prevOver) showCard('overs', 8000); prevOver = lon; }
  const brk = L.status === 'innings_break';
  if (prevBrk === null) prevBrk = brk; else { if (brk && !prevBrk) showCard('break', 14000); prevBrk = brk; }
  // auto milestone card: striker reaches 50 or 100
  if (s.name) {
    if (prevBat && prevBat.name === s.name && ((prevBat.runs < 50 && s.runs >= 50) || (prevBat.runs < 100 && s.runs >= 100))) showCard('batter', 7000);
    prevBat = { name: s.name, runs: s.runs ?? 0 };
  }
}

/* ---------- data wiring ---------- */
let db = null;
if (DEMO) {
  info = { active: true, team_a_id: 'a', team_b_id: 'b', team_a_abbr: 'LIO', team_a_name: 'Lions', team_a_color: '#e11d48', team_b_abbr: 'TIG', team_b_name: 'Tigers', team_b_color: '#2563eb', overs: 10, tname: 'JR Premier League', stage: 'Group', group: 'A', score_a: '147-4 (9.0)', score_b: '110-6 (9.0)', result: 'Lions won by 37 runs', pom_name: 'Jameel', pom_line: '62 (24)' };
  const L = { batting_team_id: 'a', batting_abbr: 'LIO', bowling_abbr: 'TIG', batting_color: '#e11d48', live_score: 96, wickets: 3, overs: 6, current_ball_count: 2, total_balls: 38, max_overs: 10, target: null, free_hit_active: false, p_runs: 41, p_balls: 20,
    last_12_balls_array: ['1', '0', '4', 'W', '1', 'Wd', '6', '2', '0', '1', 'Nb', '4'],
    display: { striker: { name: 'A. Khan', runs: 41, balls: 28, fours: 4, sixes: 2 }, non_striker: { name: 'R. Baloch', runs: 18, balls: 20, fours: 1, sixes: 0 }, bowler: { name: 'S. Noor', balls: 14, runs: 22, wkts: 1, maidens: 0 } }, event: { n: 1 } };
  last = L; paint(L);
  const seq = ['4', '6', 'W', '1', 'Nb', '2'], gfx = ['intro', 'strip', 'batter', 'partnership', 'result', 'strip']; let i = 0, j = 0;
  setInterval(() => {
    const t = seq[i++ % seq.length], r = t === '4' ? 4 : t === '6' ? 6 : t === 'Nb' ? 1 : +t || 0;
    L.live_score += r; if (t === 'W') L.wickets++; L.total_balls++; L.overs = Math.floor(L.total_balls / 6); L.current_ball_count = L.total_balls % 6;
    L.free_hit_active = t === 'Nb'; L.last_12_balls_array = [...L.last_12_balls_array, t].slice(-12);
    L.display.striker.runs += (t === '4' || t === '6') ? r : 0; L.display.striker.balls++;
    L.event = { n: L.event.n + 1, type: t === '4' ? 'FOUR' : t === '6' ? 'SIX' : t === 'W' ? 'WICKET' : t === 'Nb' ? 'NO BALL' : null };
    paint(L);
  }, 3500);
  setInterval(() => applyGfx({ type: gfx[j % gfx.length], n: ++j + 100 }, false), 7000);
} else if (K) {
  db = getDatabase(initializeApp(firebaseConfig));
  const attach = () => {
    unsubs.forEach(f => f()); unsubs = []; blocked = false; let first = true;
    const bad = () => { if (blocked) return; blocked = true; info = null; last = null; paint(null); if (DEBUG) $('inactive').classList.remove('hidden'); };
    const b = `overlay/${K}`;
    unsubs.push(onValue(ref(db, `${b}/info`), s => { info = s.val(); if (!info) return bad(); $('inactive').classList.add('hidden'); applyLogos(); }, bad));
    unsubs.push(onValue(ref(db, `${b}/live`), s => { last = s.val(); paint(last); }, bad));
    unsubs.push(onValue(ref(db, `${b}/logos`), s => { rawLogos = s.val() || {}; applyLogos(); }, bad));
    unsubs.push(onValue(ref(db, `${b}/gfx`), s => {
      const g = s.val();
      if (first) { first = false; if (g && (g.type === 'intro' || g.type === 'result' || g.type === 'xi' || g.type === 'hide')) { lastGfx = null; applyGfx(g, false); } else if (g) lastGfx = g.n; return; }
      applyGfx(g, false);
    }, bad));
  };
  attach();
  setInterval(() => { if (blocked) attach(); }, 30000);
  const loadAds = () => get(ref(db, 'ads')).then(s => { adImgs = Object.values(s.val() || {}).filter(a => a.on !== false).map(a => a.img); rebuildSponsors(); }).catch(() => {});
  loadAds(); setInterval(loadAds, 300000);
}
</script>
</body>
</html>
